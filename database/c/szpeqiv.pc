  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecInserted,27,_TMC("0"));
  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecIgnored,27,_TMC("0"));
  
  static BANNUMSTR(rpt_record_num)    = {0};   /*TMCI18N CHANGED FROM ""*/
  static BANNUMSTR(lvPIDM)            = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvID[11]             = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvTerm[7]            = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvOrigCrse[10]       = {0};
  static TMCHAR  lvOrigSubj[5]        = {0};
  static TMCHAR  lvOrigCNumb[5]       = {0};
  static TMCHAR  lvEqivCrse[10]       = {0};
  static TMCHAR  lvEqivSubj[5]        = {0};
