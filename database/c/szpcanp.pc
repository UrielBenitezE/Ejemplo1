    EXCEPTION
      WHEN OTHERS THEN
        rollback;
        :vErrMsg := SUBSTR(SQLERRM, 1, 200);
    END;
    END-EXEC;


*/  
}


static void mc_GetSubjCrseCorq(void)  
{
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_GetSubjCrseCorq.\n"));
  #endif

      EXEC SQL
          SELECT SSBSECT_SUBJ_CODE, SSBSECT_CRSE_NUMB
            INTO :lv_Subj,
                 :lv_Crse
            FROM SSBSECT
           WHERE SSBSECT_CRN = :xCRN
             AND SSBSECT_TERM_CODE = :xTermCode;
    POSTORA;
    
  /* OBTENER SI EL CURSO DEL CRN ESTA COMO CO-REQUISITOS DE OTROS CURSOS */
    EXEC SQL
    DECLARE GET_SUBJ_CRSE_CORQ_C CURSOR FOR
     SELECT 'Y'
       FROM SCRCORQ
      WHERE SCRCORQ_SUBJ_CODE_CORQ  = :lv_Subj
        AND SCRCORQ_CRSE_NUMB_CORQ  = :lv_Crse
        AND SCRCORQ_EFF_TERM = ( SELECT MAX (SCRCORQ_EFF_TERM)
                                   FROM SCRCORQ b
                                  WHERE b.SCRCORQ_EFF_TERM  <= :xTermCode
                                    AND b.SCRCORQ_SUBJ_CODE_CORQ = SCRCORQ_SUBJ_CODE_CORQ
                                    AND b.SCRCORQ_CRSE_NUMB_CORQ = SCRCORQ_CRSE_NUMB_CORQ
                               );

  /*
    ****************************************************************************************
      GET IF THE SUBJECT OF THE CRN IS A CO-REQUISITE SUBJECTS FOR A COURSE.
    ****************************************************************************************
  */

  EXEC SQL
    OPEN GET_SUBJ_CRSE_CORQ_C;
  POSTORA;

  *lvIsCORQ = '\0';

  EXEC SQL
    FETCH GET_SUBJ_CRSE_CORQ_C
     INTO :lvIsCORQ:vIndArr[0];
  POSTORA;

  if ( !*lvIsCORQ )
    tmstrcpy( lvIsCORQ, _TMC("N") );

  EXEC SQL
    CLOSE GET_SUBJ_CRSE_CORQ_C;
  POSTORA;

}

