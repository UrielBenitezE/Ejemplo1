{
  *term_code    = '\0';
  *crn          = '\0';
  *det_msg  = '\0';
  *pCrn     = '\0';
  *pProcTerm    = '\0';
  *pPtrmCode    = '\0';
  *pSubject = '\0';
  *pCrseNum = '\0';
  *pSchdType    = '\0';
}

