       AND SS.SFRSTCR_PIDM = :vPIDM
       AND SS.SFRSTCR_TERM_CODE >= (SELECT MAX( RR.SCRCORQ_EFF_TERM )
                                  FROM SCRCORQ  RR
                                 WHERE RR.SCRCORQ_SUBJ_CODE = :lv_Subj
                                   AND RR.SCRCORQ_CRSE_NUMB = :lv_Crse
                                   AND RR.SCRCORQ_EFF_TERM <= :lvTerm)
       AND SS.SSBSECT_SUBJ_CODE IN ( SELECT DISTINCT SR.SCRCORQ_SUBJ_CODE
                               FROM SCRCORQ  SR
                              WHERE ( SR.SCRCORQ_SUBJ_CODE= :lv_Subj
                                 AND SR.SCRCORQ_CRSE_NUMB = :lv_Crse )
                                 OR ( SR.SCRCORQ_SUBJ_CODE_CORQ = :lv_Subj
                                 AND SR.SCRCORQ_CRSE_NUMB_CORQ = :lv_Crse)
                           )
       AND SS.SSBSECT_CRSE_NUMB IN ( SELECT DISTINCT CR.SCRCORQ_CRSE_NUMB
