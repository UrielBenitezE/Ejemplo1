/*****************************************************************************/
/*                                                                           */
/* MAIN                                                                      */
/*                                                                           */
/*****************************************************************************/
int main ( int argc, TMCHAR *argv[] )
{
  rptopen( user_pass, argc, argv );
  login();

  tmprintf(&tmBundle,  TM_NLS_Get("X", "Starting {0} (Release: {1})\n\n"), vRptName, vVersion );

  /* Tables definition */
  table(T_DEFINE, 1, 1,110, NULL);
    /* ******************************************************************************** */
  table(T_DEFINE, 2, 1, 30, 32, 92, 94, 110, NULL);
    /* 
|----------------------------| |-----------------------------------------------------------| |---------------| */

  table(T_DEFINE, 3, 1, 50, NULL);
/*
Group 1: Campus
.........1.........2.........3.........4.........5.........6.........7.........8.........9.........A.........B.........C.........D
1...5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0
Campus xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXx
*/

  table(T_DEFINE, 4, 1,8, 11, 23, 26, 58, 61, 77,NULL);
/*
Group 2: CRN
.........1.........2.........3.........4.........5.........6.........7.........8.........9.........A.........B.........C.........D
1...5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0
CRN       COURSE-KEY     Course Title (not printable)
xxxxxxx   xxxxx-xxxxxx   xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxx   Actividad con SC
*/  
  
  table(T_DEFINE, 5, 1, 11, 13, 59, 61, 78, NULL);

/*
Line 1: student info
.........1.........2.........3.........4.........5.........6.........7.........8.........9.........A.........B.........C.........D
1...5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0
xxxxxxx   xxxxx-xxxxxx   xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxx   Actividad con SC
   ID                     Name                                    Task     
|--------|x|---------------------------------------------|x|----------------|
xxxxxxxxxX xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxxxxxx  xxxxxxxxxXxxxxxxx 
                                            
*/

  pgformat(1,66);

  input( vRptOneUpNo, TM_NLS_Get("X", "Execution Sequence Number:"), 26, NUM );
  if( *vRptOneUpNo ) mc_ValidateOneUpNo();

  mc_RetrieveParms();
  mc_CheckParms();
  mc_GetInstitution();
  mc_GetTitle();
  mc_GetToday();
  
  table(T_BEGIN, 1);
  mc_Header();
  
  tmstrcpy( vTotRecs, _TMC( "0" ) );

  if(!*pFileName) 
    mc_MainProcess();
  else
    process_infile();
  
  mc_ControlReport();

  exit2os( EXIT_SUCCESS );
  return EXIT_SUCCESS;
}


