static int open_data_file(void)
{
  EXEC SQL BEGIN DECLARE SECTION;
    static TMCHAR lv_msg[100]           = {0};
    static TMCHAR tRecordTypeValue[16]  = {0};
  EXEC SQL END DECLARE SECTION;

  #ifdef SCT_DEBUG
     tmprintf(&tmBundle,  TM_NLS_Get("x","Executing function mc_ProcessFile.\n") );
  #endif

  tmstrcpy(lv_msg, TM_NLS_Get("x","(Define in GTVSDAX form the value to the file path for FILE DIR)"));
  EXEC SQL
     EXECUTE
        DECLARE
           description   gtvsdax.GTVSDAX_COMMENTS%TYPE;

           CURSOR get_gtvsdax_desc_c(l_internal_code VARCHAR2,
                                     l_group_code    VARCHAR2) IS
           SELECT GTVSDAX_COMMENTS
             FROM gtvsdax
            WHERE gtvsdax_internal_code       = l_internal_code
              AND gtvsdax_internal_code_group = l_group_code;

           BEGIN
              OPEN get_gtvsdax_desc_c('FILE_DIR', 'UTM002');
              FETCH get_gtvsdax_desc_c INTO :pvFilePath;
              CLOSE get_gtvsdax_desc_c;
              IF (:pvFilePath IS NULL or :pvFilePath = 'UPDATEME') THEN
                  :pvFilePath := :lv_msg;
              END IF;
       END;
  END-EXEC;
  POSTORA;

 #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: UTM002: [{0}]\n"), pvFilePath );
  #endif

  if ( !tmstrcmp( pvFilePath, lv_msg ) )
  {
    tmprintf(&tmBundle, _TMC("{0}\n"),pvFilePath );
    prtstr( lv_msg );
  }
  else
  {
     #if OPSYS==OS_UNIX
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}/{1}"),
                 pvFilePath,  pFileName );
     #else
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}\\{1}"),
                 pvFilePath,  pFileName );
     #endif

  }
  
  #ifdef SCT_DEBUG
      tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: Full name of the file: [{0}]\n"), pvFileFullName );
  #endif
  
  if ( ( fp = tmfopen(&tmBundle,  pvFileFullName, _TMC("r") ) ) == NULL )
  {
      tmprintf(&tmBundle,  TM_NLS_Get("x"," File {0} not found or Input/Output error\n"), pvFileFullName );
      exit2os( EXIT_FAILURE );
  }
  
  return TRUE;
  
}


/* Reads in csv file and separates column values into variables.
   Then call process_detail routine for each record readed in. 
*/
static void process_infile(void)
{
  int    i;
  int    lv_line_size =0;
  int    lv_end_pos =0;
  int    lv_epos =0;
  int    lv_beg_pos =0;
  int    lv_sep=0;
  int    lv_repos=0;
  int    max_line=220;
  char   separador;
  TMCHAR lv_achr[2]={0};

 EXEC SQL BEGIN DECLARE SECTION;
      static TMCHAR   lv_msg[100] = {0};
  EXEC SQL END DECLARE SECTION;

  tmstrcpy(lv_msg, TM_NLS_Get("x","(Define in GTVSDAX form the value to the file separator character for DELIMITADO)"));
  EXEC SQL
     EXECUTE
       BEGIN
           :vCharSeparator := trim(gokeacc.f_getgtvsdaxextcode ('DELIMITADO', 'UTM002')); /*BIEN*/
           IF (:vCharSeparator IS NULL or :vCharSeparator like 'UPDAT%') THEN
             :vCharSeparator := ',';    /* it assumes comma (,) by default */
           ELSE
             :vDummy := LENGTH(:vCharSeparator);
           END IF;
       END;
     END-EXEC;
  POSTORA;

  open_data_file();

  while (tmfgets(det_record, max_line,fp) != NULL) {
    if (tmstrcmp(rec_cnt,_TMC("0"))) {
      /*tmstrcat(det_record, _TMC(","));*/
      tmstrcat(det_record, vCharSeparator);
      lv_line_size = tmstrlen(det_record);
      lv_beg_pos =0;
      lv_end_pos =0;
      lv_repos =0;
      lv_sep =0;
      init_line_var();
      for (i=0; i < lv_line_size; i++) {
        substr(lv_achr,det_record,i,1);
        /*if (!tmstrcmp(lv_achr, _TMC(","))) {*/
        if (!tmstrcmp(lv_achr, vCharSeparator)) {
          lv_sep++;
          lv_end_pos = i;
          lv_epos =lv_end_pos-lv_beg_pos; 
          switch (lv_sep) {
            case 1: substr(term_code,det_record,lv_beg_pos,lv_epos);
              break;
            case 2: substr(crn,det_record,lv_beg_pos,lv_epos);
              break;
          }
          lv_beg_pos = lv_end_pos+1;
        }
        else if (!tmstrcmp(lv_achr, _TMC("\r"))||!tmstrcmp(lv_achr,_TMC("\n"))) 
          lv_repos++;
      }
      process_detail();
    }
    add(rec_cnt, rec_cnt,one);
  }
  tmfclose(fp);

}

static void check_input(void)
{
  if (tmstrlen(term_code) > 8 ||
      tmstrlen(crn) > 7) {
      tmstrcpy(det_msg, LENGTH_EXCEED);
  }

}

static void process_detail(void)
{
  check_input();
  if (!*det_msg) 
  {
    if (*term_code || *crn)  
    {
      mc_check_crn_term();
    }
  }

  if (!*det_msg) 
  {
     tmstrcpy( pProcTerm, term_code);
     tmstrcpy( pCrn, crn);

     mc_MainProcess();
  }

}


static void mc_BuildMainCursor(void)
{

  tmsprintf( &tmBundle, pPreSELECT,  _TMC("SELECT DISTINCT "));
  tmstrcat( pPreSELECT,  _TMC("  substr('Campus ' || gb_stvcamp.f_get_description(SB.SSBSECT_CAMP_CODE),1,30) campus , "));
  tmstrcat( pPreSELECT,  _TMC("  SB.SSBSECT_CRN, "));
  tmstrcat( pPreSELECT,  _TMC("  GB_COMMON.f_get_id(SK.SHRMRKS_PIDM) stuID, "));
  tmstrcat( pPreSELECT,  _TMC("  substr(f_format_name( SK.SHRMRKS_PIDM, 'FML' ),1,45) stuName, "));
  tmstrcat( pPreSELECT,  _TMC("  substr(GC.SHRGCOM_DESCRIPTION,1,17) task, "));
  /*tmstrcat( pPreSELECT,  _TMC("  substr(CA.SZVACAT_DESC,1,17) task, "));*/ 
  tmstrcat( pPreSELECT,  _TMC("  SB.SSBSECT_SUBJ_CODE "));
  tmstrcat( pPreSELECT,  _TMC("  || '-' "));
  tmstrcat( pPreSELECT,  _TMC("  || SB.SSBSECT_CRSE_NUMB course_key, "));
  tmstrcat( pPreSELECT,  _TMC("  substr(CS.SCBCRSE_TITLE,1,30), "));
  tmstrcat( pPreSELECT,  _TMC("  SB.SSBSECT_CAMP_CODE, "));
  tmstrcat( pPreSELECT,  _TMC("  SK.SHRMRKS_PIDM, "));
  tmstrcat( pPreSELECT,  _TMC("  SB.SSBSECT_TERM_CODE, sk.SHRMRKS_GCOM_ID, "));
  tmstrcat( pPreSELECT,  _TMC("  CA.SZVACAT_FINAL_PROJ, CA.SZVACAT_FINAL_TEST "));
  tmstrcat( pPreSELECT,  _TMC("FROM "));
  tmstrcat( pPreSELECT,  _TMC("  shrmrks sk, "));
  tmstrcat( pPreSELECT,  _TMC("  szrschm sc, "));
  tmstrcat( pPreSELECT,  _TMC("  szrcrns cr, "));
  tmstrcat( pPreSELECT,  _TMC("  szvacat ca, "));
  tmstrcat( pPreSELECT,  _TMC("  ssbsect sb, "));
  tmstrcat( pPreSELECT,  _TMC("  shrgcom gc, "));
  tmstrcat( pPreSELECT,  _TMC("  scbcrse cs, "));
  tmstrcat( pPreSELECT,  _TMC("  sfrstcr st "));
  tmstrcat( pPreSELECT,  _TMC("WHERE "));
  tmstrcat( pPreSELECT,  _TMC("  SB.SSBSECT_CRN         = SK.SHRMRKS_CRN "));
  tmstrcat( pPreSELECT,  _TMC("AND SB.SSBSECT_TERM_CODE = SK.SHRMRKS_TERM_CODE "));
  tmstrcat( pPreSELECT,  _TMC("AND SB.SSBSECT_CRSE_NUMB = CS.SCBCRSE_CRSE_NUMB "));
  tmstrcat( pPreSELECT,  _TMC("AND SB.SSBSECT_SUBJ_CODE = CS.SCBCRSE_SUBJ_CODE "));
  
  tmstrcat( pPreSELECT,  _TMC("and SK.SHRMRKS_GCOM_ID = GC.SHRGCOM_ID "));
  tmstrcat( pPreSELECT,  _TMC("and SK.SHRMRKS_TERM_CODE = GC.SHRGCOM_TERM_CODE "));
  tmstrcat( pPreSELECT,  _TMC("and SK.SHRMRKS_CRN = GC.SHRGCOM_CRN "));
  
  tmstrcat( pPreSELECT,  _TMC("AND CS.SCBCRSE_EFF_TERM  = "));
  tmstrcat( pPreSELECT,  _TMC("  ( "));
  tmstrcat( pPreSELECT,  _TMC("    SELECT "));
  tmstrcat( pPreSELECT,  _TMC("      MAX(X.SCBCRSE_EFF_TERM) "));
  tmstrcat( pPreSELECT,  _TMC("    FROM "));
  tmstrcat( pPreSELECT,  _TMC("      scbcrse x "));
  tmstrcat( pPreSELECT,  _TMC("    WHERE "));
  tmstrcat( pPreSELECT,  _TMC("      X.SCBCRSE_CRSE_NUMB   = CS.SCBCRSE_CRSE_NUMB "));
  tmstrcat( pPreSELECT,  _TMC("    AND X.SCBCRSE_SUBJ_CODE = CS.SCBCRSE_SUBJ_CODE "));
  tmstrcat( pPreSELECT,  _TMC("    AND X.SCBCRSE_EFF_TERM <= trim('"));
  tmstrcat( pPreSELECT,         pProcTerm);
  tmstrcat( pPreSELECT,  _TMC("') "));
  tmstrcat( pPreSELECT,  _TMC("  ) "));
  
  tmstrcat( pPreSELECT,  _TMC("and ST.SFRSTCR_TERM_CODE = SK.SHRMRKS_TERM_CODE  "));
  tmstrcat( pPreSELECT,  _TMC("and ST.SFRSTCR_CRN = SK.SHRMRKS_CRN  "));
  tmstrcat( pPreSELECT,  _TMC("and ST.SFRSTCR_PIDM = SK.SHRMRKS_PIDM  "));
  tmstrcat( pPreSELECT,  _TMC("and (NVL(ST.SFRSTCR_ERROR_FLAG,'N') <> 'F')  "));
  /* BA 8.7.0 [UTM:002.1.5] GGR 30-JUN-2017 */
  /*
  tmstrcat( pPreSELECT,  _TMC("AND (ST.SFRSTCR_ERROR_FLAG not in ('F','D')  "));
  tmstrcat( pPreSELECT,  _TMC("  or ST.SFRSTCR_ERROR_FLAG is null   "));
  tmstrcat( pPreSELECT,  _TMC("  or ST.SFRSTCR_RSTS_CODE in (select stvrsts_code  "));
  tmstrcat( pPreSELECT,  _TMC("                                from stvrsts  "));
  tmstrcat( pPreSELECT,  _TMC("                               where stvrsts_code = ST.SFRSTCR_RSTS_CODE  "));
  tmstrcat( pPreSELECT,  _TMC("                                 and stvrsts_gradable_ind = 'Y'))  "));
  */
  tmstrcat( pPreSELECT,  _TMC(" and ST.SFRSTCR_RSTS_CODE in (select stvrsts_code "));
  tmstrcat( pPreSELECT,  _TMC("                               from stvrsts  "));
  tmstrcat( pPreSELECT,  _TMC("                              where stvrsts_code = ST.SFRSTCR_RSTS_CODE  "));
  tmstrcat( pPreSELECT,  _TMC(" and stvrsts_gradable_ind = 'Y' and stvrsts_withdraw_ind = 'N' and stvrsts_code Not in ('BG','BM','DW','WL') )  "));
  /* EA 8.7.0 [UTM:002.1.5] GGR 30-JUN-2017 */
  tmstrcat( pPreSELECT,  _TMC("  "));
  
  tmstrcat( pPreSELECT,  _TMC("AND CR.SZRCRNS_SCHM_SEQNO = SC.SZRSCHM_SCHM_SEQNO "));
  tmstrcat( pPreSELECT,  _TMC("AND CR.SZRCRNS_TERM_CODE  = SC.SZRSCHM_TERM_CODE "));
  tmstrcat( pPreSELECT,  _TMC("AND CR.SZRCRNS_PTRM_CODE  = SC.SZRSCHM_PTRM_CODE "));
  tmstrcat( pPreSELECT,  _TMC("and cr.SZRCRNS_CURRENT_IND = 'Y' "));
  tmstrcat( pPreSELECT,  _TMC("AND SC.SZRSCHM_ACAT_NAME  = CA.SZVACAT_NAME "));
  tmstrcat( pPreSELECT,  _TMC("and SC.SZRSCHM_GSCH_NAME = GC.SHRGCOM_GRADE_SCALE  "));
  tmstrcat( pPreSELECT,  _TMC("and SC.SZRSCHM_ACAT_NAME = GC.SHRGCOM_NAME  "));
  tmstrcat( pPreSELECT,  _TMC("AND SK.SHRMRKS_TERM_CODE  = CR.SZRCRNS_TERM_CODE "));
  tmstrcat( pPreSELECT,  _TMC("AND Sk.Shrmrks_Crn        = Cr.Szrcrns_Crn "));
  tmstrcat( pPreSELECT,  _TMC("AND SB.SSBSECT_TERM_CODE  = trim('"));
  tmstrcat( pPreSELECT,            pProcTerm);
  tmstrcat( pPreSELECT,  _TMC("') "));
  /*  MKU   Changed         8.7 [MCLA:002.1.1]  04/May/2016  */
  /* tmstrcat( pPreSELECT,  _TMC("AND trim(SK.SHRMRKS_GRDE_CODE) IS NULL ")); */
  tmstrcat( pPreSELECT,  _TMC("AND NVL(trim(SK.SHRMRKS_GRDE_CODE),'XX') IN ('XX','SC','NE')"));
  
  tmstrcat( pPreSELECT,  _TMC("AND (CA.SZVACAT_FINAL_PROJ = 'Y' or CA.SZVACAT_FINAL_TEST = 'Y') "));
  tmstrcat( pPreSELECT,  _TMC("AND TRUNC(Sysdate)       > Sc.Szrschm_Due_Date "));
  
  
  if(*pCrn)
  {
    tmstrcat( pPreSELECT,  _TMC("AND Sb.Ssbsect_Crn       = trim('"));
    tmstrcat( pPreSELECT,       pCrn);
    tmstrcat( pPreSELECT,  _TMC("') "));
  }
  
  if(*pPtrmCode)
  {
    tmstrcat( pPreSELECT,  _TMC("AND Sb.Ssbsect_Ptrm_Code = trim(' "));
    tmstrcat( pPreSELECT,       pPtrmCode);
    tmstrcat( pPreSELECT,  _TMC("') "));
  }
  
  if(*pSubject)
  {
    tmstrcat( pPreSELECT,  _TMC("AND Sb.Ssbsect_Subj_Code = trim('"));
    tmstrcat( pPreSELECT,       pSubject);
    tmstrcat( pPreSELECT,  _TMC("') "));
  }
  
  if(*pCrseNum)
  {
    tmstrcat( pPreSELECT,  _TMC("AND Sb.Ssbsect_Crse_Numb = trim('"));
    tmstrcat( pPreSELECT,       pCrseNum);
    tmstrcat( pPreSELECT,  _TMC("') "));
  }
  
  if(*pSchdType)
  {
    tmstrcat( pPreSELECT,  _TMC(" AND SB.SSBSECT_SCHD_CODE = trim('"));
    tmstrcat( pPreSELECT,       pSchdType);
    tmstrcat( pPreSELECT,  _TMC("')"));
  }
  
  tmstrcat( pPreSELECT,  _TMC(" ORDER BY 1,2,3"));

  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("X", "pPreSELECT: <{0}>\n"),pPreSELECT);
  #endif

  tmprintf(&tmBundle, TM_NLS_Get("X", "pPreSELECT: <{0}>\n"),pPreSELECT);

  tmstrcpy8( pSELECT, tmtochar8( pPreSELECT ) );

  EXEC SQL PREPARE S FROM :pSELECT;
  EXEC SQL DECLARE GET_POP_SEL_IDS_C CURSOR FOR S;
}


static void mc_MainProcess(void)
{

  int i;

  EXEC SQL BEGIN DECLARE SECTION;

        static TMCHAR   vErrMsg[201] = {0}  ;
        static TMCHAR   vCampusCode[4] = {0} ;
        static TMCHAR   vCRN[6] = {0};

  EXEC SQL END DECLARE SECTION;

  /* Create dynamic cursor */
  mc_BuildMainCursor();
  /* Open dynamic cursor   */
  EXEC SQL OPEN GET_POP_SEL_IDS_C;
  POSTORA;

  /*tmstrcpy( vTotRecs, _TMC( "0" ) );*/
  tmstrcpy( vCampusCode, _TMC( "*@*" ) );
  tmstrcpy( vCRN, _TMC( "*@*" ) );

  for ( ; ; )
  {
    EXEC SQL
      FETCH GET_POP_SEL_IDS_C
       INTO :xCAMP:vIndArr[0]
           ,:xCRN:vIndArr[1]
           ,:xID:vIndArr[2]
           ,:xNAME:vIndArr[3]
           ,:xTask:vIndArr[4]
           ,:xCourseKey:vIndArr[5]
           ,:xCourseTitle:vIndArr[6]
           ,:xCampusCode:vIndArr[7]
           ,:xPIDM:vIndArr[8]
           ,:xTermCode:vIndArr[9]
           ,:xGcomID:vIndArr[10]
           ,:xFinalProj:vIndArr[11]
           ,:xFinalTest:vIndArr[12]
           ;

    POSTORA;

    if ( NO_ROWS_FOUND )
    {
      #ifdef SCT_DEBUG
            if( tmstrcmp( vTotRecs, _TMC("0") ) )
              tmprintf(&tmBundle,  TM_NLS_Get("X","\n  0 records found into query.\n") );
          #endif
      break;
    }
    
    /*if( !tmstrcmp( vTotRecs, _TMC( "0" ) ) ) mc_SubHeader1();*/

     #ifdef SCT_DEBUG 
        tmprintf(&tmBundle,  TM_NLS_Get("x","\n\nSTUDENTS: ROW --> [{0}] <--"), vTotRecs);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nID: {0} "), xID);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nFull name: {0} "), xNAME);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nCampus: {0} "), xCAMP);        
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nCRN: {0} "), xCRN);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nCourse Key: {0} ") , xCourseKey);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nCourse Title: {0} "), xCourseTitle);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nGcomID: {0} "), xGcomID);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nFinalProj: {0} "), xFinalProj);
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nFinalTest: {0} "), xFinalTest);
     #endif 


      /* update shrmrks */

    if(!tmstrcmp(pMode, _TMC("U")))
    {
       mc_ProcessCrn();   /* BA 8.7.0 [UTM:002.1.3]    */
    }

    if(*vErrMsg) 
        tmprintf(&tmBundle,  TM_NLS_Get("x","\nError: {0} "), vErrMsg);
    else
    {

      /* Record counting */
      add( vTotRecs, vTotRecs, _TMC( "1" ) );
      if( tmstrcmp(xCampusCode, vCampusCode) )
      {
        mc_SubHeader1();
        tmstrcpy( vCampusCode, xCampusCode);    
      }
      if( tmstrcmp(xCRN, vCRN) )
      {
        mc_SubHeader2();
        tmstrcpy( vCRN, xCRN);  
      }
      
      mc_Line1( );
    }

  }

  EXEC SQL CLOSE GET_POP_SEL_IDS_C;
  POSTORA;

}

/* BA 8.7.0 [UTM:002.1.3]    */

static void mc_ProcessCrn( void )   /* BA 8.7.0 [UTM:002.1.3]    */
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("X", "\nEjecutando mc_ProcessCrn.\n"));
  #endif

    mc_GetSubjCrseCorq();   /* BA 8.7.0 [UTM:002.1.3]    */

    #ifdef SCT_DEBUG
      tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: lvIsCORQ [{0}]  \n"), lvIsCORQ);
    #endif

  if ( !tmstrcmp( lvIsCORQ, _TMC( "N" ) ) ) /* COURSE OF CRN WITHOUT CO-REQUISITE */
  {
    mc_ProcCrnWhitoutCorq();  /* BA 8.7.0 [UTM:002.1.3]    */
  }
  else                                      /* COURSE OF THE CRN WITH CO-REQUISITE */
  {
    mc_ProcCrnWithCorq();   /* BA 8.7.0 [UTM:002.1.3]    */
  }
}


/* BA 8.7.0 [UTM:002.1.3]    */
static void mc_ProcCrnWhitoutCorq( void ) 
{

  EXEC SQL BEGIN DECLARE SECTION;

        static TMCHAR   vErrMsg[201] = {0}  ;

  EXEC SQL END DECLARE SECTION;
  
    #ifdef SCT_DEBUG
       tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ProcCrnWhitoutCorq.\n"));
    #endif
    

    EXEC SQL
        DECLARE get_score_grade_c CURSOR FOR 
         /* BA 8.7.0 [UTM:002.1.4]*/
         /* Select SC.SHRGRSC_PERCENTAGE */
       SELECT DECODE( SC.SHRGRSC_MEDIAN, NULL, TO_NUMBER( SC.SHRGRSC_GRDE_CODE ), SC.SHRGRSC_MEDIAN )
         /* EA 8.7.0 [UTM:002.1.4]*/
         From Shrgcom Gc, Shrgrsc Sc
        Where Gc.Shrgcom_Grade_Scale = Sc.Shrgrsc_Gsch_Name
          and Sc.Shrgrsc_Grde_Code = :pGradeCode
          and Gc.Shrgcom_Crn = :xCRN
          And Gc.Shrgcom_Term_Code = :xTermCode
          and Gc.Shrgcom_Id = :xGcomID;
          
    EXEC SQL OPEN get_score_grade_c;     
    POSTORA;

    EXEC SQL FETCH get_score_grade_c INTO :xScore:vIndArr[0]; 
    POSTORA;
    
    EXEC SQL CLOSE get_score_grade_c;  
    POSTORA;
    
    
    EXEC SQL
    
    EXECUTE BEGIN

      :vErrMsg := null;

      UPDATE SHRMRKS MK /*BIEN*/
         SET MK.SHRMRKS_GRDE_CODE = :pGradeCode,
             MK.SHRMRKS_SCORE = :xScore ,
             MK.SHRMRKS_PERCENTAGE = :xScore,
             MK.SHRMRKS_ACTIVITY_DATE = SYSDATE,
             MK.SHRMRKS_USER_ID = USER
       WHERE MK.SHRMRKS_CRN = :xCRN
         AND MK.SHRMRKS_PIDM = :xPIDM
         AND MK.SHRMRKS_TERM_CODE = :xTermCode
         AND MK.SHRMRKS_GCOM_ID = :xGcomID;
         /*  MKU    Commented           8.7 [MCLA:002.1.1]  04/May/2016  */
         /* and trim(MK.SHRMRKS_GRDE_CODE) IS NULL;  */

      /*  MKU   Added           8.7 [MCLA:002.1.2]  13/May/2016  */
          UPDATE SFRSTCR /*BIEN*/
         SET SFRSTCR_GRDE_CODE = :pGradeCode
       WHERE SFRSTCR_TERM_CODE = :xTermCode
         AND SFRSTCR_PIDM      = :xPIDM
         AND SFRSTCR_CRN       = :xCRN;

      commit;
    EXCEPTION
      WHEN OTHERS THEN
        rollback;
        :vErrMsg := SUBSTR(SQLERRM, 1, 200);
    END;
    END-EXEC;
    
 }

 /* EA 8.7.0 [UTM:002.1.3]    */
 
 
 /* BA 8.7.0 [UTM:002.1.3]    */
static void mc_ProcCrnWithCorq( void )  
{

  EXEC SQL BEGIN DECLARE SECTION;

        static TMCHAR   vErrMsg[201] = {0}  ;

  EXEC SQL END DECLARE SECTION;
  
   EXEC SQL

        DECLARE get_score_grade_b CURSOR FOR 

           Select SC.SHRGRSC_PERCENTAGE
         From Shrgcom Gc, Shrgrsc Sc
        Where Gc.Shrgcom_Grade_Scale = Sc.Shrgrsc_Gsch_Name
          and Sc.Shrgrsc_Grde_Code = :pGradeCode
          and Gc.Shrgcom_Crn = :xCRN
          And Gc.Shrgcom_Term_Code = :xTermCode
          and Gc.Shrgcom_Id = :xGcomID;
          
    EXEC SQL OPEN get_score_grade_b;     
    POSTORA;

    EXEC SQL FETCH get_score_grade_b INTO :xScore:vIndArr[0]; 
    POSTORA;
    
    EXEC SQL CLOSE get_score_grade_b;  
    POSTORA;
    
    
    EXEC SQL
    
    EXECUTE BEGIN

      :vErrMsg := null;

      UPDATE SHRMRKS MK /*BIEN*/
         SET MK.SHRMRKS_GRDE_CODE = :pGradeCode,
             MK.SHRMRKS_SCORE = :xScore ,
                 MK.SHRMRKS_PERCENTAGE = :xScore,
             MK.SHRMRKS_ACTIVITY_DATE = SYSDATE,
             MK.SHRMRKS_USER_ID = USER
       WHERE MK.SHRMRKS_CRN = :xCRN
         AND MK.SHRMRKS_PIDM = :xPIDM
         AND MK.SHRMRKS_TERM_CODE = :xTermCode
         AND MK.SHRMRKS_GCOM_ID = :xGcomID;
         
         
          UPDATE SFRSTCR /*BIEN*/
         SET SFRSTCR_GRDE_CODE_MID = :pGradeCode
       WHERE SFRSTCR_TERM_CODE = :xTermCode
         AND SFRSTCR_PIDM      = :xPIDM
         AND SFRSTCR_CRN       = :xCRN;

      commit;
    EXCEPTION
      WHEN OTHERS THEN
        rollback;
        :vErrMsg := SUBSTR(SQLERRM, 1, 200);
    END;
    END-EXEC;
    

/*
    EXEC SQL
          SELECT SSBSECT_SUBJ_CODE, SSBSECT_CRSE_NUMB
            INTO :lv_Subj,
                 :lv_Crse
            FROM SSBSECT
           WHERE SSBSECT_PIDM = :xPIDM
             AND SSBSECT_CRN = :xCRN
             AND SSBSECT_TERM_CODE = :xTermCode;
    POSTORA;

    EXEC SQL
    
    EXECUTE BEGIN
    
    UPDATE  SF 
       SET SF.SFRSTCR_GRDE_CODE_MID = :pGradeCode;
      FROM SFRSTCR SF, SSBSECT SS
     WHERE SS.SSBSECT_CRN =  SF.SFRSTCR_CRN
