/*****************************************************************************/
/*                                                                           */
/* PRINTING ROUTINES                                                         */
/*                                                                           */
/*****************************************************************************/

/*****************************************************************************/
/* mc_GetToday                                                               */
/*****************************************************************************/
/* Get the Date & Time of Execution                                          */
/*****************************************************************************/
static void mc_GetToday(void)
{
  EXEC SQL BEGIN DECLARE SECTION;
    static TMCHAR tDate[12] = {0};
    static TMCHAR tTime[12] = {0};
  EXEC SQL END DECLARE SECTION;

  EXEC SQL
    SELECT LTRIM(RTRIM(TO_CHAR(SYSDATE, G$_DATE.GET_NLS_DATE_FORMAT))),
           TO_CHAR(SYSDATE, 'HH24:MI')
      INTO :tDate:vIndArr[0],
           :tTime:vIndArr[1]
      FROM DUAL;
  POSTORA;

  tmstrcpy(vDate, TM_NLS_Get("X", "Date: "));
  tmstrcat(vDate, tDate);
  tmstrcpy(vTime, TM_NLS_Get("X", "Time: "));
  tmstrcat(vTime, tTime);
}

/*****************************************************************************/
/* mc_Header                                                                 */
/*****************************************************************************/
/* Header function                                                           */
/*****************************************************************************/
static void mc_Header(void)
{
  table(T_BEGIN,2);
  prtstr(vRptName);
  prtstr(vVersion);
  newcol();
  setmode(M_CENTER);
  prtstr(vInstitution);
  newcol();
  prtstr(TM_NLS_Get("X", "Page "));
  prtnum(vPageNum, _TMC("99990"));
  newcol();
  prtstr(TM_NLS_Get("X", "Seq. Num.:"));
  prtnum(vRptOneUpNo, _TMC("99999990"));
  newcol();
  setmode(M_CENTER);
  prtstr(vRptTitle);
  newcol();
  prtstr(vDate);
  newcol();
  newcol();
  newcol();
  prtstr(vTime);
  skipline(1);
  table(T_END);

  add( vCurrLine, vCurrLine, _TMC( "4" ) );
}

/*****************************************************************************/
/* mc_SubHeader2                                                             */
/*****************************************************************************/
/* SubHeader function                                                        */
/*****************************************************************************/
static void mc_SubHeader2(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("x", "\nExecuting mc_SubHeader2.\n"));
  #endif
/*
Group 2: CRN
.........1.........2.........3.........4.........5.........6.........7.........8.........9.........A.........B.........C.........D
1...5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0
CRN       COURSE-KEY     Course Title (not printable line)
xxxxxxx   xxxxx-xxxxxx   xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxx   Actividad con SC
*/ 
  add( vCurrLine, vCurrLine, _TMC( "1" ) );
  
  if ( tmatoi( vCurrLine ) > 60 )
  {
    add( vPageNum, vPageNum, _TMC( "1" ) );
    tmstrcpy( vCurrLine, _TMC("0") );
    newpage();
    mc_Header();
    mc_SubHeader1();
    
    newcol();
    table(T_BEGIN,4);
    prtstr(xCRN);
    newcol();
    prtstr(xCourseKey);
    newcol();  
    prtstr(xCourseTitle);
    newcol();   
    setmode(M_CENTER);
    prtstr(TM_NLS_Get("x","NP Activity"));
    newcol();
    table(T_END);
    add( vCurrLine, vCurrLine, _TMC( "2" ) );
  }
  else
  {
    table(T_BEGIN,4);
    prtstr(xCRN);
    newcol();
    prtstr(xCourseKey);
    newcol();  
    prtstr(xCourseTitle);
    newcol();   
    setmode(M_CENTER);
    prtstr(TM_NLS_Get("x","NP Activity"));
    newcol();
    table(T_END);
    add( vCurrLine, vCurrLine, _TMC( "1" ) );
  }

  
}


/*****************************************************************************/
/* mc_SubHeader1                                                              */
/*****************************************************************************/
/* SubHeader function: Print Campus Name                                      */
/*****************************************************************************/
static void mc_SubHeader1(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("x", "\nExecuting mc_SubHeader1.\n"));
  #endif

/*
Group 1: Campus
.........1.........2.........3.........4.........5.........6.........7.........8.........9.........A.........B.........C.........D
1...5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0
Campus xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXx
*/
  add( vCurrLine, vCurrLine, _TMC( "1" ) );

  if ( tmatoi( vCurrLine ) > 60 )
  {
    add( vPageNum, vPageNum, _TMC( "1" ) );
    tmstrcpy( vCurrLine, _TMC("0") );
    newpage();
    mc_Header();
    
    newcol();
    table(T_BEGIN,3);
    newcol();
    prtstr(xCAMP);
    newcol();
    table(T_END);
    add( vCurrLine, vCurrLine, _TMC( "2" ) );
    mc_SubHeader2();
  } 
  else
  {
    table(T_BEGIN,3);
    newcol();
    prtstr(xCAMP);
    newcol();
    table(T_END);
    
    add( vCurrLine, vCurrLine, _TMC( "1" ) );
  }

  
}


/*****************************************************************************/
/* mc_Line1                                                                   */
/*****************************************************************************/
/* Print CRN, Course Key and Course Title Header.                            */
/*****************************************************************************/
static void mc_Line1(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("X", "\nExecuting mc_Line1.\n"));
  #endif

/*
Line 1: student info
.........1.........2.........3.........4.........5.........6.........7.........8.........9.........A.........B.........C.........D
1...5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0....5....0
xxxxxxx   xxxxx-xxxxxx   xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxx   Actividad con SC
   ID                     Name                                    Task     
|--------|x|---------------------------------------------|x|----------------|
xxxxxxxxxX xxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxxxxxxxxxXxxxxxx  xxxxxxxxxXxxxxxxx   (printable line)
*/
  add( vCurrLine, vCurrLine, _TMC( "1" ) );

  if ( tmatoi( vCurrLine ) > 60 )
  {
    add( vPageNum, vPageNum, _TMC( "1" ) );
    tmstrcpy( vCurrLine, _TMC("0") );
    newpage();
    mc_Header();
    mc_SubHeader1();
    mc_SubHeader2();
  }

  table(T_BEGIN,5);
  prtstr( xID );
  newcol();
  prtstr( xNAME );
  newcol();
  setmode(M_CENTER);
  prtstr( xTask );
  newcol();
  table(T_END);

}


/*****************************************************************************/
/* mc_ControlReport                                                          */
/*****************************************************************************/
/* Print detail record                                                       */
/*****************************************************************************/
static void mc_ControlReport(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("X", "\nExecuting mcla_ControlReport.\n"));
  #endif

  newpage();
  add( vPageNum, vPageNum, _TMC("1") );
  mc_Header();

  setmode(M_CENTER);
  prtstr(TM_NLS_Get("X", "* * * * REPORT CONTROL INFORMATION * * * *"));
  skipline(1);
  setmode(M_CENTER);
  tmprintf(&tmBundle,  TM_NLS_Get("X", "{0} (Release: {1})"), vRptName, vVersion );
  setmode(M_NORMAL);
  skipline(1);
  
  if ( !*pFileName )
    {
      prtstr( TM_NLS_Get("X", "File Name................................: %") );
      newcol();
    }
    else
    {
      prtstr( TM_NLS_Get("X", "File Name................................: ") );
      prtstr( pFileName );
      newcol();
  }
  
  
  if ( *pProcTerm && !*pFileName)
      {
        prtstr( TM_NLS_Get("X", "Term.....................................: ") );
        prtstr( pProcTerm );
        newcol();
      }
      else
      {
        prtstr( TM_NLS_Get("X", "Term.....................................: %") );
        
        newcol();
  }
  
  
   if ( !*pPtrmCode )
       {
         prtstr( TM_NLS_Get("X", "Part of term.............................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Part of term.............................: ") );
         prtstr( pPtrmCode );
         newcol();
  }
 
  if ( !*pSubject )
       {
         prtstr( TM_NLS_Get("X", "Subject..................................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Subject..................................: ") );
         prtstr( pSubject );
         newcol();
  }
 
  if ( !*pCrseNum )
       {
         prtstr( TM_NLS_Get("X", "Course Number............................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Course Number............................: ") );
         prtstr( pCrseNum );
         newcol();
  }
  
  if ( *pCrn && !*pFileName )
       {
         prtstr( TM_NLS_Get("X", "Course Reference Number..................: ") );
              prtstr( pCrn );
         newcol();
         
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Course Reference Number..................: %") );
         newcol();
  }

  if ( !*pSchdType )
       {
         prtstr( TM_NLS_Get("X", "Schedule Type............................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Schedule Type............................: ") );
         prtstr( pSchdType );
         newcol();
  }
  
  prtstr( TM_NLS_Get("X", "Grade Code...............................: ") );
  prtstr( pGradeCode );
  newcol();
  
  prtstr( TM_NLS_Get("X", "Run Mode.................................: ") );
  prtstr( pMode );
  newcol();

  skipline(1);
  prtstr( TM_NLS_Get("X", "Processed Records: ") );
  prtnum( vTotRecs , _TMC("999,999,990"));
  newcol();
}



/*****************************************************************************/
/*                                                                           */
/* PARAMETERS READING                                                        */
/*                                                                           */
/*****************************************************************************/

/*****************************************************************************/
/* mc_GetTitle                                                               */
/*****************************************************************************/
/* Get the report title                                                      */
/*****************************************************************************/
static void mc_GetTitle(void)
{
  #ifdef SCT_DEBUG
    tmprintf( &tmBundle, TM_NLS_Get( "X", "Executing GetTitle.\n" ) );
  #endif

  EXEC SQL
    SELECT GJBJOBS_TITLE
      INTO :vRptTitle:vIndArr[0]
      FROM GJBJOBS
     WHERE UPPER( GJBJOBS_NAME ) = UPPER( :vRptName );
  POSTORA;

  mc_ErrMsg( TM_NLS_Get( "X", "GetTitle" ) );
}

/*****************************************************************************/
/* mc_GetInstitution                                                         */
/*****************************************************************************/
/* Get the institution name for report header                                */
/*****************************************************************************/
static void mc_GetInstitution(void)
{
  #ifdef SCT_DEBUG
    tmprintf( &tmBundle, TM_NLS_Get( "X", "Executing GetInstitution.\n" ) );
  #endif

  EXEC SQL
    SELECT LTRIM( RTRIM( GUBINST_NAME, ' ' ), ' ' )
      INTO :vInstitution:vIndArr[0]
      FROM GUBINST;
  POSTORA;

  mc_ErrMsg( TM_NLS_Get( "X", "GetInstitution" ) );
}

/*****************************************************************************/
/* mc_RetrieveParms                                                          */
/*****************************************************************************/
/* If running process from command line, prompt for Parameters. Otherwise    */
/* get Parameters from the GJBPRUN Table.                                    */
/*****************************************************************************/
static void mc_RetrieveParms(void)
{
  int i, vFound;

  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("X", "Executing mc_RetrieveParms.\n"));
  #endif

 /* ======================================================================== */
   if ( *vRptOneUpNo ) tmstrcpy( pFileName, mc_SelParms( 1, _TMC("") ) );
   else
   {
     tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter File Name to process: ") );
     tmgets( pFileName );
     pFileName[100] = '\0';
   }
 
  if (!*pFileName)
  {
      if ( *vRptOneUpNo ) tmstrcpy( pProcTerm, mc_SelParms( 2, _TMC("") ) );
      else
      {
        tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter Term Code: ") );
        tmgets( pProcTerm );
        pProcTerm[7] = '\0';
      }

      if ( !*pProcTerm )
        mc_Bomb( TM_NLS_Get("X", "Missing parameter: Term Code.") );

     /* ======================================================================== */

      if ( *vRptOneUpNo ) tmstrcpy( pPtrmCode, mc_SelParms( 3, _TMC("") ) );
      else
      {
        tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter Part of Term: ") );
        tmgets( pPtrmCode );
      }


     /* ======================================================================== */
      if ( *vRptOneUpNo ) tmstrcpy( pSubject, mc_SelParms( 4, _TMC("") ) );
      else
      {
        tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter Subject Code: ") );
        tmgets( pSubject );
      }

     /* ======================================================================== */
      if ( *vRptOneUpNo ) tmstrcpy( pCrseNum, mc_SelParms( 5, _TMC("") ) );
      else
      {
        tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter Course Number: ") );
        tmgets( pCrseNum );
      }

     /* ======================================================================== */
      if ( *vRptOneUpNo ) tmstrcpy( pCrn, mc_SelParms( 6, _TMC("") ) );
      else
      {
        tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter CRN: ") );
        tmgets( pCrn );
      }

     /* ======================================================================== */
      if ( *vRptOneUpNo ) tmstrcpy( pSchdType, mc_SelParms( 7, _TMC("") ) );
      else
      {
        tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter Schedule Type: ") );
        tmgets( pSchdType );
      }

  }

  /* ======================================================================== */
 if(!*pFileName && !*pProcTerm)
  mc_Bomb( TM_NLS_Get("X", "Missing parameter: File Name.") );


 /* ======================================================================== */
  if ( *vRptOneUpNo ) tmstrcpy( pGradeCode, mc_SelParms( 8, _TMC("") ) );
  else
  {
    tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter Grade Code: ") );
    tmgets( pGradeCode );
  }

  if ( !*pGradeCode )
        mc_Bomb( TM_NLS_Get("X", "Missing parameter: Grade Code.") );

  
 /* ======================================================================== */
  if ( *vRptOneUpNo ) tmstrcpy( pMode, mc_SelParms( 9, _TMC("") ) );
  else
  {
    tmprintf(&tmBundle, TM_NLS_Get("X", "\nEnter Mode: ") );
    tmgets( pMode );
  }  
  
  if ( !*pMode )
        mc_Bomb( TM_NLS_Get("X", "Missing parameter: Mode.") );


 /* ======================================================================== */
  if ( *vRptOneUpNo )
  {
    EXEC SQL
      DELETE GJBPRUN
       WHERE UPPER( GJBPRUN_JOB ) = UPPER( :vRptName )
         AND GJBPRUN_ONE_UP_NO    = TO_NUMBER( :vRptOneUpNo );

    mc_ErrMsg(TM_NLS_Get("X", "RetrieveParms"));
  }
}


/*****************************************************************************/
/* mc_CheckParms                                                             */
/*****************************************************************************/
/* Verifies that the entered Parameters are valid.                           */
/*****************************************************************************/
static void mc_CheckParms(void)
{

  if(!*pFileName)
  {
    /* check term code */
    EXEC SQL
      DECLARE CHK_TERM_C CURSOR FOR
        SELECT 'Y'
          FROM STVTERM
         WHERE STVTERM_CODE = trim(:pProcTerm);
    EXEC SQL OPEN CHK_TERM_C;     
    POSTORA;
    
    EXEC SQL FETCH CHK_TERM_C INTO :vDummy:vIndArr[0]; POSTORA;
    POSTORA;
    
    if ( NO_ROWS_FOUND )
    {
      EXEC SQL CLOSE CHK_TERM_C;
      POSTORA;
      mc_Bomb( TM_NLS_Get( "X", "Term Code is not valid." ) );
    }
    EXEC SQL CLOSE CHK_TERM_C;
    POSTORA;
    
    
    /* check part of term code */
    if(*pPtrmCode)
    {
      EXEC SQL
        DECLARE CHK_PTR_TERM CURSOR FOR
          SELECT 'Y'
            FROM STVPTRM
           WHERE STVPTRM_CODE = trim(:pPtrmCode);
      EXEC SQL OPEN CHK_PTR_TERM;     
      POSTORA;  
      
      EXEC SQL FETCH CHK_PTR_TERM INTO :vDummy:vIndArr[0]; 
      POSTORA;
      
      if ( NO_ROWS_FOUND )
      {
            EXEC SQL CLOSE CHK_PTR_TERM;
            POSTORA;
            mc_Bomb( TM_NLS_Get( "X", "Part of Term Code is not valid." ) );
      }
      EXEC SQL CLOSE CHK_PTR_TERM;
      POSTORA;
    
    }

    /* check subject code */
    if(*pSubject)
    {
      EXEC SQL
          DECLARE CHK_SUBJECT CURSOR FOR 
            SELECT 'Y'
              FROM STVSUBJ SU
             WHERE SU.STVSUBJ_CODE = trim(:pSubject);
      EXEC SQL OPEN CHK_SUBJECT;    
      POSTORA;
      
      EXEC SQL FETCH CHK_SUBJECT INTO :vDummy:vIndArr[0]; 
      POSTORA;
      if ( NO_ROWS_FOUND )
          {
            EXEC SQL CLOSE CHK_SUBJECT;
            POSTORA;
            mc_Bomb( TM_NLS_Get( "X", "Subject Code is not valid." ) );
          }
      EXEC SQL CLOSE CHK_SUBJECT;  
      POSTORA;
      
      /* check course number */
      if(*pCrseNum)
      {
        EXEC SQL
        DECLARE CHK_CRSE_NUM CURSOR FOR 
          SELECT 'Y'
            FROM SCBCRSE sc
           WHERE SC.SCBCRSE_CRSE_NUMB = :pCrseNum
             AND SC.SCBCRSE_SUBJ_CODE = :pSubject
             AND SC.SCBCRSE_EFF_TERM = (select max(X.SCBCRSE_EFF_TERM) 
                          from SCBCRSE x
                         where X.SCBCRSE_CRSE_NUMB = SC.SCBCRSE_CRSE_NUMB
                           and X.SCBCRSE_SUBJ_CODE = SC.SCBCRSE_SUBJ_CODE
                           and X.SCBCRSE_EFF_TERM <= :pProcTerm);
    EXEC SQL OPEN CHK_CRSE_NUM;  
    POSTORA;
    EXEC SQL FETCH CHK_CRSE_NUM INTO :vDummy:vIndArr[0]; POSTORA;
    if ( NO_ROWS_FOUND )
      {
        EXEC SQL CLOSE CHK_CRSE_NUM;
        POSTORA;
        mc_Bomb( TM_NLS_Get( "X", "Course Number is not valid." ) );
      }
    EXEC SQL CLOSE CHK_CRSE_NUM;  
    POSTORA;
      }
    }
    else
    {
      if(*pCrseNum)
        mc_Bomb( TM_NLS_Get( "X", "Must enter a valid Subject Code." ) );   
    }
    
    /* check CRN */
    if(*pCrn)
    {   
        EXEC SQL
        DECLARE CHK_CRN CURSOR FOR 
          SELECT 'Y'
            FROM SSBSECT SB
           WHERE SB.SSBSECT_CRN = :pCrn
         AND SB.SSBSECT_TERM_CODE = :pProcTerm;
    EXEC SQL OPEN CHK_CRN;
    POSTORA;
    
    EXEC SQL FETCH CHK_CRN INTO :vDummy:vIndArr[0]; 
    POSTORA;
    if ( NO_ROWS_FOUND )
      {
        EXEC SQL CLOSE CHK_CRN;
        POSTORA;
        mc_Bomb( TM_NLS_Get( "X", "CRN is not valid." ) );
      }
    EXEC SQL CLOSE CHK_CRN; 
    POSTORA;
    }
    
    /* check schedule type */
    if(*pSchdType)
    {
    EXEC SQL
        DECLARE CHK_SCHD_TYPE CURSOR FOR 
      
          SELECT 'Y'
            FROM STVSCHD S
         WHERE S.STVSCHD_CODE = :pSchdType;
    EXEC SQL OPEN CHK_SCHD_TYPE;     
    POSTORA;
    
    EXEC SQL FETCH CHK_SCHD_TYPE INTO :vDummy:vIndArr[0]; 
    POSTORA;
    if ( NO_ROWS_FOUND )
      {
        EXEC SQL CLOSE CHK_SCHD_TYPE;
        POSTORA;
        mc_Bomb( TM_NLS_Get( "X", "Schedule Type is not valid." ) );
      }
    EXEC SQL CLOSE CHK_SCHD_TYPE;  
    POSTORA;
    }
    
      /* check grade */
      EXEC SQL
          DECLARE CHK_GRADE CURSOR FOR    
         
        SELECT 'Y'
          FROM SHRGRDE GR
         WHERE GR.SHRGRDE_CODE = :pGradeCode
           AND GR.SHRGRDE_TERM_CODE_EFFECTIVE = (SELECT MAX(X.SHRGRDE_TERM_CODE_EFFECTIVE)
                                   FROM SHRGRDE X
                                  WHERE X.SHRGRDE_CODE = GR.SHRGRDE_CODE
                                    AND X.SHRGRDE_TERM_CODE_EFFECTIVE <= :pProcTerm);
      EXEC SQL OPEN CHK_GRADE;
      POSTORA;
      
      EXEC SQL FETCH CHK_GRADE INTO :vDummy:vIndArr[0]; 
      POSTORA;
      if ( NO_ROWS_FOUND )
      {
        EXEC SQL CLOSE CHK_GRADE;
        POSTORA;
        mc_Bomb( TM_NLS_Get( "X", "Grade code is not valid." ) );
      }
      EXEC SQL CLOSE CHK_GRADE;    
      POSTORA;
  }
  else
  {
     /* check file name */
    EXEC SQL
      DECLARE CHK_FILENAME CURSOR FOR    

    SELECT upper(substr(:pFileName,1,4)) file_type, 
           REGEXP_SUBSTR(:pFileName,'[^.]+', 1, 1) file_name,
           upper(REGEXP_SUBSTR(:pFileName,'[^.]+', 1, 2)) file_ext      
    FROM dual;

     EXEC SQL OPEN CHK_FILENAME;
    POSTORA;

     EXEC SQL FETCH CHK_FILENAME 
         INTO :xFileType:vIndArr[0],
          :xFileName:vIndArr[1],
          :xFileExt:vIndArr[2]; 
     POSTORA;
     if ( NO_ROWS_FOUND )
      {
     EXEC SQL CLOSE CHK_FILENAME;
     POSTORA;
     mc_Bomb( TM_NLS_Get( "X", "Should define a file name." ) );
       }
      
      EXEC SQL CLOSE CHK_FILENAME;    
    POSTORA;


      if(tmstrcmp(xFileType, _TMC("CANP")))
    mc_Bomb( TM_NLS_Get( "X", "File name should starts as CANP." ) );

      if(tmstrcmp(xFileExt ,_TMC("CSV")))
    mc_Bomb( TM_NLS_Get( "X", "Should be a CSV extension type." ) );
  }
  
  if ( *pMode != 'U' && *pMode != 'A' )
    mc_Bomb( TM_NLS_Get( "X", "You didn't enter a valid option for Execution Mode." ) );
  
}

/*****************************************************************************/
/* mc_SelParms                                                               */
/*****************************************************************************/
/* Retrieve parameters from job submission                                   */
/*****************************************************************************/
static TMCHAR *mc_SelParms(int PnumIn, TMCHAR *DelimiterIn)
{
  EXEC SQL BEGIN DECLARE SECTION;
    static int    Pnum             = 0;
    static TMCHAR Pval[31]         = {0};
    static TMCHAR ReturnValue[501] = {0};
  EXEC SQL END DECLARE SECTION;

  #ifdef SCT_DEBUG
    tmprintf( &tmBundle, TM_NLS_Get("X", "Executing mc_SelParms.\n"));
  #endif

  Pnum = PnumIn;
  tmstrcpy( Pval, _TMC("") );
  tmstrcpy( ReturnValue, _TMC("") );

  EXEC SQL DECLARE PruCurs CURSOR FOR
    SELECT GJBPRUN_VALUE
      FROM GJBPRUN
     WHERE GJBPRUN_ONE_UP_NO           = TO_NUMBER( :vRptOneUpNo )
       AND UPPER( GJBPRUN_JOB )        = UPPER( :vRptName )
       AND TO_NUMBER( GJBPRUN_NUMBER ) = :Pnum
     ORDER BY GJBPRUN_VALUE;

  EXEC SQL OPEN PruCurs;

  mc_ErrMsg( TM_NLS_Get( "X", "mc_SelParms" ) );

  for( ; ; )
  {
    EXEC SQL WHENEVER NOTFOUND DO break;
    EXEC SQL FETCH PruCurs INTO :Pval:vIndArr[0];
    mc_ErrMsg( TM_NLS_Get( "X", "mc_SelParms" ) );
    EXEC SQL WHENEVER NOTFOUND CONTINUE;

    if ( *Pval )
      tmstrcat( ReturnValue, DelimiterIn );
    tmstrcat( ReturnValue, Pval );
  }

  return ReturnValue;
}



/*****************************************************************************/
/* mc_check_crn_term                                                         */
/*****************************************************************************/
/* Verifies if term code and CRN loaded from file are valid.                */
/*****************************************************************************/
static void mc_check_crn_term(void)
{

    /* remove CR and LF from CRN string */

    EXEC SQL
    DECLARE CHK_REMOVE CURSOR FOR 
      SELECT regexp_substr(:crn, '[^;,|[:cntrl:][:space:]]+',1)  
    from dual;
    EXEC SQL OPEN CHK_REMOVE;
    POSTORA;

    EXEC SQL FETCH CHK_REMOVE INTO :crn:vIndArr[0]; 
    POSTORA;
    if ( NO_ROWS_FOUND )
    {
      EXEC SQL CLOSE CHK_REMOVE;
      POSTORA;
      tmstrcpy(det_msg, CRN_NOTFOUND);
    }
    EXEC SQL CLOSE CHK_REMOVE; 
    POSTORA;

    /* check CRN */

    EXEC SQL
    DECLARE CHK_CRN_TERM CURSOR FOR 
      SELECT 'Y'
        FROM SSBSECT SB
       WHERE SB.SSBSECT_CRN = :crn
             AND SB.SSBSECT_TERM_CODE = :term_code;
    EXEC SQL OPEN CHK_CRN_TERM;
    POSTORA;

    EXEC SQL FETCH CHK_CRN_TERM INTO :vDummy:vIndArr[0]; 
    POSTORA;
    if ( NO_ROWS_FOUND )
    {
      EXEC SQL CLOSE CHK_CRN_TERM;
      POSTORA;
      tmstrcpy(det_msg, CRN_NOTFOUND);
    }
    EXEC SQL CLOSE CHK_CRN_TERM; 
    POSTORA;
    
    /* check Grade code */

    EXEC SQL
     DECLARE CHK_GRADE_TERM CURSOR FOR    
         
        SELECT 'Y'
          FROM SHRGRDE GR
         WHERE GR.SHRGRDE_CODE = :pGradeCode
           AND GR.SHRGRDE_TERM_CODE_EFFECTIVE = (SELECT MAX(X.SHRGRDE_TERM_CODE_EFFECTIVE)
                                   FROM SHRGRDE X
                                  WHERE X.SHRGRDE_CODE = GR.SHRGRDE_CODE
                                    AND X.SHRGRDE_TERM_CODE_EFFECTIVE <= :term_code);
    EXEC SQL OPEN CHK_GRADE_TERM;
    POSTORA;
      
    EXEC SQL FETCH CHK_GRADE_TERM INTO :vDummy:vIndArr[0]; 
    POSTORA;
    if ( NO_ROWS_FOUND )
      {
        EXEC SQL CLOSE CHK_GRADE_TERM;
        POSTORA;
        mc_Bomb( TM_NLS_Get( "X", "Grade code is not valid." ) );
      }
    EXEC SQL CLOSE CHK_GRADE_TERM;    
    POSTORA;    
  
}

/*****************************************************************************/
/*                                                                           */
/* ERROR HANDLING                                                            */
/*                                                                           */
/*****************************************************************************/

/*****************************************************************************/
/* mc_ValidateOneUpNo                                                        */
/*****************************************************************************/
/* Validate the job sequence number                                          */
/*****************************************************************************/
static void mc_ValidateOneUpNo(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("X", "Executing mc_ValidateOneUpNo.\n") );
  #endif

  EXEC SQL DECLARE PrunCur CURSOR FOR
    SELECT 'Y'
      FROM GJBPRUN
     WHERE UPPER( GJBPRUN_JOB ) = UPPER( :vRptName )
       AND GJBPRUN_ONE_UP_NO    = TO_NUMBER( :vRptOneUpNo );
  EXEC SQL OPEN PrunCur;

  EXEC SQL
    FETCH PrunCur
     INTO :vDummy :vIndArr[0];
  POSTORA;

  mc_ErrMsg( TM_NLS_Get("X", "mc_ValidateOneUpNo") );

  if ( NO_ROWS_FOUND )
    mc_ErrMsg( TM_NLS_Get("X", "Invalid Sequence Number") );
}

/*****************************************************************************/
/* mc_ErrMsg                                                                 */
/*****************************************************************************/
/* Output errors to report control page                                      */
/*****************************************************************************/
static void mc_ErrMsg(TMCHAR *StringIn)
{
  if( ( sqlca.sqlcode < 0 ) || ( !tmstrcmp( StringIn, TM_NLS_Get("X", "Invalid Sequence Number" ) ) ) )
  {
    sqlglm( gMsgBuf, &gBufSize, &gMsgLen );
    gMsgBuf[gMsgLen] = '\0';
    tmprintf( &tmBundle,  _TMC( "\n\n\n\n" ) );
    if( tmstrcmp( StringIn, TM_NLS_Get( "X", "Invalid Sequence Number" ) ) == 0 )
      tmprintf( &tmBundle,  TM_NLS_Get( "X", "Error: {0}\n" ), StringIn );
    else
      tmprintf( &tmBundle,  TM_NLS_Get( "X", " Error executing the function {0}.\n" ), StringIn );
    mc_Bomb( gMsgBuf );
  }
  else
    return;
}

/*****************************************************************************/
/* mc_Bomb                                                                   */
/*****************************************************************************/
/* Process failed, rollback transactions and release cursors                 */
/*****************************************************************************/
static void mc_Bomb ( TMCHAR *Str )
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get( "X", "Executing mc_Bomb.\n" ) );
  #endif

  tmprintf( &tmBundle, TM_NLS_Get("X", "AUTOMATIC TERMINATION CONDITION.  PROGRAM TERMINATION.\n" ) );
  tmprintf( &tmBundle, TM_NLS_Get("X", "The message is --> |{0}|\n" ), Str );
  mc_RollbackRelease();
  exit2os( EXIT_FAILURE );
}

/*****************************************************************************/
/* mc_RollbackRelease                                                        */
/*****************************************************************************/
/* Rollback transactions and release cursors                                 */
/*****************************************************************************/
static void mc_RollbackRelease(void)
{
  #ifdef SCT_DEBUG
    tmprintf( &tmBundle, TM_NLS_Get("X", "Executing RollbackRelease.\n" ) );
  #endif

  EXEC SQL ROLLBACK WORK RELEASE;
}



