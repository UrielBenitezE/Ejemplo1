                               WHERE ( CR.SCRCORQ_SUBJ_CODE= :lv_Subj
                                    AND CR.SCRCORQ_CRSE_NUMB = :lv_Crse )
                               OR ( CR.SCRCORQ_SUBJ_CODE_CORQ = :lv_Subj
                                    AND CR.SCRCORQ_CRSE_NUMB_CORQ = :lv_Crse )
                      )
       AND (NVL(SF.SFRSTCR_ERROR_FLAG,'N') <> 'F')
                  AND (    SF.SFRSTCR_ERROR_FLAG NOT IN ('F','D')
