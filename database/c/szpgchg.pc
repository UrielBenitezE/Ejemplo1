static int open_data_file(void)
{
  EXEC SQL BEGIN DECLARE SECTION;
    static TMCHAR lv_msg[100]           = {0};
    static TMCHAR tRecordTypeValue[16]  = {0};
  EXEC SQL END DECLARE SECTION;

  #ifdef SCT_DEBUG
     tmprintf(&tmBundle,  TM_NLS_Get("x","Executing function mc_ProcessFile.\n") );
  #endif

  tmstrcpy(lv_msg, TM_NLS_Get("x","(Define in GTVSDAX form the value to the file path for FILE DIR)"));
  EXEC SQL
     EXECUTE
        DECLARE
           description   gtvsdax.GTVSDAX_COMMENTS%TYPE;

           CURSOR get_gtvsdax_desc_c(l_internal_code VARCHAR2,
                                     l_group_code    VARCHAR2) IS
           SELECT GTVSDAX_COMMENTS
             FROM gtvsdax
            WHERE gtvsdax_internal_code       = l_internal_code
              AND gtvsdax_internal_code_group = l_group_code;

           BEGIN
              OPEN get_gtvsdax_desc_c('FILE_DIR', 'UTM002');
              FETCH get_gtvsdax_desc_c INTO :pvFilePath;
              CLOSE get_gtvsdax_desc_c;
              IF (:pvFilePath IS NULL or :pvFilePath = 'UPDATEME') THEN
                  :pvFilePath := :lv_msg;
              END IF;
       END;
  END-EXEC;
  POSTORA;

 #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: UTM002: [{0}]\n"), pvFilePath );
  #endif

  if ( !tmstrcmp( pvFilePath, lv_msg ) )
  {
    tmprintf(&tmBundle, _TMC("{0}\n"),pvFilePath );
    prtstr( lv_msg );
  }
  else
  {
     #if OPSYS==OS_UNIX
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}/{1}"),
                 pvFilePath,  pFileName );
     #else
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}\\{1}"),
                 pvFilePath,  pFileName );
     #endif

  }
  
  #ifdef SCT_DEBUG
      tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: Full name of the file: [{0}]\n"), pvFileFullName );
  #endif
  
  if ( ( fp = tmfopen(&tmBundle,  pvFileFullName, _TMC("r") ) ) == NULL )
  {
      tmprintf(&tmBundle,  TM_NLS_Get("x"," File {0} not found or Input/Output error\n"), pvFileFullName );
      exit2os( EXIT_FAILURE );
  }
  
  return TRUE;
  
}


/* Reads in csv file and separates column values into variables.
   Then call process_detail routine for each record readed in. 
*/
static void process_infile(void)
{
  int    i;
  int    lv_line_size =0;
  int    lv_end_pos =0;
  int    lv_epos =0;
  int    lv_beg_pos =0;
  int    lv_sep=0;
  int    lv_repos=0;
  int    max_line=100;
  char   separador;
  TMCHAR lv_achr[2]={0};

  EXEC SQL BEGIN DECLARE SECTION;
      static TMCHAR   lv_msg[100] = {0};
  EXEC SQL END DECLARE SECTION;

  tmstrcpy(lv_msg, TM_NLS_Get("x","(Define in GTVSDAX form the value to the file separator character for DELIMITADO)"));
  EXEC SQL
     EXECUTE
       BEGIN
           :vCharSeparator := trim(gokeacc.f_getgtvsdaxextcode ('DELIMITADO', 'UTM002'));
           IF (:vCharSeparator IS NULL or :vCharSeparator like 'UPDAT%') THEN
             :vCharSeparator := ',';    /* it assumes comma (,) by default */
           ELSE
             :vDummy := LENGTH(trim(:vCharSeparator));
           END IF;
       END;
     END-EXEC;
  POSTORA;
  
  EXEC SQL EXECUTE
     BEGIN 
     	szkgchg.p_delete_szrgchg(trim(:pFileName), /*BIEN*/
     			         trim(:pMode)
     			       );
     	
  
     END;
    END-EXEC;
  POSTORA;
  
  open_data_file();

  while (tmfgets(det_record, max_line,fp) != NULL) {
    if (tmstrcmp(rec_cnt,_TMC("0"))) {
      tmstrcat(det_record, vCharSeparator);
      lv_line_size = tmstrlen(det_record);
      lv_beg_pos =0;
      lv_end_pos =0;
      lv_repos =0;
      lv_sep =0;
      init_line_var();
      for (i=0; i < lv_line_size; i++) 
      {
        substr(lv_achr,det_record,i,1);
        if (!tmstrcmp(lv_achr, vCharSeparator)) {
          lv_sep++;
          lv_end_pos = i;
          lv_epos =lv_end_pos-lv_beg_pos; 
          if (compare( pProcess, _TMC("R"), EQS) )
          {
            switch (lv_sep) 
            {
              case 1:  substr(student_id,det_record,lv_beg_pos,lv_epos);
                break;
              case 2: substr(term_code,det_record,lv_beg_pos,lv_epos);
                break;
              case 3: substr(course,det_record,lv_beg_pos,lv_epos);
                break;
              case 4: substr(grade_code,det_record,lv_beg_pos,lv_epos);
                break;
              case 5: substr(pcrn,det_record,lv_beg_pos,lv_epos);
                break;
              case 6: substr(grade_comm,det_record,lv_beg_pos,lv_epos);
                break;
	     }
          }
          else
          {
            switch (lv_sep) 
            {
              case 1:  substr(student_id,det_record,lv_beg_pos,lv_epos);
                break;
              case 2: substr(term_code,det_record,lv_beg_pos,lv_epos);
                break;
              case 3: substr(course,det_record,lv_beg_pos,lv_epos);
                break;
              case 4: substr(grade_code,det_record,lv_beg_pos,lv_epos);
                break;
              case 5: substr(pcrn,det_record,lv_beg_pos,lv_epos);
                break;
              case 6: substr(grade_comm,det_record,lv_beg_pos,lv_epos);
                break;
              case 7: substr(change_reason,det_record,lv_beg_pos,lv_epos);
                break; 
            }
          }          
          
          lv_beg_pos = lv_end_pos+1;
        }
        else if (!tmstrcmp(lv_achr, _TMC("\r")) || !tmstrcmp(lv_achr,_TMC("\n"))) 
          lv_repos++;
      }
      process_detail();
    }
    add(rec_cnt, rec_cnt,one);
  }
  tmfclose(fp);

}

static void check_input(void)
{
  if (compare( pProcess, _TMC("R"), EQS) )
  {
     if (tmstrlen(student_id) > 10 ||
        tmstrlen(term_code) > 7 ||
        tmstrlen(course) > 10 ||
        tmstrlen(grade_code) > 7 ||
        tmstrlen(grade_comm) > 8 ||
        tmstrlen(pcrn) > 6 
        )  tmstrcpy(det_msg, LENGTH_EXCEED);
  }
  else
  {
     if (tmstrlen(student_id) > 10 ||
        tmstrlen(term_code) > 7 ||
        tmstrlen(course) > 10 ||
        tmstrlen(grade_code) > 7 ||
        tmstrlen(grade_comm) > 8 ||
        tmstrlen(change_reason) > 5 ||
        tmstrlen(pcrn) > 6 
        )  tmstrcpy(det_msg, LENGTH_EXCEED);  
  }
}

static void process_detail(void)
{
  
  check_input();


  if (!*det_msg) 
  {
 
     mc_MainProcess();
  }

  

}


static void mc_MainProcess(void)
{
  int i;

  /*tmstrcpy( vTotRecs, _TMC( "0" ) );*/

  
  /* Record counting */
  add( vTotRecs, vTotRecs, _TMC( "1" ) );
  
  /*
  tmprintf(&tmBundle,  TM_NLS_Get("x","StudentID: [{0}] term_code[{1}] course [{2}] grade_code [{3}] crn [{4}] grade_comm [{5}] change_reason [{6}] pApprovedGrade [{7}] pChangeReason [{8}] \n"), 
  			student_id,
  			term_code,
  			course,
  			grade_code,
  			pcrn,
  			grade_comm,
  			change_reason,
  			pApprovedGrade,
  			pChangeReason
         );
  */
  
  
  EXEC SQL EXECUTE
   BEGIN 
   	szkgchg.p_process_file(trim(:student_id), /*BIEN*/
   			       trim(:term_code),
   			       trim(:course),
   			       trim(:grade_code),
   			       trim(:pcrn),
   			       trim(:grade_comm),
   			       trim(:pMode), 
   			       trim(:pProcess),
   			       trim(:pFileName),
   			       trim(:change_reason),
   			       trim(:pApprovedGrade),
   			       trim(:pChangeReason)
   			       );
   	

   END;
  END-EXEC;
  POSTORA;

  EXEC SQL EXECUTE BEGIN gb_common.p_commit(NULL); END; END-EXEC; POSTORA; /*BIEN*/
    
}

/*****************************************************************************/
/*                                                                           */
/* PRINTING ROUTINES                                                         */
/*                                                                           */
/*****************************************************************************/

/*****************************************************************************/
/* mc_GetToday                                                               */
/*****************************************************************************/
/* Get the Date & Time of Execution                                          */
/*****************************************************************************/
static void mc_GetToday(void)
{
  EXEC SQL BEGIN DECLARE SECTION;
    static TMCHAR tDate[12] = {0};
    static TMCHAR tTime[12] = {0};
  EXEC SQL END DECLARE SECTION;

  EXEC SQL
    SELECT LTRIM(RTRIM(TO_CHAR(SYSDATE, G$_DATE.GET_NLS_DATE_FORMAT))),
           TO_CHAR(SYSDATE, 'HH24:MI')
      INTO :tDate:vIndArr[0],
           :tTime:vIndArr[1]
      FROM DUAL;
  POSTORA;

  tmstrcpy(vDate, TM_NLS_Get("X", "Date: "));
  tmstrcat(vDate, tDate);
  tmstrcpy(vTime, TM_NLS_Get("X", "Time: "));
  tmstrcat(vTime, tTime);
}

/*****************************************************************************/
/* mc_Header                                                                 */
/*****************************************************************************/
/* Header function                                                           */
/*****************************************************************************/
static void mc_Header(void)
{
  table(T_BEGIN,2);
  prtstr(vRptName);
  prtstr(vVersion);
  newcol();
  setmode(M_CENTER);
  prtstr(vInstitution);
  newcol();
  prtstr(TM_NLS_Get("X", "Page "));
  prtnum(vPageNum, _TMC("99990"));
  newcol();
  prtstr(TM_NLS_Get("X", "Seq. Num.:"));
  prtnum(vRptOneUpNo, _TMC("99999990"));
  newcol();
  setmode(M_CENTER);
  prtstr(vRptTitle);
  newcol();
  prtstr(vDate);
  newcol();
  newcol();
  newcol();
  prtstr(vTime);
  skipline(1);
  table(T_END);

  add( vCurrLine, vCurrLine, _TMC( "4" ) );
}


/*****************************************************************************/
/* mc_ControlReport                                                          */
/*****************************************************************************/
/* Print detail record                                                       */
/*****************************************************************************/
static void mc_ControlReport(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("X", "\nExecuting mcla_ControlReport.\n"));
  #endif

  newpage();
  add( vPageNum, vPageNum, _TMC("1") );
  mc_Header();

  setmode(M_CENTER);
  prtstr(TM_NLS_Get("X", "* * * * REPORT CONTROL INFORMATION * * * *"));
  skipline(1);
  setmode(M_CENTER);
  tmprintf(&tmBundle,  TM_NLS_Get("X", "{0} (Release: {1})"), vRptName, vVersion );
  setmode(M_NORMAL);
  skipline(1);
  
  if ( !*pFileName )
    {
      prtstr( TM_NLS_Get("X", "File Name................................: %") );
      newcol();
    }
    else
    {
      prtstr( TM_NLS_Get("X", "File Name................................: ") );
      prtstr( pFileName );
      newcol();
  }
 
  if ( !*pProcess )
       {
         prtstr( TM_NLS_Get("X", "Process..................................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Process..................................: ") );
         prtstr( pProcess );
         newcol();
  }
 
  if ( !*pMode )
       {
         prtstr( TM_NLS_Get("X", "Execution Mode...........................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Execution Mode...........................: ") );
         prtstr( pMode );
         newcol();
  }
  
  if ( !*pApprovedGrade )
       {
         prtstr( TM_NLS_Get("X", "Approved Grade Code......................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Approved Grade Code......................: ") );
         prtstr( pApprovedGrade );
         newcol();
  }

  if ( !*pChangeReason )
       {
         prtstr( TM_NLS_Get("X", "Change Reason Code.......................: %") );
         newcol();
       }
       else
       {
         prtstr( TM_NLS_Get("X", "Change Reason Code.......................: ") );
         prtstr( pChangeReason );
         newcol();
  }
  
  skipline(1);
  prtstr( TM_NLS_Get("X", "Processed Records: ") );
  prtnum( vTotRecs , _TMC("999,999,990"));
  newcol();
}



/*****************************************************************************/
