/*****************************************************************************/
/*                                                                           */
/* MAIN                                                                      */
/*                                                                           */
/*****************************************************************************/
int main ( int argc, TMCHAR *argv[] )
{
  rptopen( user_pass, argc, argv );
  login();

  tmprintf(&tmBundle,  TM_NLS_Get("X", "Starting {0} (Release: {1})\n\n"), vRptName, vVersion );

  /* Tables definition */
  table(T_DEFINE, 1, 1,110, NULL);
    /* ******************************************************************************** */
  table(T_DEFINE, 2, 1, 30, 32, 92, 94, 110, NULL);
    /* |----------------------------| |-----------------------------------------------------------| |---------------| */

  pgformat(1,66);

  input( vRptOneUpNo, TM_NLS_Get("X", "Execution Sequence Number:"), 26, NUM );
  if( *vRptOneUpNo ) mc_ValidateOneUpNo();

  mc_RetrieveParms();
  mc_CheckParms();
  mc_GetInstitution();
  mc_GetTitle();
  mc_GetToday();
  
  table(T_BEGIN, 1);
  mc_Header();

  tmstrcpy( vTotRecs, _TMC( "0" ) );


  process_infile();
  
  mc_ControlReport();

  exit2os( EXIT_SUCCESS );
  return EXIT_SUCCESS;
}


/* Initialize variables used for processing a student */
static void init_line_var(void)
{
  *student_id    	= '\0';
  *term_code      	= '\0';
  *det_msg 		= '\0';
  *course		= '\0';
  *grade_code    	= '\0';
  *pcrn			= '\0';
  *grade_comm		= '\0';
  *change_reason	= '\0';

}



