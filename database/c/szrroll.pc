/* Report print variables */

   static TMCHAR  sotprnt_rectype[7];
   static TMCHAR sotprnt_id[10];
   static TMCHAR sotprnt_name[31];
   static TMCHAR  sotprnt_crn[6];
   static TMCHAR  sotprnt_term[7];
   static TMCHAR  sotprnt_ptrm[4];
   static TMCHAR  sotprnt_subject[5];
   static TMCHAR  sotprnt_course[6];
   static TMCHAR sotprnt_ctitle[31];
   static TMCHAR  sotprnt_levl_1[3];
   static TMCHAR  sotprnt_degc_1[7];
   static TMCHAR  sotprnt_coll_1[3];
   static TMCHAR  sotprnt_majr_1[5];
   static TMCHAR  sotprnt_camp[4];
   static BANNUMSTR(sotprnt_pseq1);
   static TMCHAR  sotprnt_levl_2[3];
   static TMCHAR  sotprnt_degc_2[7];
   static TMCHAR  sotprnt_coll_2[3];
   static TMCHAR  sotprnt_majr_2[5];
   static BANNUMSTR(sotprnt_pseq2);
   static TMCHAR  sotprnt_deg1_updated[2];
   static TMCHAR  sotprnt_deg1_created[2];
   static TMCHAR  sotprnt_deg2_updated[2];
   static TMCHAR  sotprnt_deg2_created[2];
   static BANNUMSTR(sotprnt_count_processed);
   static TMCHAR  sotprnt_err_msg[121];

/* *** Gdatevalid variables */
   static TMCHAR  errflag[2]={0}/*TMCI18N CHANGED FROM ""*/;
   static TMCHAR errmsg[61]={0}/*TMCI18N CHANGED FROM ""*/;

  /* Shared indicator variables for SELECTs */

         short   Ind_01;
         short   Ind_02;
         short   Ind_03;
         short   Ind_04;
         short   Ind_05;
         short   Ind_06;
         short   Ind_07;
         short   Ind_08;
         short   Ind_09;
         short   Ind_10;
         short   Ind_11;
         short   Ind_12;
         short   Ind_13;
         short   Ind_14;
         short   Ind_15;
         short   Ind_16;
         short   Ind_17;
         short   Ind_18;
         short   Ind_19;
         short   Ind_20;
         short   Ind_21;
         short   Ind_22;
         short   Ind_23;
         short   Ind_24;
         short   Ind_25;
         short   Ind_26;
         short   Ind_27;
         short   Ind_28;
         short   Ind_29;
         short   Ind_30;
         short   Ind_36;

EXEC SQL END DECLARE SECTION;

/* Local prototypes */

static void readfromdate(void);
static void readtodate(void);
static void readgradeterm(void);
static void readrolltitle(void);
static void get_term_desc(void);
static int checkdates(void);
static int checkptrm(void);
static int checkallterm(void);
static int valid_term_code(void);
static int validate_one_up_no(int mode);
static int sel_optional_ind(int mode);
static int read_line_count(int mode);
static int readterm(int mode);
static int readcrn(int mode);
static int readuser(int mode);
static int readmode(int mode);
static int readprint(int mode);
static int readparms(int mode);
static int selmacro(int mode);
static int seldate(int mode);
static int readcampus(int mode);
static int readlevel(int mode);


/* 5.5 Defect 75190
static int sel_collector_crn(int mode);*/
static int selinst(int mode);
static int seltitle(int mode);
static int readcolr(int mode);
static int retrieve_parms(void);
static void delete_parms(void);
static void delete_prnt(void);
static void delete_colr(void);
static void lockcolr(void);
