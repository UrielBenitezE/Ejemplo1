static int checkdates(void)
{
  if (  ( !*start_from_date && *start_to_date ) ||
        ( *start_from_date && !*start_to_date)  )
      {
        tmprintf(&tmBundle, TM_NLS_Get("X","Start Range FROM_DATE and TO_DATE must both be entered, or both must be NULL.\n"));
        return FALSE;
      }

  if ( *start_from_date && *start_to_date )
    {
     EXEC SQL DECLARE cursor_111 CURSOR FOR
         SELECT 'X'
          FROM   DUAL
          WHERE  TO_DATE(:start_from_date,G$_DATE.GET_NLS_DATE_FORMAT) <=
                                 TO_DATE(:start_to_date,G$_DATE.GET_NLS_DATE_FORMAT);

     EXEC SQL OPEN cursor_111;
     POSTORA;

     EXEC SQL FETCH cursor_111 INTO
          :dummy_var:Ind_01;
     POSTORA;

     if ( NO_ROWS_FOUND )
       {
         EXEC SQL CLOSE cursor_111;
         POSTORA;
         tmprintf(&tmBundle, TM_NLS_Get("X","Start Range FROM_DATE must be less than or equal to TO_DATE.\n"));
         return FALSE;
       }
     EXEC SQL CLOSE cursor_111;
     POSTORA;
    }
  return TRUE;
}

static int checkptrm(void)
{
  if  ( *start_from_date && *start_to_date )
    if ( compare(ptrm,_TMC("%"),NES) )
     {
       tmprintf(&tmBundle, TM_NLS_Get("X","Must specify ALL for PTRM when using Start Date Range.\n"));
       return FALSE;
     }

  return TRUE;
}

static int checkallterm(void)
{
  if ( compare(term,_TMC("%"),EQS) )
    if  (  !(*start_from_date && *start_to_date ) )
      {
        tmprintf(&tmBundle, TM_NLS_Get("X","Must specify Start Date Range when value of Term is ALL.\n"));
        return FALSE;
      }

  return TRUE;
}

static int selmacro(int mode)
{
  EXEC SQL DECLARE cursor_010 CURSOR FOR
        SELECT GJBPRUN_VALUE
        FROM   GJBPRUN
        WHERE  GJBPRUN_NUMBER = '04'
        AND    GJBPRUN_VALUE IS NOT NULL
        AND    GJBPRUN_JOB = UPPER(:rptname)
        AND GJBPRUN_ONE_UP_NO = TO_NUMBER(:rpt_one_up_no);

  if ( mode==CLOSE_CURSOR )
    {
      EXEC SQL CLOSE cursor_010;
      POSTORA;
      return TRUE;
  }

  if ( mode==FIRST_ROW )
    {
      EXEC SQL OPEN cursor_010;
      POSTORA;
    }

  EXEC SQL FETCH cursor_010 INTO
       :ptrm:Ind_01;
  POSTORA;

  if ( NO_ROWS_FOUND )
    {
      *ptrm='\0';
      return FALSE;
    }

  if ( !checkptrm() )
    {
      tmstrcpy(end_run,_TMC("Y"));
      return FALSE;
    }

  return TRUE;
}

