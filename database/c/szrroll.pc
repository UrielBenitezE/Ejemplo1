/* ------------------------------------------------------------------- */
/*                                                                     */
/* Parameters: RPTNAME - directory & filename of SQL*Report program    */
/*             TERM - Effective term of report                         */
/*             PTRM - PTRM or multiple PTRMS to be selected; % = All   */
/*             CRN  - CRN or multiple CRNs to be selected; % = All     */
/*             USER ID - User Id to be put onto Academic History rows  */
/*             REPORT MODE - Audit(A) or Update(U)                     */
/*             PRINT SELECTION - Print All(A) or Print Errors Only(E)  */
/*                                                                     */
/* Tables:                                                             */
/*             GUBINST Institution Table                               */
/*             GJBJOBS Jobs Table                                      */
/*             SCBCRSE Course General Info Table                       */
/*             SFRSTCR Student Course Registration Table               */
/*             SGBSTDN Student Base Table                              */
/*             SHRATTC History Course Section Attributes Table         */
/*             SHRDGMR Degrees Sought/Awarded Table                    */
/*             SHRGCOL Grade Mailer Collector Table                    */
/*             SHRGRDO Valid Grading Modes Maint Table                 */
/*             SHRGRDS Grading Mode Substitution Table                 */
/*             SHRINST Acad Hist Instructor Table                      */
/*             SHRTCKD Inst Course Term Degree Applied Table           */
/*             SHRTCKG Institutional Courses Grade Table               */
/*             SHRTCKL Inst Course Maint Level Applied Table           */
/*             SHRTCKN Inst Course Term Maint Table                    */
/*             SHRLGPA Level GPA Table                                 */
/*             SHRTGPA Term GPA Table                                  */
/*             SHRTTRM Inst Course Maint Term Header Table             */
/*             SSBSECT Section General Information Table               */
/*             SSBOVRR Schedule Override Table                         */
/*             SSRATTR Section Attribute Table                         */
/* Views:                                                              */
/*                                                                     */
/* Parameter variables                                                 */
/*                                                                     */
/* Rename parameter fields used by the report to names appropriate for */
/* the application. All eight parameters must remain in the program.   */
/* Supply all unused parameters with nulls.                            */

EXEC SQL BEGIN DECLARE SECTION;
  static TMCHAR   rptname[8]={0}/*TMCI18N CHANGED FROM ""*/;
