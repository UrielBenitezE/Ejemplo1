static void hold_course_info(void);
static void print_course(void);
static void print_student(void);
static void print_hist_err(void);
static void print_api_err(void);
static void print_grade_err(void);
static void print_footer(void);
static void header(void);
static void printparm(void);
static void print_collector_parm(void);
static void insertptrm(void);
static void insert_colr_ptrm(void);
static void insertcrn(void);
static void insert_colr_crn(void);
static void getsession(void);
static void insert_colr_level(void);
static int checklevel(void);
static void insertlevl(void);
static void print_coreq_diff_grade(void);
static void print_coreq_grade_miss(void);

/* ************************************************************************** */

int main(int argc,TMCHAR *argv[])
{
  /* switch to turn on the sql_trace option */

  extern short sqltrace_flag;

  rptopen(user_pass,argc,argv);

  login();

  if ( sqltrace_flag )
    EXEC SQL ALTER SESSION SET SQL_TRACE TRUE;

/* Initialize variables */

  tmstrcpy(count,_TMC("0"));
  tmstrcpy(one,_TMC("1"));
  tmstrcpy(five,_TMC("5"));
  tmstrcpy(linelimit,_TMC("55"));
  tmstrcpy(pageno,_TMC("0"));
  tmstrcpy(footer_ind,_TMC("N"));
  tmstrcpy(hold_course_ind,_TMC("N"));
  sysdate(time_var,ORA_NLS_TIME_FORMAT);
  tmstrcpy(rptname,_TMC("SZRROLL"));

  getsession();

/* Table definitions                            */
/*                                              */
/* Table 1 page definition                      */
/* Table 2 1-24    Date and time/Term           */
/*         51-81   Institution/Title            */
/*         123-132 Page/SQL*Report program name */
/* Table 3 1-5     CRN                          */
/*         10-10   PTRM                         */
/*         15-18   Subject                      */
/*         20-23   Course Number                */
/*         26-55   Course Title                 */
/* Table 4 1-9     ID Number                    */
/*         20-49   Name                         */
/*         60-99   Roll Message                 */
/*         105-111 Error Indicator              */

  table(T_DEFINE,1,1,132,NULL);
  table(T_DEFINE,2,1,24,51,81,123,132,NULL);

/* #DT 3 1 5 10 10 15 18 20 23 26 55 # */
/* #DT 4 1 9 20 49 60 99 105 111 #     */

/* 6.0 Define 42404 */
/*  table(T_DEFINE,3,1,5,10,10,15,18,20,24,26,55,92,97,99,102,104,107,109,112, */
/*                   114,116,118,118,120,132,NULL);*/

  /* Defect 87599: Change last two columns for tables 3 and 4 from 118,118 */
  /*               to 118,120 and from 120,132 to 122,132                  */
 /*  table(T_DEFINE,3,1,5,10,12,15,18,20,24,26,55,92,97,99,102,104,107,109,112,
                   114,116,118,120,122,132,NULL);
  table(T_DEFINE,4,1,9,11,40,42,77,79,89,91,98,100,102,104,107,109,112,114,116,
                   118,120,122,132,NULL); */
  /* 7.3 change layout to include the pgm */
  table(T_DEFINE,3,1,5, 10,12, 15,18, 20,24, 26,55, 72,78, 80, 84, 86,90, 92,96,  98,101, 103,106,
                  108, 120, 121,132, NULL);

  table(T_DEFINE,4,1,9, 11,40, 42,70, 72,78, 80, 84, 86,90, 92,96,  98,101, 103,106,
                  108, 120, 121,132,NULL);
  table(T_DEFINE,5,5,132,NULL);
  table(T_BEGIN,1);

/* *** Job submission alteration */
/*                               */
/* Add Standard Ask              */

  *start_from_date='\0';
  *start_to_date='\0';
  tmstrcpy(ptrm_ind,_TMC("N"));
  input(ask_one_up_no,TM_NLS_Get("X","RUN SEQUENCE NUMBER: "),26,NUM);
  if ( !*ask_one_up_no ) goto ask_parms;
  tmstrcpy(rpt_one_up_no,ask_one_up_no);
  tmstrcpy(valid_ind,_TMC("N"));
  validate_one_up_no(FIRST_ROW);
  if ( compare(valid_ind,_TMC("Y"),EQS) ) goto retrieve_parms_lbl;
  goto no_parms;
  retrieve_parms_lbl:
    if ( !retrieve_parms() )
      goto end_report;
/*****API Replaced EXEC SQL COMMIT; POSTORA;                            *****/

    EXEC SQL EXECUTE BEGIN gb_common.p_commit(NULL); END; END-EXEC; POSTORA; /*BIEN*/
    goto end_parms;
  ask_parms:

/* ***                                  */
/* Ask for parameters                   */
/* Rename appropriate parameter fields. */

  get_term:
    input(ask_term,TM_NLS_Get("X","TERM: "),6,ALPHA);
    if ( !*ask_term ) goto opt_term;
    tmstrcpy(valid_term,ask_term);
    if ( compare(valid_term,_TMC("%"),EQS) )
      {
        tmstrcpy(term,valid_term);
        goto nextparma;
      }
    if ( !valid_term_code() )
       {
        tmprintf(&tmBundle, TM_NLS_Get("X","Invalid term code. "));
        goto get_term;
       }
    tmstrcpy(term,ask_term);
    goto nextparma;
  opt_term:
    tmstrcpy(parm_no,_TMC("01"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparma;
    goto missing_parms;
  nextparma:
    input(ask_from_date,TM_NLS_Get("X","START RANGE FROM_DATE: "),11,ALPHA);
    if ( !*ask_from_date )
      if ( !checkallterm() )
         goto missing_parms;
    if ( !*ask_from_date )
      goto opt_from_date;
    tmstrcpy(start_from_date,ask_from_date);
    EXEC SQL EXECUTE
     BEGIN
       gdatevalid(:start_from_date,:cenpivot,:errflag,:errmsg,'');
     END;
    END-EXEC;
     if (tmstrcmp(errflag,_TMC("")) != 0)
       {
         tmprintf(&tmBundle, TM_NLS_Get("X","{0}\n"),errmsg);
         goto nextparma;
       }
    goto nextparmb;
  opt_from_date:
    tmstrcpy(parm_no,_TMC("02"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparmc;
    goto missing_parms;
  nextparmb:
    input(ask_to_date,TM_NLS_Get("X","START RANGE TO_DATE: "),11,ALPHA);
    if ( !*ask_to_date ) goto date_continue;
    tmstrcpy(start_to_date,ask_to_date);
    EXEC SQL EXECUTE
     BEGIN
       gdatevalid(:start_to_date,:cenpivot,:errflag,:errmsg,'');
     END;
    END-EXEC;
     if (tmstrcmp(errflag,_TMC("")) != 0)
       {
         tmprintf(&tmBundle, TM_NLS_Get("X","{0}\n"),errmsg);
         goto nextparmb;
       }
  date_continue:
    if ( !checkdates() )
      goto missing_parms;
  nextparmc:
    tmstrcpy(ptrm_ind,_TMC("N"));
  ask_ptrm:
    input(ask_ptrm_var,_TMC("PTRM({0,% f}or ALL): "),4,ALPHA);
    if ( !*ask_ptrm_var ) goto opt_ptrm;
    tmstrcpy(ptrm_ind,_TMC("Y"));
    tmstrcpy(ptrm,ask_ptrm_var);
    insert_colr_ptrm();
    if ( compare(ptrm,_TMC("%"),EQS) ) goto nextparmd;
    if ( !checkptrm() )
      goto missing_parms;
    goto ask_ptrm;
  opt_ptrm:
    if ( compare(ptrm_ind,_TMC("Y"),EQS) ) goto nextparmd;
    tmstrcpy(parm_no,_TMC("04"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparmd;
    goto missing_parms;
  nextparmd:
    tmstrcpy(crn_ind,_TMC("N"));
  ask_crn:
    input(ask_crn_var,_TMC("CRN({0,% f}or ALL): "),5,ALPHA);
    if ( !*ask_crn_var ) goto opt_crn;
    tmstrcpy(crn_ind,_TMC("Y"));
    tmstrcpy(crn,ask_crn_var);
    insert_colr_crn();
    if ( compare(crn,_TMC("%"),EQS) ) goto nextparme;
    goto ask_crn;
  opt_crn:
    if ( compare(crn_ind,_TMC("Y"),EQS) ) goto nextparme;
    tmstrcpy(parm_no,_TMC("05"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparme;
    goto missing_parms;
  nextparme:
    input(ask_current_user,TM_NLS_Get("X","USER ID: "),30,ALPHA);
    if ( !*ask_current_user ) goto opt_user;
    tmstrcpy(current_user,ask_current_user);
    goto nextparmf;
  opt_user:
    tmstrcpy(parm_no,_TMC("06"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparmf;
    goto missing_parms;
  nextparmf:
    input(ask_report_mode,TM_NLS_Get("X","REPORT MODE(A=AUDIT,U=UPDATE): "),1,ALPHA);
    if ( !*ask_report_mode ) goto opt_mode;
    if ( !compare(ask_report_mode,_TMC("A"),EQS) &&
                                  !compare(ask_report_mode,_TMC("U"),EQS) )
       {
        tmprintf(&tmBundle, TM_NLS_Get("X","Invalid value. "));
        goto nextparmf;
       }
    tmstrcpy(report_mode,ask_report_mode);
    goto nextparmg;
  opt_mode:
    tmstrcpy(parm_no,_TMC("07"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparmg;
    goto missing_parms;
  nextparmg:
    input(ask_print_sel,TM_NLS_Get("X","PRINT SELECTION(A=ALL,E=ERRORS): "),1,ALPHA);
    if ( !*ask_print_sel ) goto opt_print;
    if ( !compare(ask_print_sel,_TMC("A"),EQS) &&
                                  !compare(ask_print_sel,_TMC("E"),EQS) )
       {
        tmprintf(&tmBundle, TM_NLS_Get("X","Invalid value. "));
        goto nextparmg;
       }
    tmstrcpy(print_sel,ask_print_sel);
    goto nextparmh;
  opt_print:
    tmstrcpy(parm_no,_TMC("08"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparmh;
    goto missing_parms;
  nextparmh:
    input(ask_grade_term,TM_NLS_Get("X","GRADE TERM: "),6,ALPHA);
    if ( !*ask_grade_term) goto opt_grade_term;
    tmstrcpy(valid_term,ask_grade_term);
    if ( !valid_term_code() )
       {
        tmprintf(&tmBundle, TM_NLS_Get("X","Invalid term code. "));
        goto nextparmh;
       }
    tmstrcpy(grade_term,ask_grade_term);
    goto nextparmi;
  opt_grade_term:
    tmstrcpy(parm_no,_TMC("09"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparmi;
    goto missing_parms;
  nextparmi:
    input(ask_roll_title,TM_NLS_Get("X","ROLL LONG SECTION TITLE (Y,[N]): "),1,ALPHA);
    if ( !*ask_roll_title)
       tmstrcpy(ask_roll_title,_TMC("N"));
    if ( !compare(ask_roll_title,_TMC("Y"),EQS) &&
                                  !compare(ask_roll_title,_TMC("N"),EQS) )
       {
        tmprintf(&tmBundle, TM_NLS_Get("X","Invalid value. "));
        goto nextparmi;
       }
    tmstrcpy(roll_title,ask_roll_title);
    goto nextparlv;
  /* opt_roll_title: */
    tmstrcpy(parm_no,_TMC("10"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto nextparlv;
    goto missing_parms;
  nextparlv:
     tmstrcpy(level_ind,_TMC("N"));

ask_level:

      input(ask_level,_TMC("LEVEL({0,% f}or ALL): "),3,ALPHA);
      if ( !*ask_level ) goto opt_level;
      tmstrcpy(level_ind,_TMC("Y"));
      tmstrcpy(level,ask_level);
      insert_colr_level();
      if ( compare(level,_TMC("%"),EQS) ) goto get_campus;

      goto ask_level;

    opt_level:
      if ( compare(level_ind,_TMC("Y"),EQS) ) goto get_campus;
      tmstrcpy(parm_no,_TMC("11"));
      sel_optional_ind(FIRST_ROW);
      if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto get_campus;
    goto missing_parms;

  get_campus:
    input(ask_campus,TM_NLS_Get("X","CAMPUS: "),4,ALPHA);
    if ( !*ask_campus ) goto opt_campus;
    tmstrcpy(campus,ask_campus);
    goto get_campus;
  opt_campus:
    tmstrcpy(parm_no,_TMC("12"));
    sel_optional_ind(FIRST_ROW);
    if ( compare(rpt_optional_ind,_TMC("O"),EQS) ) goto ask_line_count;
    goto missing_parms;


  ask_line_count:
    input(ask_line_count_var,TM_NLS_Get("X","NUMBER OF LINES PRINTED PER PAGE [55]: "),26,NUM);
    if ( !*ask_line_count_var ) goto init_line_count;
    tmstrcpy(linelimit,ask_line_count_var);
    goto end_parms;
  init_line_count:
    tmstrcpy(linelimit,_TMC("55"));
    goto end_parms;

/* *** Error Messages */

  missing_parms:
    tmprintf(&tmBundle, TM_NLS_Get("X","Required parameter is missing or invalid, aborting job\n"));
    goto end_report;
  no_parms:
    tmprintf(&tmBundle, TM_NLS_Get("X","Parameter sequence number is invalid, aborting job\n"));
    goto end_report;
  end_parms:

/* Macros which need to be executed one time per program execution */
    seldate(FIRST_ROW);
    selinst(FIRST_ROW);
    seltitle(FIRST_ROW);
/*  header(); */

    EXEC SQL EXECUTE
      BEGIN
        szkrols.p_do_graderoll(:term,:crn, /*BIEN*/
                   :current_user,
                               :sessionid,
                               :print_sel,
                               :report_mode,
                               :start_from_date,
                               :start_to_date,
                               :grade_term,
                               :roll_title,
                               :campus,
                               :level
                               );
      END;
    END-EXEC;
    POSTORA;

    write_report();

    if (!tmstrcmp(report_mode,_TMC("A")))
     { EXEC SQL EXECUTE BEGIN gb_common.p_rollback(NULL); END; END-EXEC; POSTORA; } /*BIEN*/

end_report:

    delete_colr();
    delete_parms();
    delete_prnt();


/*****API Replaced EXEC SQL COMMIT; POSTORA;                            *****/

    EXEC SQL EXECUTE BEGIN gb_common.p_commit(NULL); END; END-EXEC; POSTORA; /*BIEN*/
    exit2os(EXIT_SUCCESS);

  return EXIT_SUCCESS;
}

static int validate_one_up_no(int mode)
{
  EXEC SQL DECLARE cursor_001 CURSOR FOR
        SELECT 'Y'
        FROM GJBPRUN
        WHERE GJBPRUN_JOB = :rptname
        AND   GJBPRUN_ONE_UP_NO = TO_NUMBER(:rpt_one_up_no);

  if ( mode==CLOSE_CURSOR )
    {
      EXEC SQL CLOSE cursor_001;
      POSTORA;
      return TRUE;
  }

  if ( mode==FIRST_ROW )
    {
      EXEC SQL OPEN cursor_001;
      POSTORA;
    }

  EXEC SQL FETCH cursor_001 INTO
       :valid_ind:Ind_01;
  POSTORA;

  if ( NO_ROWS_FOUND )
    {
      *valid_ind='\0';
      return FALSE;
    }

  return TRUE;
}

static int valid_term_code(void)
{
  tmstrcpy(valid_ind,_TMC("N"));

  EXEC SQL SELECT 'Y' INTO :valid_ind
        FROM STVTERM
        WHERE STVTERM_CODE = :valid_term;

  POSTORA;

  if ( compare(valid_ind,_TMC("Y"),EQS) )
      return TRUE;
  else
      return FALSE;
}

static void get_term_desc(void)
{
  EXEC SQL SELECT stvterm_desc
      INTO term_desc
      FROM stvterm
     WHERE stvterm_code = :print_term;
  POSTORA;
}

static int get_sotprnt(int mode)
{
  EXEC SQL DECLARE cursor_100 CURSOR FOR
        SELECT sotprnt_rectype,
               sotprnt_id,
               sotprnt_name,
               sotprnt_crn,
               sotprnt_term_code,
               sotprnt_ptrm_code,
               sotprnt_subj_code,
               sotprnt_crse_numb,
               sotprnt_crse_title,
               sotprnt_levl_code_1,
               sotprnt_degc_code_1,
               sotprnt_coll_code_1,
               sotprnt_majr_code_1,
               sotprnt_camp_code,
               TO_CHAR(sotprnt_seqno_1),
               sotprnt_levl_code_2,
               sotprnt_degc_code_2,
               sotprnt_coll_code_2,
               sotprnt_majr_code_2,
               TO_CHAR(sotprnt_seqno_2),
               sotprnt_deg1_updated_ind,
               sotprnt_deg1_created_ind,
               sotprnt_deg2_updated_ind,
               sotprnt_deg2_created_ind,
               sotprnt_count_processed,
               sotprnt_err_msg
          FROM sotprnt
         WHERE sotprnt_sessionid = :sessionid
           AND sotprnt_job = 'SZRROLL'
         ORDER BY sotprnt_recnum;

  if ( mode==CLOSE_CURSOR )
    {
      EXEC SQL CLOSE cursor_100;
      POSTORA;
      return TRUE;
  }

  if ( mode==FIRST_ROW )
    {
      EXEC SQL OPEN cursor_100;
      POSTORA;
    }

  EXEC SQL FETCH cursor_100 INTO
       :sotprnt_rectype:Ind_01,
       :sotprnt_id:Ind_02,
       :sotprnt_name:Ind_03,
       :sotprnt_crn:Ind_04,
       :sotprnt_term:Ind_05,
       :sotprnt_ptrm:Ind_06,
       :sotprnt_subject:Ind_07,
       :sotprnt_course:Ind_08,
       :sotprnt_ctitle:Ind_09,
       :sotprnt_levl_1:Ind_10,
       :sotprnt_degc_1:Ind_11,
       :sotprnt_coll_1:Ind_12,
       :sotprnt_majr_1:Ind_13,
       :sotprnt_camp:Ind_14,
       :sotprnt_pseq1:Ind_15,
       :sotprnt_levl_2:Ind_16,
       :sotprnt_degc_2:Ind_17,
       :sotprnt_coll_2:Ind_18,
       :sotprnt_majr_2:Ind_19,
       :sotprnt_pseq2:Ind_20,
       :sotprnt_deg1_updated:Ind_21,
       :sotprnt_deg1_created:Ind_22,
       :sotprnt_deg2_updated:Ind_23,
       :sotprnt_deg2_created:Ind_24,
       :sotprnt_count_processed:Ind_25,
       :sotprnt_err_msg:Ind_36;
  POSTORA;

  if ( NO_ROWS_FOUND )
    {
      return FALSE;
    }

  return TRUE;
}

static void print_report(void)
{
  if (compare(sotprnt_rectype,_TMC("COURSE"),EQS))
    {
     if (compare(print_sel,_TMC("E"),EQS))
       {
        tmstrcpy(hold_course_ind,_TMC("Y"));
        hold_course_info();
       }
     else
        print_course();
    }
  else if (compare(sotprnt_rectype,_TMC("STUDNT"),EQS))
     print_student();
  else if (compare(sotprnt_rectype,_TMC("GRDERR"),EQS))
     print_grade_err();
  else if (compare(sotprnt_rectype,_TMC("HSTERR"),EQS))
     print_hist_err();
  else if (compare(sotprnt_rectype,_TMC("APIERR"),EQS))
     print_api_err();
  else if (compare(sotprnt_rectype,_TMC("CRQGDM"),EQS))
     print_coreq_grade_miss();
  else if (compare(sotprnt_rectype,_TMC("CRQGDF"),EQS))
     print_coreq_diff_grade();

  else if (compare(sotprnt_rectype,_TMC("FOOTER"),EQS))
     print_footer();
}

/* Retrive mandatory/optional indicator for Parm */

static int sel_optional_ind(int mode)
{
  EXEC SQL DECLARE cursor_002 CURSOR FOR
        SELECT GJBPDEF_OPTIONAL_IND
        FROM GJBPDEF
        WHERE GJBPDEF_JOB = :rptname
        AND   GJBPDEF_NUMBER = TO_NUMBER(:parm_no);

  if ( mode==CLOSE_CURSOR )
    {
      EXEC SQL CLOSE cursor_002;
      POSTORA;
      return TRUE;
  }

  if ( mode==FIRST_ROW )
    {
      EXEC SQL OPEN cursor_002;
      POSTORA;
    }

  EXEC SQL FETCH cursor_002 INTO
       :rpt_optional_ind:Ind_01;
  POSTORA;

  if ( NO_ROWS_FOUND )
    {
      *rpt_optional_ind='\0';
      return FALSE;
    }

  return TRUE;
}

