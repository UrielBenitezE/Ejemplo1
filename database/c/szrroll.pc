static void print_student(void)
{
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       print_course();
    add(lineno,lineno,one);
    if ( compare(lineno,linelimit,LT) ) goto thispage1;
    newpage();
    header();
    add(lineno,lineno,one);
  thispage1:
    table(T_BEGIN,4);
    prtstr(sotprnt_id);
    newcol();
    prtstr(sotprnt_name);
    newcol();
    prtstr(TM_NLS_Get("X","Rolled to Academic History"));
    newcol();
    /* Defect 87599: Print header info in audit mode too.*/
    /* if ( compare(report_mode,"A",EQS) ) goto aud_mode;*/
    /* if ( compare(report_mode,"a",EQS) ) goto aud_mode;*/
    /*  print this in the header so the pgm fits:  prtstr("Applied to:");
    newcol();  */
    setmode(M_CENTER);
    prtstr(sotprnt_degc_1);
    newcol();
    setmode(M_CENTER);
    prtstr(sotprnt_levl_1);
    newcol();
    setmode(M_CENTER);
    prtstr(sotprnt_coll_1);
    newcol();
    setmode(M_CENTER);
    prtstr(sotprnt_majr_1);
    newcol();
    setmode(M_CENTER);
    prtnum(sotprnt_pseq1,_TMC("99"));
    newcol();
    prtstr(sotprnt_camp);
    newcol();
    prtstr(sotprnt_ctitle);
    newcol();
    if ( compare(sotprnt_deg1_created,_TMC("N"),EQS) ) goto check_majr;
    prtstr(TM_NLS_Get("X","Deg Created"));
    goto aok;
  check_majr:
    if ( compare(sotprnt_deg1_updated,_TMC("N"),EQS) ) goto aok;
    prtstr(TM_NLS_Get("X","Deg Updated"));
  aok:
    newcol();
    goto end_it;
  /* aud_mode: */
    newcol();
    newcol();
    newcol();
    newcol();
    newcol();
    newcol();
   /* newcol(); */
  end_it:
    if ( compare(sotprnt_pseq2,_TMC("0"),EQS) ) goto end_it2;
    /* Defect 106084: If the pseq2 value is null, we have nothing else to print. */
    if (!*sotprnt_pseq2) goto end_it2;
    add(lineno,lineno,one);
    if ( compare(lineno,linelimit,GES) )
    {
      newpage();
      header();
      add(lineno,lineno,one);
      prtstr(sotprnt_id);
      newcol();
      prtstr(sotprnt_name);
      newcol();
    }
    else
    {
      newcol();
      newcol();
    }
    prtstr(TM_NLS_Get("X","Rolled to Academic History"));
    newcol();
    /* Defect 87599: Print header info in audit mode too. */
    /* if ( compare(report_mode,"A",EQS) ) goto aud_mode2;*/
    /* if ( compare(report_mode,"a",EQS) ) goto aud_mode2;*/
    prtstr(TM_NLS_Get("X","Applied to:"));
    newcol();
    setmode(M_CENTER);
    prtstr(sotprnt_degc_2);
    newcol();
    setmode(M_CENTER);
    prtstr(sotprnt_levl_2);
    newcol();
    setmode(M_CENTER);
    prtstr(sotprnt_coll_2);
    newcol();
    setmode(M_CENTER);
    prtstr(sotprnt_majr_2);
    newcol();
    setmode(M_CENTER);
    prtnum(sotprnt_pseq2,_TMC("99"));
    newcol();
    prtstr(sotprnt_camp);
    newcol();
    if ( compare(sotprnt_deg2_created,_TMC("N"),EQS) ) goto check_majr2;
    prtstr(TM_NLS_Get("X","Deg Created"));
    goto aok2;
  check_majr2:
    if ( compare(sotprnt_deg2_updated,_TMC("N"),EQS) ) goto aok2;
    prtstr(TM_NLS_Get("X","Deg Updated"));
  aok2:
    newcol();
    goto end_it2;
  /* aud_mode2: */
    newcol();
    newcol();
    newcol();
    newcol();
    newcol();
    newcol();
    newcol();
  end_it2:
    table(T_END);
}

static void insertptrm(void)
{
  lockcolr();
  insert_colr_ptrm();
}

static void insertcrn(void)
{
  lockcolr();
  insert_colr_crn();
}


static void insertlevl(void)
{
  lockcolr();
  insert_colr_level();
}
