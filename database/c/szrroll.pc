/* Application related select macros (alpha order) */

/* Procedural macros             */
/* *** Job submission alteration */
/*                               */
/* Add Retrieve Parms Macro      */

static int retrieve_parms(void)
{
  tmstrcpy(end_run,_TMC("N"));
  readterm(FIRST_ROW);
  readfromdate();
  readtodate();
  if ( !checkallterm() )
    return FALSE;
  if ( !checkdates() )
    return FALSE;
  report(selmacro,insertptrm,NULL,NULL);
  if ( compare(end_run,_TMC("Y"),EQS) )
    return FALSE;
  report(readcrn,insertcrn,NULL,NULL);
  readuser(FIRST_ROW);
  readmode(FIRST_ROW);
  readprint(FIRST_ROW);
  readgradeterm();
  readrolltitle();
  readcampus(FIRST_ROW);
  report(readlevel,insertlevl,NULL,NULL);
  read_line_count(FIRST_ROW);
  if ( *linelimit )
    return TRUE;
  tmstrcpy(linelimit,_TMC("55"));
  return TRUE;
}

static int readcolr(int mode)
{
  EXEC SQL DECLARE cursor_016 CURSOR FOR
        SELECT SPRCOLR_PARM_NUMBER,SPRCOLR_VALUE_ATYP
        FROM   SPRCOLR
        WHERE  SPRCOLR_JOB = UPPER(:rptname)
        AND    SPRCOLR_SESSIONID = :sessionid
        /* AND    (SPRCOLR_PARM_NUMBER = '04' OR SPRCOLR_PARM_NUMBER = '05') */
        AND    SPRCOLR_PARM_NUMBER in ('04', '05', '11')
        ORDER BY SPRCOLR_PARM_NUMBER,SPRCOLR_VALUE_ATYP;

  if ( mode==CLOSE_CURSOR )
    {
      EXEC SQL CLOSE cursor_016;
      POSTORA;
      return TRUE;
  }

  if ( mode==FIRST_ROW )
    {
      EXEC SQL OPEN cursor_016;
      POSTORA;
    }

  EXEC SQL FETCH cursor_016 INTO
       :parm_number:Ind_01,
       :parm_value:Ind_02;
  POSTORA;

  if ( NO_ROWS_FOUND )
    {
      *parm_number='\0';
      *parm_value='\0';
      return FALSE;
    }

  return TRUE;
}


static void insert_colr_ptrm(void)
{
  EXEC SQL
        INSERT INTO SPRCOLR /*BIEN*/
          (sprcolr_sessionid, sprcolr_type, sprcolr_value_date,
           sprcolr_value_atyp, sprcolr_activity_date,
           sprcolr_job, sprcolr_parm_number)
        VALUES (:sessionid,'','',:ptrm,SYSDATE,UPPER(:rptname),
                '04');
  POSTORA;
}

static void insert_colr_crn(void)
{
  EXEC SQL
        INSERT INTO SPRCOLR /*BIEN*/
          (sprcolr_sessionid, sprcolr_type, sprcolr_value_date,
           sprcolr_value_atyp, sprcolr_activity_date,
           sprcolr_job, sprcolr_parm_number)
        VALUES (:sessionid,'','',:crn,SYSDATE,UPPER(:rptname),
                '05');
  POSTORA;
}


static void insert_colr_level(void)
{
  EXEC SQL
        INSERT INTO SPRCOLR /*BIEN*/
          (sprcolr_sessionid, sprcolr_type, sprcolr_value_date,
           sprcolr_value_atyp, sprcolr_activity_date,
           sprcolr_job, sprcolr_parm_number)
        VALUES (:sessionid,'','',:level,SYSDATE,UPPER(:rptname),
                '11');
  POSTORA;
}


/* Get session id */

static void getsession(void)
{
  EXEC SQL
        SELECT USERENV('SESSIONID')
  INTO :sessionid
  FROM DUAL;
  POSTORA;
}

static void delete_colr(void)
{
  EXEC SQL
        DELETE FROM SPRCOLR
        WHERE SPRCOLR_SESSIONID = :sessionid;
  POSTORA;
}

static void delete_prnt(void)
{
  EXEC SQL
        DELETE FROM SOTPRNT
        WHERE SOTPRNT_SESSIONID = :sessionid
        AND SOTPRNT_JOB = 'SZRROLL';
  POSTORA;
}

static void lockcolr(void)
{
  EXEC SQL
       LOCK TABLE SPRCOLR IN SHARE UPDATE MODE;
  POSTORA;
}

/* Head macro executes after the first row is read. The heading information */
/* is printed and then the first row is processed.                          */

/* Heading information */

static void header(void)
{
  table(T_BEGIN,2);
  prtstr(date);
  prtstr(time_var);
  newcol();
  setmode(M_CENTER);
  prtstr(institution);
  newcol();
  prtstr(TM_NLS_Get("X","PAGE"));
  add(pageno,pageno,one);
  prtnum(pageno,_TMC("99999"));
  newcol();
  if ( compare(footer_ind,_TMC("Y"),NES) )
    {
      prtstr(print_term);
      prtstr(term_desc);
    }
  newcol();
  setmode(M_CENTER);
  prtstr(title_var);
  newcol();
  prtstr(rptname);
  skipline(1);

/* Set line number equal to number of lines in heading */

  tmstrcpy(lineno,_TMC("3"));
  table(T_END);
}

/* Print foot of report after all rows have been processed. */
/* Foot should contain at least all user defined parameters */
/* and a count of processed records.                        */

static void print_footer(void)
{
  tmstrcpy(footer_ind,_TMC("Y"));
  newpage();
  header();
  setmode(M_CENTER);
  prtstr(TM_NLS_Get("X","* * * REPORT CONTROL INFORMATION -"));
  prtstr(rptname);
  prtstr(TM_NLS_Get("X","- Release 8.7 [MCLA:002.1.0]"));
  setmode(M_NORMAL);
  skipline(1);
  prtstr(TM_NLS_Get("X","Term:"));
  prtstr(term);
  newline();
  prtstr(TM_NLS_Get("X","Start Range From Date:"));
  prtstr(start_from_date);
  newline();
  prtstr(TM_NLS_Get("X","Start Range To Date:"));
  prtstr(start_to_date);
  report(readparms,printparm,NULL,NULL);
  if ( compare(ptrm_ind,_TMC("Y"),EQS) ) goto read_collector;
  if ( compare(crn_ind,_TMC("Y"),EQS) ) goto read_collector;
  if ( compare(level_ind,_TMC("Y"),EQS) ) goto read_collector;
  goto continue_print;
  read_collector:
    report(readcolr,print_collector_parm,NULL,NULL);
  continue_print:
    newline();
    prtstr(TM_NLS_Get("X","Current User:"));
    prtstr(current_user);
    newline();
    prtstr(TM_NLS_Get("X","Report Mode:"));
    prtstr(report_mode);
    newline();
    prtstr(TM_NLS_Get("X","Print Selection:"));
    prtstr(print_sel);
    newline();
    prtstr(TM_NLS_Get("X","Grade Term:"));
    prtstr(grade_term);
    newline();
    prtstr(TM_NLS_Get("X","Roll Long Section Title:"));
    prtstr(roll_title);
    newline();
    skipline(1);
    prtstr(TM_NLS_Get("X","RECORD COUNT:"));
    prtnum(sotprnt_count_processed,_TMC("9999990"));
}

static void printparm(void)
{
  if ( compare(parm_number,_TMC("01"),EQS) ) return;
  if ( compare(parm_number,_TMC("02"),EQS) ) return;
  if ( compare(parm_number,_TMC("03"),EQS) ) return;
  if ( compare(parm_number,_TMC("06"),EQS) ) return;
  if ( compare(parm_number,_TMC("07"),EQS) ) return;
  if ( compare(parm_number,_TMC("08"),EQS) ) return;
  if ( compare(parm_number,_TMC("09"),EQS) ) return;
  if ( compare(parm_number,_TMC("10"),EQS) ) return;
  if ( compare(parm_number,_TMC("05"),EQS) ) goto parm_5;

  if ( compare(ptrm_ind,_TMC("Y"),EQS) ) return;
  newline();
  prtstr(parm_desc);
  prtstr(_TMC(":"));
  prtstr(parm_value);
  return;
  parm_5:
    if ( compare(crn_ind,_TMC("Y"),EQS) ) return;
    newline();
    prtstr(parm_desc);
    prtstr(_TMC(":"));
    prtstr(parm_value);
    return;

}

static void print_collector_parm(void)
{
  if ( compare(parm_number,_TMC("01"),EQS) ) return;
  if ( compare(parm_number,_TMC("04"),EQS) ) return;
  if ( compare(parm_number,_TMC("03"),EQS) ) goto parm_3;

  if ( compare(ptrm_ind,_TMC("N"),EQS) ) return;
  newline();
  prtstr(TM_NLS_Get("X","Ptrm:"));
  prtstr(parm_value);
  return;
  parm_3:
    if ( compare(crn_ind,_TMC("N"),EQS) ) return;
    newline();
    prtstr(TM_NLS_Get("X","Course Reference Number:"));
    prtstr(parm_value);
    return;
}

static void hold_course_info(void)
{
   tmstrcpy(hold_term,sotprnt_term);
   tmstrcpy(hold_crn,sotprnt_crn);
   tmstrcpy(hold_ptrm,sotprnt_ptrm);
   tmstrcpy(hold_subject,sotprnt_subject);
   tmstrcpy(hold_course,sotprnt_course);
   tmstrcpy(hold_ctitle,sotprnt_ctitle);
}

static void print_course(void)
{
  if (compare(hold_course_ind,_TMC("Y"),EQS))
     tmstrcpy(sotprnt_term,hold_term);
  add(lineno,lineno,five);
  if ( compare(lineno,linelimit,LT) &&
       compare(sotprnt_term,print_term,EQS) ) goto samepage;
  tmstrcpy(print_term,sotprnt_term);
  get_term_desc();
  if ( compare(pageno,_TMC("0"),NES) )
    newpage();
  header();
  add(lineno,lineno,five);
  samepage:
    table(T_BEGIN,3);
    skipline(4);
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       prtstr(hold_crn);
    else
       prtstr(sotprnt_crn);
    newcol();
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       prtstr(hold_ptrm);
    else
       prtstr(sotprnt_ptrm);
    newcol();
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       prtstr(hold_subject);
    else
       prtstr(sotprnt_subject);
    newcol();
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       prtstr(hold_course);
    else
       prtstr(sotprnt_course);
    newcol();
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       prtstr(hold_ctitle);
    else
       prtstr(sotprnt_ctitle);
    tmstrcpy(hold_course_ind,_TMC("N"));
    newcol();
    /* Defect 87599: Print header in audit mode too.     */
    /* if ( compare(report_mode,"A",EQS) ) goto ok_inst; */
    /* if ( compare(report_mode,"a",EQS) ) goto ok_inst; */
    prtstr(TM_NLS_Get("X","Degree"));
    newcol();
    prtstr(TM_NLS_Get("X","Levl"));
    newcol();
    prtstr(TM_NLS_Get("X","Coll"));
    newcol();
    prtstr(TM_NLS_Get("X","Majr"));
    newcol();
    prtstr(TM_NLS_Get("X","Seq"));
    newcol();
    prtstr(TM_NLS_Get("X","Cmp"));

    /*
    newcol();
    prtstr(TM_NLS_Get("X","Pgm"));
    */
  /* ok_inst: */
    table(T_END);
}

static void write_report(void)
{
  report(get_sotprnt,print_report,NULL,NULL);
}

static void print_grade_err(void)
{
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       print_course();
    add(lineno,lineno,one);
    if ( compare(lineno,linelimit,LT) ) goto thispage;
    newpage();
    header();
    add(lineno,lineno,one);
  thispage:
    table(T_BEGIN,4);
    prtstr(sotprnt_id);
    newcol();
    prtstr(sotprnt_name);
    newcol();
    prtstr(TM_NLS_Get("X","No Substitute Grade Found"));
    newcol();
    prtstr(TM_NLS_Get("X","*ERROR*"));
    table(T_END);
}

static void print_hist_err(void)
{
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       print_course();
    add(lineno,lineno,one);
    if ( compare(lineno,linelimit,LT) ) goto thispage0;
    newpage();
    header();
    add(lineno,lineno,one);
  thispage0:
    table(T_BEGIN,4);
    prtstr(sotprnt_id);
    newcol();
    prtstr(sotprnt_name);
    newcol();
    prtstr(TM_NLS_Get("X","Graded Section Exists in History"));
    newcol();
    prtstr(TM_NLS_Get("X","*ERROR*"));
    table(T_END);
}

static void print_api_err(void)
{
    if (compare(hold_course_ind,_TMC("Y"),EQS))
       print_course();
    add(lineno,lineno,one);
    if ( compare(lineno,linelimit,LT) ) goto thispage0;
    newpage();
    header();
    add(lineno,lineno,one);
  thispage0:
    table(T_BEGIN,4);
    prtstr(sotprnt_id);
    newcol();
    prtstr(sotprnt_name);
    newcol();
    prtstr(TM_NLS_Get("X","API Error"));
    table(T_END);
    table(T_BEGIN,5);
    prtstr(sotprnt_err_msg);
    table(T_END);
}


