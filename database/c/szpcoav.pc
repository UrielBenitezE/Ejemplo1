  static TMCHAR  pvFileFullName[128];                        /* State File name        */

  static TMCHAR  vFileLine[410];
  static TMCHAR  vCharSeparator[128];                        /* Character separator    */
  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecRead,27,_TMC("0"));
  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecInserted,27,_TMC("0"));
  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecIgnored,27,_TMC("0"));
  static BANNUMSTR(rpt_record_num)        = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvTerm[7]                = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvCrn[6]                 = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvSbj[10]                = {0};
  static TMCHAR  lvCrse[10]               = {0};
  static TMCHAR  lvPartTerm[4]            = {0};
  static TMCHAR  lvSubject[5]             = {0};
  static TMCHAR  lvCrseNumb[6]            = {0};
  static TMCHAR  lvScheduleType[4]        = {0};
  static TMCHAR  vPIDM[100]               = {0};
  static TMCHAR  lvLimitDA[3]             = {0};
  static TMCHAR  lvIsCORQ[2]              = {0};
  static TMCHAR  vNumDANoExFin[500]       = {0};
  static TMCHAR  lvCampCode[100]          = {0};
  static TMCHAR  lvGcomId[9]              = {0};
  static TMCHAR  lvMsg[100]               = {0};
  static TMCHAR  lvPercentage[7]          = {0};
  static TMCHAR  vName[100]               = {0};
  static TMCHAR  vID[100]                 = {0};
  static TMCHAR  lvScheme[100]            = {0};
  static TMCHAR  lvDescCamp[100]          = {0};
  static TMCHAR  lvDICD_CODE[100]         = {0};
  static TMCHAR  lvDescSub[100]           = {0};
  static TMCHAR  lvSubCrs[100]            = {0};
  static TMCHAR  lvCrnTmp[6]              = {0};
  static TMCHAR  vNumDANoExFinCoReq[500]  = {0};
  static TMCHAR  lvGradeCode[7]           = {0};
  static TMCHAR  lvPidm[9]                = {0};
  static TMCHAR  lvSubj[5]            = {0};
  static TMCHAR  lvMessage[500]           = {0};
  static TMCHAR  lvCount[5]               = {0};
  static TMCHAR  lv_Name[40]              = {0};
  static TMCHAR  lv_Id[40]                = {0};

  static TMCHAR vCrn[31]                = {0};


  static TMCHAR vErrorCode[100]    = {0};
  static TMCHAR vErrMsg[100]       = {0};

