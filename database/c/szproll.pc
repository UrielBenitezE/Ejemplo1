static void mc_MainProcess(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, TM_NLS_Get("x", "Executing mc_MainProcess.\n"));
  #endif

 /* mc_InitializeVars();*/

 
   EXEC SQL DECLARE GET_STUDENTS CURSOR FOR
   /*   MKU    Changed        03/MAY/2016       8.7.0 [UTM:002.1.1]   */
    SELECT DISTINCT 
           SFRSTCR_GRDE_CODE,
           SFRSTCR_PIDM, 
           SSBSECT_CRN,
           SSBSECT_SUBJ_CODE,
           SSBSECT_CRSE_NUMB, 
           SFRSTCR_LEVL_CODE
      FROM SSBSECT, SFRSTCR
     WHERE SSBSECT_CRN          = SFRSTCR_CRN 
       AND SSBSECT_TERM_CODE    = SFRSTCR_TERM_CODE
       And SFRSTCR_TERM_CODE    = :pTerm
       and SFRSTCR_CRN          = :pCRN
       and trim(SFRSTCR_GRDE_CODE) is not null
       AND Sfrstcr_Grde_DATE IS NULL
       and (NVL(SFRSTCR_ERROR_FLAG,'N') <> 'F')
       /* BA 8.7.0 [UTM:002.1.2] GGR 30-JUN-2017 */
       /*
         AND (sfrstcr_error_flag not in ('F')
                 or sfrstcr_error_flag is null
                 or sfrstcr_rsts_code in (select stvrsts_code
                                            from stvrsts
                                           where stvrsts_code = sfrstcr_rsts_code
                                             and stvrsts_gradable_ind = 'Y'))
       */
       and sfrstcr_rsts_code in (select stvrsts_code
                                   from stvrsts
                                  where stvrsts_code = sfrstcr_rsts_code
                                    and stvrsts_gradable_ind = 'Y'
                                    and stvrsts_withdraw_ind = 'N' and stvrsts_code Not in ('BG','BM','DW','WL')
                                )
       /* EA 8.7.0 [UTM:002.1.2] GGR 30-JUN-2017 */
     Order By Ssbsect_Crn;   
   /*
   SELECT DISTINCT 
         SFRSTCR_GRDE_CODE_MID
        ,SFRSTCR_PIDM 
        ,SSBSECT_CRN
        ,SSBSECT_SUBJ_CODE
        ,SSBSECT_CRSE_NUMB
    FROM SSBSECT, SSRXLST, STVCAMP, STVSCHD, SORATRK, SZRATRK, SFRSTCR
   WHERE SSBSECT_TERM_CODE =  :pTerm
     AND SSBSECT_TERM_CODE  = SSRXLST_TERM_CODE  (+)
     AND SSBSECT_CRN        = SSRXLST_CRN        (+)
     AND SSBSECT_CAMP_CODE  =  STVCAMP_CODE
     AND STVSCHD_CODE       =  SSBSECT_SCHD_CODE
     AND SSBSECT_SUBJ_CODE  =  SORATRK_SUBJ_CODE (+)
     AND SSBSECT_CRSE_NUMB  =  SORATRK_CRSE_NUMB (+)
     AND SSBSECT_CRN        =  SORATRK_CRN       (+)
     AND SZRATRK_ATRK_SEQ_NO  =  SORATRK_SEQ_NO  (+)
     AND SSBSECT_CRN          =  SFRSTCR_CRN 
     AND SSBSECT_TERM_CODE    = SFRSTCR_TERM_CODE
     and SFRSTCR_CRN = :pCRN
     and (NVL(SFRSTCR_ERROR_FLAG,'N') <> 'F')
     AND (sfrstcr_error_flag not in ('F','D')
     or sfrstcr_error_flag is null
     or sfrstcr_rsts_code in (select stvrsts_code
                                from stvrsts
                               where stvrsts_code = sfrstcr_rsts_code
                                 and stvrsts_gradable_ind = 'Y'))
     order by SSBSECT_CRN; 
    */
    
   POSTORA;

   EXEC SQL 
  /*  EXEC SQL DECLARE GET_COREQ CURSOR FOR*/
       SELECT COUNT(*)
       INTO :lvCount
         FROM SCRCORQ
        WHERE (SCRCORQ_SUBJ_CODE= :pSubject
          AND SCRCORQ_CRSE_NUMB = :pCrseNumb) 
           OR (SCRCORQ_SUBJ_CODE_CORQ = :pSubject
          AND SCRCORQ_CRSE_NUMB_CORQ = :pCrseNumb);
    POSTORA;
 /*

      EXEC SQL
      OPEN GET_COREQ;
      FETCH GET_COREQ INTO :lvCount:vIndArr[0];
      POSTORA;
 
       EXEC SQL
      CLOSE GET_COREQ;
      POSTORA;
 */
 
    EXEC SQL 
       SELECT USER
       INTO :lvUser
         FROM DUAL;
    POSTORA;
    
    EXEC SQL
        SELECT USERENV('SESSIONID')
    INTO :sessionid
    FROM DUAL;
    POSTORA;
   


      EXEC SQL
       OPEN GET_STUDENTS;
      POSTORA;
      table(T_BEGIN, 5);
      setmode(M_CENTER);
      prtstr(TM_NLS_Get("0007","CRN"));
      newcol();
      setmode(M_CENTER);
      prtstr(TM_NLS_Get("0008","Matricula"));
      newcol();
      setmode(M_CENTER);
      prtstr(TM_NLS_Get("0009","Name-last name"));
      newcol();
      setmode(M_CENTER);
      prtstr(TM_NLS_Get("x","Message"));
      newcol();
      setmode(M_CENTER);
      prtstr(TM_NLS_Get("x","Level"));
      newcol();
      table(T_END);
      mc_SubHeader();     
      for (;;)
      {
        EXEC SQL
        FETCH GET_STUDENTS
         INTO :lvGradeCode:vIndArr[0],
              :lvPidm:vIndArr[1],
              :lvCrn:vIndArr[2],
              :lvSubj:vIndArr[3],
              :lvCrse:vIndArr[4],
              :lvLevel:vIndArr[5];
          POSTORA;

         #ifdef SCT_DEBUG
          tmprintf(&tmBundle,  TM_NLS_Get("x","\n  Start processing.\n") );
          tmprintf(&tmBundle, TM_NLS_Get("X", "lvGradeCode:{0} \n"), lvGradeCode);
          tmprintf(&tmBundle, TM_NLS_Get("X", "lvPidm:{0} \n"), lvPidm);
          tmprintf(&tmBundle, TM_NLS_Get("X", "lvCrn:{0} \n"), lvCrn);
          tmprintf(&tmBundle, TM_NLS_Get("X", "lvSubj:{0} \n"), lvSubj);
          tmprintf(&tmBundle, TM_NLS_Get("X", "lvCrse:{0} \n"), lvCrse);
          tmprintf(&tmBundle, TM_NLS_Get("X", "lvLevel:{0} \n"), lvLevel);
         #endif 
          
       if ( NO_ROWS_FOUND )
            break;
       else
       {
            add( vRowsRead, vRowsRead, _TMC("1") );
           
            EXEC SQL
            SELECT SUBSTR(SPRIDEN_FIRST_NAME||' '||SPRIDEN_LAST_NAME,1,27) as Nombre, SPRIDEN_ID
              INTO :lv_Name,
                   :lv_Id
              FROM SPRIDEN
             WHERE SPRIDEN_CHANGE_IND IS NULL
               AND SPRIDEN_PIDM = :lvPidm;
            POSTORA;
            
          if ( compare( lvCount, _TMC("0"), EQS ) )
          {
            
            #ifdef SCT_DEBUG
              tmprintf(&tmBundle,  TM_NLS_Get("x","\n  Hace llamada al pro*c Caso sin Co-req\n") );       
             #endif 
            
            /*mc_call_szrroll();*/
            
            add( vStuRecs, vStuRecs, _TMC( "1" ) );
            
             #ifdef SCT_DEBUG
              tmprintf(&tmBundle, TM_NLS_Get("x","\n  Termino procesamiento.\n") );
             #endif 
            tmstrcpy( lvMessg, _TMC("Rolled to academic history") );
            /*  tmstrcpy( lvLevel, _TMC("PR") ); */
            mc_Print(lvCrn, lv_Id, lv_Name, lvMessg, lvLevel);
            
            add( vRowsSuccess, vRowsSuccess, _TMC("1") );
            tmstrcpy( vErrMsg, _TMC("") );
    
          }
          else
          {
             #ifdef SCT_DEBUG
              tmprintf(&tmBundle,  TM_NLS_Get("x","\n  Hace llamada al pro*c Caso con Co-req \n") );       
             #endif 
            
            
               EXEC SQL
               /*   MKU    Changed        03/MAY/2016       8.7.0 [UTM:002.1.1]   */
               SELECT SUM(CASE SFRSTCR_GRDE_CODE WHEN NULL THEN 1 ELSE 0 END)
                 INTO :lvCountComp
                 FROM SSBSECT, SFRSTCR
                WHERE SSBSECT_TERM_CODE =  :pTerm
                  AND SSBSECT_CRN = SFRSTCR_CRN
                  AND SFRSTCR_PIDM = :lvPidm
                  AND SSBSECT_TERM_CODE    = SFRSTCR_TERM_CODE
                  AND (SSBSECT_CRSE_NUMB, SSBSECT_SUBJ_CODE) IN 
                        (SELECT CO.SCRCORQ_CRSE_NUMB_CORQ, CO.SCRCORQ_SUBJ_CODE_CORQ
                           FROM scrcorq co, ssbsect sb
                          WHERE SB.SSBSECT_CRSE_NUMB = CO.SCRCORQ_CRSE_NUMB
                            and SB.SSBSECT_SUBJ_CODE = CO.SCRCORQ_SUBJ_CODE
                            and SB.SSBSECT_TERM_CODE = :pTerm
                            and SB.SSBSECT_CRN LIKE NVL(:pCRN,'%') 
                            and SB.SSBSECT_CRSE_NUMB LIKE NVL(:pCrseNumb,'%')
                            and SB.SSBSECT_SUBJ_CODE LIKE NVL(:pSubject,'%')
                            and SB.SSBSECT_PTRM_CODE = SSBSECT_PTRM_CODE
                            AND co.scrcorq_eff_term =
                                 (SELECT MAX (scrcorq_eff_term)
                                    FROM scrcorq
                                   WHERE scrcorq_subj_code = co.scrcorq_subj_code
                                     AND scrcorq_crse_numb = co.scrcorq_crse_numb
                                     AND scrcorq_eff_term <= :pTerm)
                        ) 
                  and (NVL(SFRSTCR_ERROR_FLAG,'N') <> 'F')
                  /* BA 8.7.0 [UTM:002.1.2] GGR 30-JUN-2017 */
                  /*
                  AND (sfrstcr_error_flag not in ('F')
                  or sfrstcr_error_flag is null
                  or sfrstcr_rsts_code in (select stvrsts_code
                                             from stvrsts
                                            where stvrsts_code = sfrstcr_rsts_code
                                              and stvrsts_gradable_ind = 'Y'));
                  */
                  and sfrstcr_rsts_code in (select stvrsts_code
                                              from stvrsts
                                             where stvrsts_code = sfrstcr_rsts_code
                                               and stvrsts_gradable_ind = 'Y'
                                               and stvrsts_withdraw_ind = 'N' and stvrsts_code Not in ('BG','BM','DW','WL')
                                           );
                  /* EA 8.7.0 [UTM:002.1.2] GGR 30-JUN-2017 */
                                              
               /*
               SELECT SUM(CASE SFRSTCR_GRDE_CODE WHEN NULL THEN 1 ELSE 0 END)
                 INTO :lvCountComp
                 FROM SSBSECT, SFRSTCR
                WHERE SSBSECT_TERM_CODE =  :pTerm
                  AND SSBSECT_CRN = SFRSTCR_CRN
                  AND SFRSTCR_PIDM = :lvPidm
                  AND SSBSECT_TERM_CODE    = SFRSTCR_TERM_CODE
                  AND SSBSECT_SUBJ_CODE IN ( SELECT DISTINCT SCRCORQ_SUBJ_CODE
                                               FROM SCRCORQ
                                              WHERE (SCRCORQ_SUBJ_CODE= :pSubject
                                                AND SCRCORQ_CRSE_NUMB = :pCrseNumb) 
                                                 OR (SCRCORQ_SUBJ_CODE_CORQ = :pSubject
                                                AND SCRCORQ_CRSE_NUMB_CORQ = :pCrseNumb)
                                            )
                  AND SSBSECT_CRSE_NUMB IN ( SELECT DISTINCT SCRCORQ_CRSE_NUMB
                                               FROM SCRCORQ
                                              WHERE (SCRCORQ_SUBJ_CODE= :pSubject
                                                AND SCRCORQ_CRSE_NUMB = :pCrseNumb) 
                                                 OR (SCRCORQ_SUBJ_CODE_CORQ = :pSubject
                                                AND SCRCORQ_CRSE_NUMB_CORQ = :pCrseNumb)
                                           )
                  and (NVL(SFRSTCR_ERROR_FLAG,'N') <> 'F')
                  AND (sfrstcr_error_flag not in ('F','D')
                  or sfrstcr_error_flag is null
                  or sfrstcr_rsts_code in (select stvrsts_code
                                             from stvrsts
                                            where stvrsts_code = sfrstcr_rsts_code
                                              and stvrsts_gradable_ind = 'Y'));
                */                              
              POSTORA;
            
            if ( compare( lvCountComp, _TMC("0"), EQS ) ) 
            {
                    #ifdef SCT_DEBUG
                    tmprintf(&tmBundle,  TM_NLS_Get("x","\n Cumple que todas las materias tengan Calif \n") );       
                   #endif 
            
            
                   EXEC SQL
                   SELECT COUNT(DISTINCT(SFRSTCR_GRDE_CODE))
                     INTO :lvCountDiff
                     FROM SSBSECT, SFRSTCR
                    WHERE SSBSECT_TERM_CODE =  :pTerm
                      AND SSBSECT_CRN = SFRSTCR_CRN
                      AND SFRSTCR_PIDM = :lvPidm
                      AND SSBSECT_TERM_CODE    = SFRSTCR_TERM_CODE
                      AND (SSBSECT_CRSE_NUMB, SSBSECT_SUBJ_CODE) IN 
                        (SELECT CO.SCRCORQ_CRSE_NUMB_CORQ, CO.SCRCORQ_SUBJ_CODE_CORQ
                           FROM scrcorq co, ssbsect sb
                          WHERE SB.SSBSECT_CRSE_NUMB = CO.SCRCORQ_CRSE_NUMB
                            and SB.SSBSECT_SUBJ_CODE = CO.SCRCORQ_SUBJ_CODE
                            and SB.SSBSECT_TERM_CODE = :pTerm
                            and SB.SSBSECT_CRN LIKE NVL(:pCRN,'%') 
                            and SB.SSBSECT_CRSE_NUMB LIKE NVL(:pCrseNumb,'%')
                            and SB.SSBSECT_SUBJ_CODE LIKE NVL(:pSubject,'%')
                            and SB.SSBSECT_PTRM_CODE = SSBSECT_PTRM_CODE
                            AND co.scrcorq_eff_term =
                                 (SELECT MAX (scrcorq_eff_term)
                                    FROM scrcorq
                                   WHERE scrcorq_subj_code = co.scrcorq_subj_code
                                     AND scrcorq_crse_numb = co.scrcorq_crse_numb
                                     AND scrcorq_eff_term <= :pTerm)
                        )                       
                      and (NVL(SFRSTCR_ERROR_FLAG,'N') <> 'F')
                      /* BA 8.7.0 [UTM:002.1.2] GGR 30-JUN-2017 */
                      /*
                      AND (sfrstcr_error_flag not in ('F')
                            or sfrstcr_error_flag is null
                            or sfrstcr_rsts_code in (select stvrsts_code
                                                       from stvrsts
                                                      where stvrsts_code = sfrstcr_rsts_code
                                                        and stvrsts_gradable_ind = 'Y'));
                      */
                      and sfrstcr_rsts_code in (select stvrsts_code
                                                  from stvrsts
                                                 where stvrsts_code = sfrstcr_rsts_code
                                                   and stvrsts_gradable_ind = 'Y'
                                                   and stvrsts_withdraw_ind = 'N' and stvrsts_code Not in ('BG','BM','DW','WL')
                                               );
                      /* EA 8.7.0 [UTM:002.1.2] GGR 30-JUN-2017 */
                                                        
                   /*   MKU    Changed        03/MAY/2016       8.7.0 [UTM:002.1.1]   */
                   /*
                   SELECT COUNT(DISTINCT(SFRSTCR_GRDE_CODE))
                     INTO :lvCountDiff
                     FROM SSBSECT, SFRSTCR
                    WHERE SSBSECT_TERM_CODE =  :pTerm
                     AND SSBSECT_CRN = SFRSTCR_CRN
                       AND SFRSTCR_PIDM = :lvPidm
                      AND SSBSECT_TERM_CODE    = SFRSTCR_TERM_CODE
                        AND SSBSECT_SUBJ_CODE IN ( SELECT DISTINCT SCRCORQ_SUBJ_CODE
                                                    FROM SCRCORQ
                                                  WHERE (SCRCORQ_SUBJ_CODE= :pSubject
                                                    AND SCRCORQ_CRSE_NUMB = :pCrseNumb) 
                                                       OR (SCRCORQ_SUBJ_CODE_CORQ = :pSubject
                                                   AND SCRCORQ_CRSE_NUMB_CORQ = :pCrseNumb)
                                                 )
                       AND SSBSECT_CRSE_NUMB IN ( SELECT DISTINCT SCRCORQ_CRSE_NUMB
                                                   FROM SCRCORQ
                                                  WHERE (SCRCORQ_SUBJ_CODE= :pSubject
                                                   AND SCRCORQ_CRSE_NUMB = :pCrseNumb) 
                                                    OR (SCRCORQ_SUBJ_CODE_CORQ = :pSubject
                                                    AND SCRCORQ_CRSE_NUMB_CORQ = :pCrseNumb)
                                                 )
                       and (NVL(SFRSTCR_ERROR_FLAG,'N') <> 'F')
                       AND (sfrstcr_error_flag not in ('F','D')
                       or sfrstcr_error_flag is null
                      or sfrstcr_rsts_code in (select stvrsts_code
                                                 from stvrsts
                                                where stvrsts_code = sfrstcr_rsts_code
                                                    and stvrsts_gradable_ind = 'Y'));
                     */
                     
                     POSTORA;
                
                if ( compare( lvCountDiff, _TMC("1"), EQS ) ) 
                {
                    
                    #ifdef SCT_DEBUG
                    tmprintf(&tmBundle,  TM_NLS_Get("x","\n Cumple que todas las materias tengan la misma Calif \n") );       
                   #endif 
            
                    /*mc_call_szrroll();*/
                    
                    add( vStuRecs, vStuRecs, _TMC( "1" ) );
                    
                   #ifdef SCT_DEBUG
                    tmprintf(&tmBundle, TM_NLS_Get("x","\n  Termino procesamiento de Co-requisito.\n") );
                   #endif
                   
                   tmstrcpy( lvMessg, _TMC("Rolled to academic history CR") );
                   /*  tmstrcpy( lvLevel, _TMC("PR") );   */
                   mc_Print( lvCrn, lv_Id, lv_Name, lvMessg, lvLevel);
            
                   add( vRowsSuccess, vRowsSuccess, _TMC("1") );
                   tmstrcpy( vErrMsg, _TMC("") );
                                
                }
                else
                {
                   #ifdef SCT_DEBUG
                   tmprintf(&tmBundle, TM_NLS_Get("x","\n Different correquisite grades \n") );
                   #endif 
                   
                   tmstrcpy( lvMessg, _TMC("Different correquisite grades") );
                   /*  tmstrcpy( lvLevel, _TMC("PR") );  */
                   add( vRowsError, vRowsError, _TMC("1") );
                   
                   mc_Print( lvCrn, lv_Id, lv_Name, lvMessg, lvLevel);

                }
                
            }
            else
            {
             #ifdef SCT_DEBUG
              tmprintf(&tmBundle, TM_NLS_Get("x","\n Correquisite grade missing \n") );
             #endif
             
             tmstrcpy( lvMessg, _TMC("Correquisite grade missing") );
             add( vRowsError, vRowsError, _TMC("1") );
             /*  tmstrcpy( lvLevel, _TMC("PR") );  */
             mc_Print( lvCrn, lv_Id, lv_Name, lvMessg, lvLevel);
             
            }            
    
          }
    
      }

    }
    
    tmstrcpy( pPrintSel, _TMC("A") );
 
        EXEC SQL
        INSERT INTO SPRCOLR /*BIEN*/
          (sprcolr_sessionid, sprcolr_type, sprcolr_value_date,
           sprcolr_value_atyp, sprcolr_activity_date,
           sprcolr_job, sprcolr_parm_number) 
        VALUES (:sessionid,'','',:pCRN,SYSDATE,UPPER('SZRROLL'),
                '05');
        POSTORA;
 
 
        EXEC SQL
        INSERT INTO SPRCOLR /*BIEN*/
          (sprcolr_sessionid, sprcolr_type, sprcolr_value_date,
           sprcolr_value_atyp, sprcolr_activity_date,
           sprcolr_job, sprcolr_parm_number) 
        VALUES (:sessionid,'','','%',SYSDATE,UPPER('SZRROLL'),
                '04');
        POSTORA;

        
        EXEC SQL
        INSERT INTO SPRCOLR /*BIEN*/
          (sprcolr_sessionid, sprcolr_type, sprcolr_value_date,
           sprcolr_value_atyp, sprcolr_activity_date,
           sprcolr_job, sprcolr_parm_number) 
        VALUES (:sessionid,'','',:lvLevel,SYSDATE,UPPER('SZRROLL'),
                '11');
        POSTORA;

    
    #ifdef SCT_DEBUG
        tmprintf(&tmBundle, TM_NLS_Get("X", "    Executing procedure \n"));
        tmprintf(&tmBundle, TM_NLS_Get("X", "       pTerm:{0} \n"), pTerm);
        tmprintf(&tmBundle, TM_NLS_Get("X", "       sessionid:{0} \n"), sessionid);
        tmprintf(&tmBundle, TM_NLS_Get("X", "       lvLevel:{0} \n"), lvLevel);
        tmprintf(&tmBundle, TM_NLS_Get("X", "       pCRN:{0} \n"), pCRN);
        tmprintf(&tmBundle, TM_NLS_Get("X", "       Mode:{0} \n"), pReportMode);
        tmprintf(&tmBundle, TM_NLS_Get("X", "       Selection:{0} \n"), pPrintSel);
        tmprintf(&tmBundle, TM_NLS_Get("X", "       User:{0} \n"), lvUser);
    #endif 
    
    EXEC SQL EXECUTE
    BEGIN

        szkrols.p_do_graderoll(:pTerm, /*BIEN*/
                               null,
                               :lvUser,
                               :sessionid,
                               :pPrintSel,
                               :pReportMode,
                               NULL,
                               NULL,
                               NULL,
                               'Y',
                               null,
                               NULL
                               );    
      END;
    END-EXEC;
    POSTORA;
    
    
    EXEC SQL
        DELETE FROM SPRCOLR WHERE sprcolr_sessionid = :sessionid;
    POSTORA;  
    
     
    mc_SubHeader();
    /* mc_ProcessCrn();*/
        
    EXEC SQL
        CLOSE GET_STUDENTS;
    POSTORA;

    if ( tmatoi( vRowsRead ) == 0 )
    {
        prtstr(_TMC("No records were found with the requested parameters."));
    }

    if ( tmatoi( vStuRecs ) == 0 )
        prtstr( TM_NLS_Get("0003", "No students were processed." ) );
    else
    {
        deleteFile();
    /*
    mc_moveoutput(_TMC("szrroll.lis"));
    mc_moveoutput(_TMC("szrroll.log"));
    */
    }
 /* 
  if (!tmstrcmp(pReportMode,_TMC("A"))) 
     { EXEC SQL EXECUTE BEGIN ROLLBACK; END; END-EXEC; POSTORA; 
     
     }   
  else  
     {  
         EXEC SQL EXECUTE BEGIN COMMIT; END; END-EXEC; POSTORA;
     }*/

  /*return EXIT_SUCCESS;*/

    if (!tmstrcmp(pReportMode,_TMC("A"))) 
     { EXEC SQL EXECUTE BEGIN gb_common.p_rollback(NULL); END; END-EXEC; POSTORA; } /*BIEN*/
    

    EXEC SQL EXECUTE BEGIN gb_common.p_commit(NULL); END; END-EXEC; POSTORA; /*BIEN*/
   /* exit2os(EXIT_SUCCESS); */

 /* return EXIT_SUCCESS;  */

}

static void mc_moveoutput(TMCHAR *type)
{
  /* Identify the proper path, where .ext file will be stored, according to Operating System */
  #if OPSYS == OS_UNIX
    tmsprintf(&tmBundle, vPathJobSub, _TMC("mv {0} {1}"), type, (TMCHAR *) tmgetenv( _TMC("HOME") ) );
  #elif OPSYS == OS_VMS
    tmsprintf(&tmBundle, vPathJobSub, _TMC("rename {0} {1}"), type, (TMCHAR *) tmgetenv( _TMC("FIN$LOADER") ) );
  #else
    tmsprintf(&tmBundle, vPathJobSub, _TMC("move {0} {1}"), type, (TMCHAR *) tmgetenv( _TMC("BANNER_HOME") ) );
  #endif

  #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","\n\nMOVE *.LIS, *.LOG using: {0} \n"), vPathJobSub);
  #endif
  tmsystem( vPathJobSub );
}

static void mc_call_szrroll(void)
{
   /* Filling  default data */
   tmstrcpy(lv_enterKey,     _TMC(""));
   tmstrcpy(lv_szrroll,     _TMC("SZRROLL"));
   
   /*Initializes Variables */
   tmstrcpy(szrroll_From_Date, _TMC("01-JUN-1990"));
   tmstrcpy(szrroll_To_Date, _TMC("01-JUN-2016"));
   tmstrcpy(szrroll_Part_Term, _TMC("%"));
   tmstrcpy(szrroll_User, _TMC("TESTE"));
   tmstrcpy(szrroll_Mode, _TMC("A"));
   tmstrcpy(szrroll_Selection, _TMC("A"));
   tmstrcpy(szrroll_Grade_Term, _TMC("%"));
   tmstrcpy(szrroll_Roll_Long, _TMC("N"));
   tmstrcpy(szrroll_Level, _TMC("%"));
   tmstrcpy(szrroll_Campus, _TMC(""));
   
   /* First  Delete file */
   deleteFile();

   /* Opening File */
   openFile(lv_szrroll);
   /* Filling data */
   
   #ifdef SCT_DEBUG
   tmprintf(&tmBundle, TM_NLS_Get("X", "Term:{0} \n"), pTerm);
   tmprintf(&tmBundle, TM_NLS_Get("X", "From_Date:{0} \n"), szrroll_From_Date);
   tmprintf(&tmBundle, TM_NLS_Get("X", "To_Date:{0} \n"), szrroll_To_Date);
   tmprintf(&tmBundle, TM_NLS_Get("X", "Part_Term:{0} \n"), szrroll_Part_Term);
   tmprintf(&tmBundle, TM_NLS_Get("X", "CRN:{0} \n"), pCRN);
   tmprintf(&tmBundle, TM_NLS_Get("X", "User:{0} \n"), szrroll_User);
   tmprintf(&tmBundle, TM_NLS_Get("X", "Mode:{0} \n"), szrroll_Mode);
   tmprintf(&tmBundle, TM_NLS_Get("X", "Selection:{0} \n"), szrroll_Selection);
   tmprintf(&tmBundle, TM_NLS_Get("X", "Grade_Term:{0} \n"), szrroll_Grade_Term);
   tmprintf(&tmBundle, TM_NLS_Get("X", "Roll_Long:{0} \n"), szrroll_Roll_Long);
   #endif
   
   
   printLineElement(tmtochar8(pTerm));
   printLineElement(tmtochar8(szrroll_From_Date));
   printLineElement(tmtochar8(szrroll_To_Date));
   printLineElement(tmtochar8(szrroll_Part_Term));
   printLineElement(tmtochar8(pCRN));
   printLineElement(tmtochar8(szrroll_User));
   printLineElement(tmtochar8(szrroll_Mode));
   printLineElement(tmtochar8(szrroll_Selection));
   printLineElement(tmtochar8(szrroll_Grade_Term));
   printLineElement(tmtochar8(szrroll_Roll_Long));
   printLineElement(tmtochar8(szrroll_Level));
   printLineElement(tmtochar8(szrroll_Campus));
   
   /*
   printLineElement(tmtochar8(pTerm));
   printJustLineElement();
   printJustLineElement();
   printLineElement(tmtochar8(szrroll_Part_Term));
   printLineElement(tmtochar8(pCRN));
   printLineElement(tmtochar8(szrroll_User));
   printLineElement(tmtochar8(szrroll_Mode));
   printLineElement(tmtochar8(szrroll_Selection));
   printJustLineElement();
   printLineElement(tmtochar8(szrroll_Roll_Long)); */
   
   /* Closing the file to be called from tmsystem function */
   closeFile();

   /* Defining ProC to be called */
   tmstrcpy(lv_sys_cmd, _TMC(""));
   /*tmstrcat(lv_sys_cmd, lv_tvrappl);*/
   tmstrcat(lv_sys_cmd, _TMC("szrroll"));
   tmstrcat(lv_sys_cmd, _TMC(" "));
   tmstrcat(lv_sys_cmd, user_pass);
   tmstrcat(lv_sys_cmd, _TMC("<"));
   tmstrcat(lv_sys_cmd, strOutFile.fname);

   #ifdef SCT_DEBUG
       tmprintf(&tmBundle, _TMC("{0}"), lv_sys_cmd);
   #endif

   tmsystem(lv_sys_cmd);
}

/*****************************************************************************/
/* mc_FileName                                                               */
/*****************************************************************************/
/* Get the File name                                                         */
/*****************************************************************************/
static void mc_FileName(TMCHAR *fName)
{
  EXEC SQL BEGIN DECLARE SECTION;
    static TMCHAR tfname[20] = {0};

  EXEC SQL END DECLARE SECTION;

  EXEC SQL
    SELECT
           TO_CHAR(SYSDATE, 'DDMMYY_') || ROUND(DBMS_RANDOM.VALUE() * 500)
      INTO :tfname:vIndArr[0]
      FROM DUAL;
  POSTORA;

  /*tmstrcpy(prFileName, vRptName);*/
  tmstrcpy(prFileName, fName);
  tmstrcat(prFileName, tfname);
}

/*****************************************************************************/
/* openFile                                                                  */
/*****************************************************************************/
/* This one just creates the files with the prFileName value                 */
/*****************************************************************************/
static void openFile(TMCHAR *fName)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, _TMC("OpenFileExt().\n"));
  #endif

  /* Default extension for output file */
   tmstrcpy(default_ext, _TMC("txt"));
   mc_FileName( fName );

  /* Identify the proper path, where .ext file will be stored, according to Operating System */
  #if OPSYS == OS_UNIX
    tmsprintf(&tmBundle, pvFileName, _TMC("{0}/{1}"), (TMCHAR *) tmgetenv( _TMC("HOME") ), prFileName );
  #elif OPSYS == OS_VMS
    tmsprintf(&tmBundle, pvFileName, _TMC("{0}:{1}"), (TMCHAR *) tmgetenv( _TMC("FIN$LOADER") ), prFileName );
  #else
    tmsprintf(&tmBundle, pvFileName, _TMC("{0}\\{1}\\{2}"),(TMCHAR *) tmgetenv( _TMC("BANNER_HOME") ), _TMC("jobsub"), prFileName);
  #endif

  /* Initialize the output file */
  initfn(&strOutFile);

    #ifdef SCT_DEBUG
        tmprintf(&tmBundle, TM_NLS_Get("X", "HOME sub {0}"), pvFileName);
    #endif

  if ( tmstrlen(prFileName) > 0 )  /* If user specified the output file */
  {
    tmstrcpy(strOutFile.fname, pvFileName);
    parsfn(&strOutFile);

    /* Use default extension if user did not specify one */
    if ( !*strOutFile.ext )
    {
      _setFile(&strOutFile, NULL, NULL, default_ext, NULL);
    }
  }
  else  /* If user did not specify an output file, use the name of the executable with the default extension */
  {
    _setFile(&strOutFile, NULL, prFileName, default_ext, NULL);
  }

  #ifdef SCT_DEBUG
    tmprintf(&tmBundle, _TMC("{0}\n"), strOutFile.fname);
  #endif

  /* convert strOutFile.fname from UTF8 so fopen can be used instead of tmfopen*/
  tmstrcpy8(extfname, tmtochar8(strOutFile.fname));

  /* If output file cannot be created and opened in Write mode, then show error message */
  if ( ( pvPointerFileExt = fopen(extfname,"w" ) ) == NULL )
  {
    #ifdef SCT_DEBUG
      tmprintf(&tmBundle, TM_NLS_Get("X", "*ERROR* The file '{0}' cannot be created into the jobsub directory.\n"), strOutFile.fname);
    #endif

    exit2os( EXIT_FAILURE );
   }
 }

/*****************************************************************************/
/* closeFile                                                                 */
/*****************************************************************************/
/* This one just close the file  opened                                      */
/*****************************************************************************/
 static void closeFile(void)
 {
   #ifdef SCT_DEBUG
     tmprintf(&tmBundle, _TMC("CloseFile().\n"));
   #endif

   fclose(pvPointerFileExt);
 }
 
/*****************************************************************************/
/* deleteFile                                                                */
/*****************************************************************************/
/* We need to delete it, due to we do not need it                            */
/*****************************************************************************/
 static void deleteFile(void){
   if(*strOutFile.fname){

     #ifdef SCT_DEBUG
          tmprintf(&tmBundle, _TMC("Deleting file.\n"));
     #endif
     remove(tmtochar8(strOutFile.fname) );
   }
 }

 /*****************************************************************************/
/* printLineElement                                                          */
/*****************************************************************************/
/* This funtion will print the value  passed                                 */
/*****************************************************************************/
 static void printLineElement(char *value)
 {

   #if OPSYS == OS_UNIX
      fprintf(pvPointerFileExt, "%s\n", value);  /* print row with carriage return and line feed */
    #elif OPSYS == OS_VMS
      fprintf(pvPointerFileExt, "%s\r\n", value);/* print row with carriage return and line feed */
    #else
      fprintf(pvPointerFileExt, "%s\n", value);  /* print row with carriage return and line feed */
    #endif
 }

/*****************************************************************************/
/* printJustLineElement                                                      */
/*****************************************************************************/
/* This funtion will print a line                                            */
/*****************************************************************************/
static void printJustLineElement(void)
{
   #if OPSYS == OS_UNIX
      fprintf(pvPointerFileExt, "\n");   /* print row with carriage return and line feed */
    #elif OPSYS == OS_VMS
      fprintf(pvPointerFileExt, "\r\n");  /* print row with carriage return and line feed */
    #else
      fprintf(pvPointerFileExt, "\n");  /* print row with carriage return and line feed */
    #endif

}

/*****************************************************************************/
/* _setFile                                                                  */
/*****************************************************************************/
/* This propeties of the file                                                */
/*****************************************************************************/
TMCHAR *_setFile(FNSTRUC *strFile, TMCHAR *dir, TMCHAR *name, TMCHAR *ext, TMCHAR *vers)
{
  if ( dir )
    tmstrcpy((*strFile).dir, dir);

  if ( name )
    tmstrcpy((*strFile).name, name);

  if ( ext )
    tmstrcpy((*strFile).ext, ext);

  if ( vers )
    tmstrcpy((*strFile).vers, vers);

  makefn(strFile);

  return (*strFile).fname;
}



/*****************************************************************************/
/*        Routine to process layout if the parameter was entered.            */
/*****************************************************************************/

static void mc_ProcessFile( void )
{
  EXEC SQL BEGIN DECLARE SECTION;
    static TMCHAR lv_msg[100]           = {0};
    static TMCHAR tRecordTypeValue[16]  = {0};
  EXEC SQL END DECLARE SECTION;

  #ifdef SCT_DEBUG
     tmprintf(&tmBundle,  TM_NLS_Get("x","Executing function mc_ProcessFile.\n") );
  #endif

  tmstrcpy(lv_msg, TM_NLS_Get("x","(Define in GTVSDAX form the value to the file path for FILE_DIR)"));
  EXEC SQL
     EXECUTE
        DECLARE
           description   gtvsdax.gtvsdax_internal_code%TYPE;

           CURSOR get_gtvsdax_desc_c(l_internal_code VARCHAR2,
                                     l_group_code    VARCHAR2) IS
           SELECT gtvsdax_comments
             FROM gtvsdax
            WHERE gtvsdax_internal_code       = l_internal_code
              AND gtvsdax_internal_code_group = l_group_code;

           BEGIN
              OPEN get_gtvsdax_desc_c('FILE_DIR', 'UTM002');
              FETCH get_gtvsdax_desc_c INTO :pvFilePath;
              CLOSE get_gtvsdax_desc_c;
              IF (:pvFilePath IS NULL or :pvFilePath = 'UPDATEME') THEN
                  :pvFilePath := :lv_msg;
              END IF;
       END;
  END-EXEC;
  POSTORA;

 #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: UTM002: [{0}]\n"), pvFilePath );
  #endif

  if ( !tmstrcmp( pvFilePath, lv_msg ) )
  {
    tmprintf(&tmBundle, _TMC("{0}\n"),pvFilePath );
    prtstr( lv_msg );
  }
  else
  {
     #if OPSYS==OS_UNIX
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}/{1}"),
                 pvFilePath,  pFileName );
     #else
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}\\{1}"),
                 pvFilePath,  pFileName );
     #endif

    mc_OpenFile();
    mc_ReadFileLines();
    mc_CloseFile();
  }
}

/******************************************************************************/
/*                   Routine to open the file to process                      */
/******************************************************************************/
static int mc_OpenFile(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: Full name of the file: [{0}]\n"), pvFileFullName );
  #endif

  if ( ( vFile = tmfopen(&tmBundle,  pvFileFullName, _TMC("r") ) ) == NULL )
  {
    tmprintf(&tmBundle,  TM_NLS_Get("x","{0} gender error Input/Output\n"), pvFileFullName );
    exit2os( EXIT_FAILURE );
  }
  return 0;
}


/******************************************************************************/
/*                   Routine to Read Lines of the File                        */
/******************************************************************************/

static int mc_ReadFileLines(void)
{

  int i, j, k;
  int cont;
  char separador;

  TMCHAR MiniCad[21];
  EXEC SQL BEGIN DECLARE SECTION;
      static TMCHAR   lv_msg[100] = {0};
  EXEC SQL END DECLARE SECTION;

  i = j = k = 0;
  cont = 0;
  tmstrcpy( vRecRead,    _TMC("0") );
  tmstrcpy( vRecIgnored, _TMC("0") );
  tmstrcpy( vRecInserted,_TMC("0") );

  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ReadFileLines.\n"));
  #endif


  tmstrcpy(lv_msg, TM_NLS_Get("x","(Define in GTVSDAX form the value to the file separator character for DELIMITADO)"));
  EXEC SQL
     EXECUTE
       BEGIN
           :vCharSeparator := gokeacc.f_getgtvsdaxextcode ('DELIMITADO', 'UTM002'); /*BIEN*/
           IF (:vCharSeparator IS NULL or :vCharSeparator = 'UPDATEME') THEN
             :vCharSeparator := :lv_msg;
           ELSE
             :vDummy := LENGTH(:vCharSeparator);
           END IF;
       END;
     END-EXEC;
  POSTORA;
  
  #ifdef SCT_DEBUG
        tmprintf(&tmBundle,  TM_NLS_Get("x","               DEBUG: vCharSeparator [{0}] \n"), vCharSeparator);
  #endif  

  if ( !tmstrcmp( vCharSeparator, lv_msg ) )
  {
    tmprintf(&tmBundle, _TMC("{0}\n"), vCharSeparator );
    prtstr( lv_msg );
  }
  else
  {
     separador = *vCharSeparator;
     /*tmstrcpy(rpt_record_num,_TMC("0"));*/
     
     do {
        tmstrcpy(vFileLine,_TMC(""));
        tmfgets(vFileLine, 410, vFile);
        /*vFileLine[12] = '\0';*/
        
        if ( tmstrcmp( vFileLine, _TMC("") ) )
        {
          add( vRecRead, vRecRead, _TMC("1") );

          tmstrcpy( lvTerm,  _TMC("") );
          tmstrcpy( lvCrn,   _TMC("") );
          tmstrcpy( lvSbj,   _TMC("") );
          tmstrcpy( lvCrse,   _TMC("") );

          #ifdef SCT_DEBUG
              tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: vFileLine [{0}] \n"), vFileLine);
          #endif

          for( i = 0; vFileLine[i] != '\0'; i++)
          {
            if ( k >= 3 ) break;
            tmstrcpy( MiniCad, _TMC("") );
            j = 0;
                      
            while ( ( vFileLine[i+1] != '\0' ) && ( vFileLine[i] != separador ) && (cont <= 13) )           
            {       
              cont++;   
              if ( vFileLine[i] > 31 && vFileLine[i] < 255 )
                MiniCad[j++] = vFileLine[i++];
            }
             #ifdef SCT_DEBUG
               tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: SALIENDO DEL WHILE \n"));
             #endif
            MiniCad[j] = '\0';
            k++;

            switch (k)
            {
              case  1: tmstrcpy( lvTerm, MiniCad ); break;
              case  2: tmstrcpy( lvCrn,  MiniCad ); break;
            }

          }
          #ifdef SCT_DEBUG        
              tmprintf(&tmBundle,  TM_NLS_Get("x","        DEBUG: lvTerm -> {0} \n"),lvTerm);
              tmprintf(&tmBundle,  TM_NLS_Get("x","        DEBUG: lvCrn -> {0} \n"),lvCrn);
          #endif
          if ( *lvTerm   &&  
               *lvCrn     )
          {
              
              tmstrcpy( pTerm, lvTerm );    
              tmstrcpy( pCRN, lvCrn );   
              
                 EXEC SQL 
                    /*   MKU    Changed     03/MAY/2016       8.7.0 [UTM:002.1.1]   */
                        SELECT SSBSECT_SUBJ_CODE,
                               SSBSECT_CRSE_NUMB
                          INTO  :lvSbj,
                                :lvCrse
                          FROM SSBSECT
                         WHERE SSBSECT_TERM_CODE =  :pTerm
                           AND SSBSECT_CRN        = :pCRN;  
                    /*
                     SELECT DISTINCT  SSBSECT_SUBJ_CODE
                           ,SSBSECT_CRSE_NUMB
                    INTO  :lvSbj
                        ,:lvCrse
                       FROM SSBSECT, SSRXLST, STVCAMP, STVSCHD, SORATRK, SZRATRK, SFRSTCR
                      WHERE SSBSECT_TERM_CODE =  :pTerm
                        AND SSBSECT_TERM_CODE  = SSRXLST_TERM_CODE  (+)
                        AND SSBSECT_CRN        = SSRXLST_CRN        (+)
                        AND SSBSECT_CAMP_CODE  =  STVCAMP_CODE
                        AND STVSCHD_CODE       =  SSBSECT_SCHD_CODE
                        AND SSBSECT_SUBJ_CODE  =  SORATRK_SUBJ_CODE (+)
                        AND SSBSECT_CRSE_NUMB  =  SORATRK_CRSE_NUMB (+)
                        AND SSBSECT_CRN        =  SORATRK_CRN       (+)
                        AND SZRATRK_ATRK_SEQ_NO  =  SORATRK_SEQ_NO  (+)
                        AND SSBSECT_CRN          =  SFRSTCR_CRN 
                        AND SSBSECT_TERM_CODE    = SFRSTCR_TERM_CODE
                        AND SFRSTCR_CRN          = :pCRN
                        and (NVL(SFRSTCR_ERROR_FLAG,'N') <> 'F')
                        AND (sfrstcr_error_flag not in ('F','D')
                        or sfrstcr_error_flag is null
                        or sfrstcr_rsts_code in (select stvrsts_code
                                                        from stvrsts
                                                       where stvrsts_code = sfrstcr_rsts_code
                                                         and stvrsts_gradable_ind = 'Y'));  
                        */
                        
                        POSTORA;
                  
               tmstrcpy( pSubject, lvSbj );    
               tmstrcpy( pCrseNumb, lvCrse );   
            
            mc_MainProcess();           
          }
          else
          {
            add( vRecIgnored, vRecIgnored, _TMC("1") );
          }

          k = 0;
          cont = 0;
        }

      } while ( tmstrcmp( vFileLine, _TMC("") ) );
      
  }
  return 0;
}


/******************************************************************************/
/*                   Routine to close the file                                */
/******************************************************************************/

static int  mc_CloseFile( void )
{
  tmfclose( vFile );
  return 0;
}

/*****************************************************************************/
