/*****************************************************************************/
/*                                                                           */
/* MAIN                                                                      */
/*                                                                           */
/*****************************************************************************/
int main ( int argc, TMCHAR *argv[] )
{
  rptopen( user_pass, argc, argv );
  login();
// BA LMR 16-12-2024 [MOD:02.2.0]
  //tmstrcpy( vVersion, _TMC("8.7.0 [UTM:002.1.0]") );
  tmstrcpy( vVersion, _TMC("8.31.2 [MOD:02.2.0]") );
// EA LMR 16-12-2024 [MOD:02.2.0]
  tmstrcpy( vRptName, _TMC("SZPAMEC") );

  tmprintf(&tmBundle,  TM_NLS_Get("X", "Iniciando {0} (Version: {1})\n\n"), vRptName, vVersion );

  /* Tables definition */
  table(T_DEFINE, 1, 1, 180, NULL);
  table(T_DEFINE, 2, 1, 11, 13, 160, 162,180, NULL);
  table(T_DEFINE, 3, 1, 30, 32, 180, NULL);
  table(T_DEFINE, 4, 1, 3, 5, 9, 11, 17, 19, 23, 25, 54, 56, 61, 63, 82, 84, 180, NULL);

  pgformat(1,66);

  input( vRptOneUpNo, TM_NLS_Get("X", "Numero de Secuencia de Ejecucion:"), 26, NUM );
  if( *vRptOneUpNo ) mc_ValidateOneUpNo();

  mc_RetrieveParms();
  mc_CheckParms();
  mc_GetInstitution();
  mc_GetTitle();
  mc_GetToday();

  table(T_BEGIN, 1);
  mc_Header();

  mc_ProcessFile();
  
  /* Process Data. */
  mc_MainProcess();

  mc_ControlReport();
 
  EXEC SQL
    DELETE SZTVSCH
     WHERE SZTVSCH_SESSIONID = SYS_CONTEXT ('USERENV', 'SESSIONID');
  POSTORA;



  EXEC SQL
    COMMIT;
  POSTORA;

  exit2os( EXIT_SUCCESS );
  return EXIT_SUCCESS;
}

