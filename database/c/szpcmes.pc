  static TMCHAR  pvFileFullName[128];                        /* State File name        */

  static TMCHAR  vCharSeparator[128];                        /* Character separator    */
  static TMCHAR  vDateFormat[128];                           /* Date Format separator    */
  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecRead,27,_TMC("0"));
  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecInserted,27,_TMC("0"));
  static NUMSTR  TMCHARRYT_GLOB_DCL(vRecIgnored,27,_TMC("0"));
  
  static BANNUMSTR(rpt_record_num)    = {0};   /*TMCI18N CHANGED FROM ""*/
  static BANNUMSTR(lvScheme)          = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvTerm[7]            = {0};   /*TMCI18N CHANGED FROM ""*/
  static TMCHAR  lvPTerm[4]           = {0};
  static TMCHAR  lvGrade[11]          = {0};
  static TMCHAR  lvNonD[4]            = {0};
  static TMCHAR  lvSeqNo[4]           = {0};
  static TMCHAR  lvAcat[11]           = {0};
  static BANNUMSTR(lvWeight)          = {0};
  static TMCHAR  lvInclude[3]         = {0};
  static TMCHAR  lvDeliver[3]         = {0};
  static TMCHAR  lvStart[12]          = {0};
  static TMCHAR  lvDue[12]            = {0};
  static TMCHAR  lvRestrict[3]        = {0};
  static BANNUMSTR(lvScore)           = {0};
