  static TMCHAR vDummy[31]            = {0};
  static TMCHAR vVersion[30]          = {0};
  static TMCHAR vRptName[10]          = {0};

  static NUMSTR TMCHARRYT_GLOB_DCL(vRowsError,27,_TMC("0"));
  static NUMSTR TMCHARRYT_GLOB_DCL(vRowsSuccess,27,_TMC("0"));
  static NUMSTR TMCHARRYT_GLOB_DCL(vRowsRead,27,_TMC("0"));	/*  MKU  Added    27/Apr/2016  */

  /* Report Output Variables */
  static TMCHAR vNow[40]              = {0};
  static NUMSTR TMCHARRYT_GLOB_DCL(vPageNum,27,_TMC("1"));
  static NUMSTR TMCHARRYT_GLOB_DCL(vCurrLine,27,_TMC("0"));
  static TMCHAR vInstitution[31]      = {0};
  static TMCHAR vRptTitle[31]         = {0};

  /* Parameter Variables */
  static TMCHAR pFileHeader[128]   = {0};                 /* State File name        */
  static TMCHAR pFileActivity[128] = {0};                 /* State File name        */
  static TMCHAR pReportMode[2]     = {0};                    /*  Required     */

  /* Process Variables */
  static UFILE   *vFile;                                     /* File Pointer var       */
