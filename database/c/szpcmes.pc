/*****************************************************************************/
/*                                                                           */
/* MAIN                                                                      */
/*                                                                           */
/*****************************************************************************/
int main ( int argc, TMCHAR *argv[] )
{
  rptopen( user_pass, argc, argv );
  login();

// BA LMR 16-12-2024 [MOD:02.2.0]
  //tmstrcpy( vVersion, _TMC("8.7.0 [UTM:002.1.6]") );
  tmstrcpy( vVersion, _TMC("8.31.2 [MOD:02.2.0]") );
// EA LMR 16-12-2024 [MOD:02.2.0]
  tmstrcpy( vRptName, _TMC("SZPCMES") );

  tmprintf(&tmBundle,  TM_NLS_Get("X", "Iniciando {0} (Version: {1})\n\n"), vRptName, vVersion );

  /* Tables definition 
SCHEME    SEC ACTIVITY   MESSAGE
--------- --- ---------- ------------------------------------------------------------
999999999 999 xxxxxxxxxx xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
*/
  table(T_DEFINE, 1, 1, 132, NULL);
  table(T_DEFINE, 2, 1, 11, 13, 78, 80, 132, NULL);
  table(T_DEFINE, 3, 1, 13, 15, 132, NULL);
  table(T_DEFINE, 4, 1, 9, 11, 13, 15, 24, 26, 85,  NULL);

  pgformat(1,66);

  input( vRptOneUpNo, TM_NLS_Get("X", "Numero de Secuencia de Ejecucion:"), 26, NUM );
  if( *vRptOneUpNo ) mc_ValidateOneUpNo();

  mc_RetrieveParms();
  mc_CheckParms();
  mc_GetInstitution();
  mc_GetTitle();
  mc_GetToday();

  table(T_BEGIN, 1);
  mc_Header();
  mc_SubHeader();

  /*
    If not file was given then let's try to process file,
    otherwise process by parameters.
  */
  tmstrcpy( vRecRead,    _TMC("0") );
  tmstrcpy( vRecIgnored, _TMC("0") );
  tmstrcpy( vRecInserted,_TMC("0") );

  if (*pFileHeader && *pFileActivity){
    mc_ProcessFile(pFileHeader, _TMC("H"));
    mc_ProcessFile(pFileActivity, _TMC("A"));
    mc_PostProcessCheck();				/*   MKU  Added    27/Apr/2016  */
    mc_MainProcess();					/*   MKU  Added    27/Apr/2016  */
    
    
  }
  
  if ( compare( pReportMode, _TMC("U"), EQS) ) {
     EXEC SQL
        DELETE Sztlsch Tc
         Where Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');
     POSTORA;
     
     EXEC SQL
      COMMIT;
     POSTORA;
  }
  else 
  {
     EXEC SQL
     ROLLBACK;
     POSTORA;
  }

  
  mc_ControlReport();

  exit2os( EXIT_SUCCESS );
  return EXIT_SUCCESS;
}


/*  BA  MKU  Added    27/Apr/2016  */
static void mc_MainProcess(void)
{
      #ifdef SCT_DEBUG
        tmprintf(&tmBundle, TM_NLS_Get("x", "Executing mc_MainProcess.\n"));
      #endif
	  	  
      /* PRINTIG DATA */ 
      EXEC SQL
      DECLARE Sztlsch_C CURSOR FOR
         Select Tc.Sztlsch_Schm_Seqno, 
                Tc.Sztlsch_Seqno, 
                Tc.Sztlsch_Acat_Name,
	        Tc.Sztlsch_Status, 
	        Tc.Sztlsch_Error,
	        to_char(TC.SZTLSCH_START_DATE,G$_DATE.GET_NLS_DATE_FORMAT),
	        to_char(TC.SZTLSCH_DUE_DATE,G$_DATE.GET_NLS_DATE_FORMAT),
	        TC.SZTLSCH_WEIGHT,
			tc.SZTLSCH_INCLUDE_IND,  /* 8.7.0 [UTM:002.1.5] */
			tc.SZTLSCH_DELIVER_IND,   /* 8.7.0 [UTM:002.1.5] */
			tc.SZTLSCH_TERM_CODE,     /* 8.7.0 [UTM:002.1.5] */
			tc.SZTLSCH_PTRM_CODE,      /* 8.7.0 [UTM:002.1.5] */
			tc.SZTLSCH_RESTRICTED_IND  /* 8.7.0 [UTM:002.1.6] */
	   From Sztlsch Tc
	  Where Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID')
	    and Tc.Sztlsch_Type = 'A'
         ORDER BY 1,2;

      POSTORA;
	  
      EXEC SQL
        OPEN Sztlsch_C;
      POSTORA;
	        	  
	  
      for( ; ; )
      {
         EXEC SQL
            FETCH Sztlsch_C
              INTO :lvScheme:vIndArr[0],
	               :lvSeqNo:vIndArr[1],
                   :lvAcat:vIndArr[2],
                   :lv_status:vIndArr[3],
                   :lvMsg:vIndArr[4],
                   :lvStart:vIndArr[5],
                   :lvDue:vIndArr[6],
                   :lvWeight:vIndArr[7],
				   :lvInclude:vIndArr[8],   /* 8.7.0 [UTM:002.1.5] */
                   :lvDeliver:vIndArr[9],   /* 8.7.0 [UTM:002.1.5] */
                   :lvTerm:vIndArr[10],		/* 8.7.0 [UTM:002.1.5] */
                   :lvPTerm:vIndArr[11],	/* 8.7.0 [UTM:002.1.5] */
				   :lvRestrict:vIndArr[12];	/* 8.7.0 [UTM:002.1.6] */
				   
         POSTORA;

         if (NO_ROWS_FOUND)
            break;
			
         add( vRowsRead, vRowsRead, _TMC("1") );
		 
         #ifdef SCT_DEBUG
        tmprintf(&tmBundle, TM_NLS_Get("x", "Variables for CURSOR Sztlsch_C.\n"));
		tmprintf(&tmBundle,  _TMC("  lvScheme       <{0}>\n") ,lvScheme);      
		tmprintf(&tmBundle,  _TMC("  lvSeqNo         <{0}>\n") ,lvSeqNo);      			
		tmprintf(&tmBundle,  _TMC("  lvAcat  <{0}>\n") ,lvAcat); 
		tmprintf(&tmBundle,  _TMC("  lv_status  <{0}>\n") ,lv_status);
		tmprintf(&tmBundle,  _TMC("  lvMsg      <{0}>\n") ,lvMsg);		
		tmprintf(&tmBundle,  _TMC("  lvWeight      <{0}>\n") ,lvWeight);     
		tmprintf(&tmBundle,  _TMC("  lvInclude      <{0}>\n") ,lvInclude); 
		tmprintf(&tmBundle,  _TMC("  lvDeliver      <{0}>\n") ,lvDeliver); 
		tmprintf(&tmBundle,  _TMC("  lvTerm      <{0}>\n") ,lvTerm); 
		tmprintf(&tmBundle,  _TMC("  lvPTerm      <{0}>\n") ,lvPTerm); 
		tmprintf(&tmBundle,  _TMC("  lvRestrict      <{0}>\n") ,lvRestrict); 
         #endif

		
         if ( *pReportMode == 'U' && *lv_status == 'S' ) 
	  {
	 	mc_InsertActivity();
                add( vRecInserted, vRecInserted, _TMC("1") );	
				
	  }
		 		 
        else
          {
            if(*lv_status == 'E' )
            {
            	mc_Line();
            	add( vRecIgnored, vRecIgnored, _TMC("1") );
            }
            else
              add( vRecInserted, vRecInserted, _TMC("1") );	
          }        

      }	
	   
      EXEC SQL
        CLOSE Sztlsch_C;
      POSTORA;	 

      if ( tmatoi( vRowsRead ) == 0 )
      {
        prtstr(_TMC("No records were found.\n"));
      }



}
/*  EA  MKU  Added    27/Apr/2016  */



/*  BA  MKU  Added    27/Apr/2016  */
static void mc_PostProcessCheck(void)
{

 #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","executing mc_PostProcessCheck\n") );
  #endif
  

  EXEC SQL
     EXECUTE
        DECLARE
            cursor get_new_schema is
               select distinct tc.SZTLSCH_SCHM_SEQNO, 
                      TC.SZTLSCH_TERM_CODE,
                      Tc.Sztlsch_Ptrm_Code
                 from SZTLSCH tc
                where Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');
                
            cursor check_szrschm_exist_c(c_schm_seqno    number,
                                         c_term_code     varchar2,
                                         c_ptrm_code     varchar2)  is
                select count(1) 
                  from SZRSCHM DS
                 where DS.SZRSCHM_SCHM_SEQNO = c_schm_seqno
                   and DS.SZRSCHM_TERM_CODE = c_term_code
                   and DS.SZRSCHM_PTRM_CODE = c_ptrm_code;
                   
            cursor check_schema_c(c_schm_seqno    number,
                                  c_term_code     varchar2,
                                  c_ptrm_code     varchar2) is
                select count(1)
                  from SZTLSCH tc
                 where TC.SZTLSCH_SCHM_SEQNO = c_schm_seqno
                   and TC.SZTLSCH_TERM_CODE = c_term_code
                   And Tc.Sztlsch_Ptrm_Code = C_Ptrm_Code
                   and TC.SZTLSCH_TYPE = 'H'
                   and TC.SZTLSCH_STATUS = 'S'
                   and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');

            cursor get_sum_schema_c(c_schm_seqno    number,
                                    c_term_code     varchar2,
                                    c_ptrm_code     varchar2) is
                SELECT sum(TC.SZTLSCH_WEIGHT) 
                  FROM SZTLSCH tc
                 where TC.SZTLSCH_SCHM_SEQNO = c_schm_seqno
                   and TC.SZTLSCH_TERM_CODE = c_term_code
                   And Tc.Sztlsch_Ptrm_Code = C_Ptrm_Code
                   and TC.SZTLSCH_TYPE = 'A'
                   and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');
         
            cursor check_double_seqno_c(c_schm_seqno    number,
                                        c_term_code     varchar2,
                                        c_ptrm_code     varchar2) is
                select TC.SZTLSCH_SEQNO,
                       count(1)
                  from SZTLSCH tc
                 where TC.SZTLSCH_SCHM_SEQNO = c_schm_seqno
                   and TC.SZTLSCH_TERM_CODE = c_term_code
                   And Tc.Sztlsch_Ptrm_Code = C_Ptrm_Code
                   and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID')
                   and TC.SZTLSCH_TYPE = 'A'
                having count(1) > 1   
                group by TC.SZTLSCH_SEQNO;

            cursor check_double_activity_c(c_schm_seqno    number,
                                           c_term_code     varchar2,
                                           c_ptrm_code     varchar2) is
                select TC.SZTLSCH_ACAT_NAME,
                   count(1)
                  from SZTLSCH tc
                 where TC.SZTLSCH_SCHM_SEQNO = c_schm_seqno
                   and TC.SZTLSCH_TERM_CODE = c_term_code
                   And Tc.Sztlsch_Ptrm_Code = C_Ptrm_Code
                   and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID')
                   and TC.SZTLSCH_TYPE = 'A'
                having count(1) > 1   
                group by TC.SZTLSCH_ACAT_NAME;
                       
	     cursor check_error_c(c_schm_seqno    number,
                              c_term_code     varchar2,
                              c_ptrm_code     varchar2) is 
                select count(1)
                  from SZTLSCH tc
                 where TC.SZTLSCH_SCHM_SEQNO = c_schm_seqno
                   and TC.SZTLSCH_TERM_CODE = c_term_code
                   And Tc.Sztlsch_Ptrm_Code = c_Ptrm_Code 
                   and TC.SZTLSCH_TYPE = 'A'
                   and TC.SZTLSCH_STATUS = 'E'
                   and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');

                       
           nSoma        number(9,2);
           nCount       number(9);
           lvMsg        varchar2(50);
           nDummy       number;
           Vdummy       Varchar2(10);

            
        begin
            for r in get_new_schema loop        
                /*   check total of weight */
                nSoma := 0;

                open get_sum_schema_c(r.SZTLSCH_SCHM_SEQNO, 
                                      r.SZTLSCH_TERM_CODE, 
                                      r.Sztlsch_Ptrm_Code);
                                      
                fetch get_sum_schema_c into nSoma;
                close get_sum_schema_c;

                if nvl(nSoma,0) <> 100 then
                    lvMsg := substr(G$_Nls.Get('X','SQL','Total of weight is not 100'),1,50)	;	

                    update SZTLSCH tc /*BIEN*/
                       set TC.SZTLSCH_STATUS = 'E',
                           TC.SZTLSCH_ERROR = lvMsg
                     where TC.SZTLSCH_SCHM_SEQNO = r.SZTLSCH_SCHM_SEQNO
                       and TC.SZTLSCH_TERM_CODE = r.SZTLSCH_TERM_CODE
                       and TC.SZTLSCH_PTRM_CODE = r.Sztlsch_Ptrm_Code
                       and TC.SZTLSCH_TYPE = 'A'
                       and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');
                end if; 

                nCount := 0;

                open check_double_seqno_c(r.SZTLSCH_SCHM_SEQNO, 
                                          r.SZTLSCH_TERM_CODE, 
                                          r.Sztlsch_Ptrm_Code);
                fetch check_double_seqno_c into nDummy, nCount;
                if check_double_seqno_c%found then
                    lvMsg := substr(G$_NLS.GET('X','SQL','Repeated sequence was found'),1,50);
                    
                    close check_double_seqno_c;	

                    update SZTLSCH tc /*BIEN*/
                       set TC.SZTLSCH_STATUS = 'E',
                           TC.SZTLSCH_ERROR = lvMsg
                     where TC.SZTLSCH_SCHM_SEQNO = r.SZTLSCH_SCHM_SEQNO
                       and TC.SZTLSCH_TERM_CODE = r.SZTLSCH_TERM_CODE
                       And Tc.Sztlsch_Ptrm_Code = r.Sztlsch_Ptrm_Code
                       and TC.SZTLSCH_TYPE = 'A'
                       and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID')
                       and TC.SZTLSCH_SEQNO = nDummy;
                else
                    close check_double_seqno_c;
                end if;

                open check_double_activity_c(r.SZTLSCH_SCHM_SEQNO, r.SZTLSCH_TERM_CODE, r.Sztlsch_Ptrm_Code);
                fetch check_double_activity_c into vDummy, nCount;
                if check_double_activity_c%found then
                    close check_double_activity_c;
                    
                    lvMsg := substr(G$_NLS.GET('X','SQL','Repeated activity was found'),1,50);
                    
                    update SZTLSCH tc /*BIEN*/
                       set TC.SZTLSCH_STATUS = 'E',
                           TC.SZTLSCH_ERROR = lvMsg
                     where TC.SZTLSCH_SCHM_SEQNO = r.SZTLSCH_SCHM_SEQNO
                       And Tc.Sztlsch_Term_Code = r.SZTLSCH_TERM_CODE
                       And Tc.Sztlsch_Ptrm_Code = r.Sztlsch_Ptrm_Code
                       and TC.SZTLSCH_TYPE = 'A'
                       and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID')
                       and TC.SZTLSCH_ACAT_NAME = vDummy;
                else
                    close check_double_activity_c;
                end if;
                
                
                nCount := 0;
                
                open check_schema_c(r.SZTLSCH_SCHM_SEQNO, r.SZTLSCH_TERM_CODE, r.Sztlsch_Ptrm_Code);
                fetch check_schema_c into nCount;
                close check_schema_c;
                
                if nCount = 0 then
                    lvMsg := substr(G$_NLS.GET('X','SQL','Schema %01% was not created',to_char(r.SZTLSCH_SCHM_SEQNO)),1,50);
                    update SZTLSCH tc /*BIEN*/
                       set TC.SZTLSCH_STATUS = 'E',
                           TC.SZTLSCH_ERROR = lvMsg
                     where TC.SZTLSCH_SCHM_SEQNO = r.SZTLSCH_SCHM_SEQNO
                       And Tc.Sztlsch_Term_Code = r.SZTLSCH_TERM_CODE
                       And Tc.Sztlsch_Ptrm_Code = r.Sztlsch_Ptrm_Code
                       and TC.SZTLSCH_TYPE = 'A'
                       and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');
                       
                end if;
                
                nCount := 0;
                      
                open check_szrschm_exist_c(r.SZTLSCH_SCHM_SEQNO, 
                                           r.SZTLSCH_TERM_CODE, 
                                           r.Sztlsch_Ptrm_Code);
                fetch check_szrschm_exist_c into nCount;
                close check_szrschm_exist_c;
                
                if nCount > 0 then
                    lvMsg := substr(G$_NLS.GET('X','SQL','Scheme detail %01% already exists',to_char(r.SZTLSCH_SCHM_SEQNO)),1,50);

                    update SZTLSCH tc /*BIEN*/
                       set TC.SZTLSCH_STATUS = 'E',
                           TC.SZTLSCH_ERROR = lvMsg
                     where TC.SZTLSCH_SCHM_SEQNO = r.SZTLSCH_SCHM_SEQNO
                       And Tc.Sztlsch_Term_Code = r.SZTLSCH_TERM_CODE
                       And Tc.Sztlsch_Ptrm_Code = r.Sztlsch_Ptrm_Code
                       and TC.SZTLSCH_TYPE = 'A'
                       and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');

                end if;
                
                nCount := 0;
                
                /*  check if this schema has any error */
                open check_error_c(r.SZTLSCH_SCHM_SEQNO, 
                                   r.SZTLSCH_TERM_CODE, 
                                   r.Sztlsch_Ptrm_Code);
                fetch check_error_c into nCount;
                close check_error_c;
                
                if nCount > 0 then
                    lvMsg := substr(G$_NLS.GET('X','SQL','At least one error was found.'),1,50);
                    
                    update SZTLSCH tc /*BIEN*/
                       set TC.SZTLSCH_STATUS = 'E',
                           TC.SZTLSCH_ERROR = NVL(TC.SZTLSCH_ERROR, lvMsg)
                     where TC.SZTLSCH_SCHM_SEQNO = r.SZTLSCH_SCHM_SEQNO
                       And Tc.Sztlsch_Term_Code = r.SZTLSCH_TERM_CODE
                       And Tc.Sztlsch_Ptrm_Code = r.Sztlsch_Ptrm_Code
                       and TC.SZTLSCH_TYPE = 'A'
                       and Tc.Sztlsch_Session = SYS_CONTEXT ('USERENV', 'SESSIONID');
                       
                    /*   delete previous inserted header    */
                    delete szbschm bm
                     where BM.SZBSCHM_SEQNO = r.SZTLSCH_SCHM_SEQNO
                       and BM.SZBSCHM_TERM_CODE = r.SZTLSCH_TERM_CODE
                       and BM.SZBSCHM_PTRM_CODE = r.Sztlsch_Ptrm_Code;   
                       
                end if;

            end loop;
    
        END;
  END-EXEC;
  POSTORA;     
}
/*  EA  MKU  Added    27/Apr/2016  */


/*****************************************************************************/
/*        Routine to process layout if the parameter was entered.            */
/*****************************************************************************/
static void mc_ProcessFile(TMCHAR *pFileName, TMCHAR *pType )
{
  EXEC SQL BEGIN DECLARE SECTION;
    static TMCHAR lv_msg[100]           = {0};
    static TMCHAR tRecordTypeValue[16]  = {0};
  EXEC SQL END DECLARE SECTION;

  #ifdef SCT_DEBUG
     tmprintf(&tmBundle,  TM_NLS_Get("x","Executing function mc_ProcessFile.\n") );
  #endif

  tmstrcpy(lv_msg, TM_NLS_Get("x","(Define in GTVSDAX form the value to the file path for FILE_DIR"));
  EXEC SQL
     EXECUTE
        DECLARE
           description   gtvsdax.gtvsdax_internal_code%TYPE;

           CURSOR get_gtvsdax_desc_c(l_internal_code VARCHAR2,
                                     l_group_code    VARCHAR2) IS
           SELECT gtvsdax_comments
             FROM gtvsdax
            WHERE gtvsdax_internal_code       = l_internal_code
              AND gtvsdax_internal_code_group = l_group_code;

           BEGIN
              OPEN get_gtvsdax_desc_c('FILE_DIR', 'UTM002');
              FETCH get_gtvsdax_desc_c INTO :pvFilePath;
              CLOSE get_gtvsdax_desc_c;
              IF (:pvFilePath IS NULL or :pvFilePath = 'UPDATEME') THEN
                  :pvFilePath := :lv_msg;
              END IF;
       END;
  END-EXEC;
  POSTORA;

 #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: UTM002: [{0}]\n"), pvFilePath );
  #endif

  if ( !tmstrcmp( pvFilePath, lv_msg ) )
  {
    tmprintf(&tmBundle, _TMC("{0}\n"),pvFilePath );
    prtstr( lv_msg );
  }
  else
  {
     #if OPSYS==OS_UNIX
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}/{1}"),
                 pvFilePath,  pFileName );
     #else
        tmsprintf(&tmBundle,  pvFileFullName, _TMC("{0}\\{1}"),
                 pvFilePath,  pFileName );
     #endif

    mc_OpenFile();
    mc_ReadFileLines(pType);
    mc_CloseFile();
  }
}

/* insert into temporary table */
/*  BA  MKU  Added    27/Apr/2016  */
static int mc_Insert_Temp(void)
{

  #ifdef SCT_DEBUG
    tmprintf( &tmBundle, TM_NLS_Get("X", "executing mc_Insert_Temp .\n"));
  #endif

  if ( mc_ValidScheme()   &&
       mc_ValidTerm()     &&
	   mc_ValidPTerm()    &&
	   mc_GetGrade()      &&
	   mc_ValidActivity() &&
	   mc_ValidIndicators() &&
	   mc_ValidDates())
  
    tmstrcpy( lv_status, _TMC("S"));
 
  else
 
    tmstrcpy(lv_status, _TMC("E") );

   

  #ifdef SCT_DEBUG
	tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvDue -> {0} \n"),lvDue);
	tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvStart -> {0} \n"),lvStart);
	tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lv_status -> {0} \n"),lv_status);
	tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvMsg -> {0} \n"),lvMsg);
  #endif


   EXEC SQL
          INSERT INTO SZTLSCH /*BIEN*/
                   (SZTLSCH_SCHM_SEQNO    , SZTLSCH_TERM_CODE     , SZTLSCH_PTRM_CODE     ,
                    SZTLSCH_SEQNO         , SZTLSCH_ACAT_NAME     , SZTLSCH_WEIGHT        ,
                    SZTLSCH_INCLUDE_IND   , SZTLSCH_DELIVER_IND   , SZTLSCH_START_DATE    ,
                    SZTLSCH_DUE_DATE      , SZTLSCH_RESTRICTED_IND, SZTLSCH_GSCH_NAME     ,
                    SZTLSCH_TYPE,
                    SZTLSCH_MIN_PASS_SCORE, SZTLSCH_USER_ID       , SZTLSCH_ACTIVITY_DATE,
                    SZTLSCH_STATUS, 	SZTLSCH_ERROR		, SZTLSCH_SESSION)
            VALUES (:lvScheme,             trim(:lvTerm),                 trim(:lvPTerm),             
                    :lvSeqNo,              trim(:lvAcat),                 :lvWeight,
                    trim(:lvInclude),      trim(:lvDeliver),              to_date(nvl(:lvStart,'01/01/2000'),'dd/mm/yyyy'),
                    to_date(nvl(:lvDue,'01/01/2000'),'DD/MM/YYYY'),                trim(:lvRestrict),             trim(:lvGrade),
                    'A',
                    trim(:lvScore),              USER,                    SYSDATE,
                    :lv_status,	       substr(:lvMsg,1,50),	SYS_CONTEXT ('USERENV', 'SESSIONID')
                    );
    POSTORA;

}
/*  EA  MKU  Added    27/Apr/2016  */


/*  BA  MKU  Added    27/Apr/2016  */
static int mc_InsertHeader_Temp(void)
{

  #ifdef SCT_DEBUG
    tmprintf( &tmBundle, TM_NLS_Get("X", "executing mc_InsertHeader_Temp .\n"));
  #endif

    
      EXEC SQL
          INSERT INTO SZTLSCH /*BIEN*/
                   (SZTLSCH_SCHM_SEQNO    , SZTLSCH_TERM_CODE     , SZTLSCH_PTRM_CODE     ,
                    SZTLSCH_TYPE,
                    SZTLSCH_MIN_PASS_SCORE, SZTLSCH_USER_ID       , SZTLSCH_ACTIVITY_DATE,
