/******************************************************************************/
/*                   Routine to open the file to process                      */
/******************************************************************************/

static int mc_OpenFile(void)
{
  #ifdef SCT_DEBUG
    tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: Full name of the file: [{0}]\n"), pvFileFullName );
  #endif

  if ( ( vFile = tmfopen(&tmBundle,  pvFileFullName, _TMC("r") ) ) == NULL )
  {
    tmprintf(&tmBundle,  TM_NLS_Get("x","{0} gender error Input/Output\n"), pvFileFullName );
    exit2os( EXIT_FAILURE );
  }
  return 0;
}

/*****************************************************************************/
/* Gets the value that corresponds to the field number specified by pos      */
/* parameter.                                                                */
/*****************************************************************************/
static TMCHAR *getField(int pos, TMCHAR* vFileLine)
{
   int start = 0;
   int end   = 0;
   int i;
   int fnum  = 0;

   for (i=0; i<tmstrlen(vFileLine); i++)
   {
      if (vFileLine[i] == vCharSeparator[0])
      {
         start = (end==0?end:end+1);
         end   = i;
         fnum++;

         if (fnum == pos)
         {
            substr( array, vFileLine, start, end-start);
            return array;
         }
      }
   }

   if (fnum+1 == pos)
   {
      start = (end==0?end:end+1);
      end   = tmstrlen(vFileLine);
	  if (vFileLine[end-1] == '\n' ) { /* Al final hay retorno de carro */
	    end -= 1;
	  }
	  if (vFileLine[end-1] == '\r' ) { /* Al final hay retorno de carro */
	    end -= 1;
	  }

      substr( array, vFileLine, start, end-start);
      return array;
   }

   tmstrcpy(array,_TMC(""));
   return array;
}

/******************************************************************************/
/*                   Routine to Read Lines of the File                        */
/******************************************************************************/

static int mc_ReadFileLines(TMCHAR *pFileType)
{
  EXEC SQL BEGIN DECLARE SECTION;
      static TMCHAR  vFileLine[410];
  EXEC SQL END DECLARE SECTION;

  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ReadFileLines.\n"));
  #endif

  /* Se procesa el File Header */
  if (compare(pFileType, _TMC("H"), EQS))
  {
     do {
        tmstrcpy(vFileLine,_TMC(""));
        tmfgets(vFileLine, 410, vFile);

        if ( tmstrcmp( vFileLine, _TMC("") ) )
        {
          add( vRecRead, vRecRead, _TMC("1") );

          tmstrcpy( lvScheme, _TMC("") );
          tmstrcpy( lvTerm,   _TMC("") );
          tmstrcpy( lvPTerm,  _TMC("") );
          tmstrcpy( lvGrade,  _TMC("") );
          tmstrcpy( lvNonD,   _TMC("") );
          tmstrcpy( lvSeqNo,  _TMC("") );
          tmstrcpy( lvAcat,   _TMC("") );
          tmstrcpy( lvMsg,    _TMC("") );

          #ifdef SCT_DEBUG
              tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: vFileLine [{0}] \n"), vFileLine);
          #endif

          tmstrcpy( lvScheme, getField(1, vFileLine) );
          tmstrcpy( lvTerm,   getField(2, vFileLine) );
          tmstrcpy( lvPTerm,  getField(3, vFileLine) );
          tmstrcpy( lvGrade,  getField(4, vFileLine) );
          tmstrcpy( lvNonD,   getField(5, vFileLine) );

	  #ifdef SCT_DEBUG
		  tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvScheme -> {0} \n"),lvScheme);
		  tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvTerm -> {0} \n"),lvTerm);
		  tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvPTerm -> {0} \n"),lvPTerm);
		  tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvGrade -> {0} \n"),lvGrade);
		  tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvNonD -> {0} \n"),lvNonD);
          #endif
          if ( mc_ValidScheme()  &&
		       mc_GetSchemeSeq() &&
		       mc_ValidTerm()    &&
			   mc_ValidPTerm()   &&
			   mc_ValidGrade()   &&
			   mc_ValidNonDeliver())
          {
            mc_InsertHeader();
            tmstrcpy( lv_status, _TMC("S"));
            mc_InsertHeader_Temp();
            add( vRecInserted, vRecInserted, _TMC("1") );
          }
          else
          {
            tmstrcpy( lv_status, _TMC("E"));
            mc_InsertHeader_Temp();
            mc_Line();
            add( vRecIgnored, vRecIgnored, _TMC("1") );
          }
        }

      } while ( tmstrcmp( vFileLine, _TMC("") ) );

  }
  /* Se procesa el File Activity */
  if (compare(pFileType, _TMC("A"), EQS))
  {
     do {
        tmstrcpy(vFileLine,_TMC(""));
        tmfgets(vFileLine, 410, vFile);

        if ( tmstrcmp( vFileLine, _TMC("") ) )
        {
          add( vRecRead, vRecRead, _TMC("1") );

          tmstrcpy( lvScheme,   _TMC("") );
          tmstrcpy( lvTerm,     _TMC("") );
          tmstrcpy( lvPTerm,    _TMC("") );
          tmstrcpy( lvSeqNo,    _TMC("") );
          tmstrcpy( lvAcat,     _TMC("") );
          tmstrcpy( lvWeight,   _TMC("") );
          tmstrcpy( lvInclude,  _TMC("") );
          tmstrcpy( lvDeliver,  _TMC("") );
          tmstrcpy( lvStart,    _TMC("") );
          tmstrcpy( lvDue,      _TMC("") );
          tmstrcpy( lvRestrict, _TMC("") );
          tmstrcpy( lvGrade,    _TMC("") );
          tmstrcpy( lvScore,    _TMC("") );
          tmstrcpy( lvMsg,      _TMC("") );

          #ifdef SCT_DEBUG
              tmprintf(&tmBundle,  TM_NLS_Get("x","DEBUG: vFileLine [{0}] \n"), vFileLine);
          #endif

          tmstrcpy( lvScheme,   getField(1, vFileLine) );
          tmstrcpy( lvTerm,     getField(2, vFileLine) );
          tmstrcpy( lvPTerm,    getField(3, vFileLine) );
          tmstrcpy( lvSeqNo,    getField(4, vFileLine) );
          tmstrcpy( lvAcat,     getField(5, vFileLine) );
          tmstrcpy( lvWeight,   getField(6, vFileLine) );
          tmstrcpy( lvInclude,  getField(7, vFileLine) );
          tmstrcpy( lvDeliver,  getField(8, vFileLine) );
          tmstrcpy( lvStart,    getField(9, vFileLine) );
          tmstrcpy( lvDue,      getField(10, vFileLine) );
          tmstrcpy( lvRestrict, getField(11, vFileLine) );

	  #ifdef SCT_DEBUG
        tmprintf(&tmBundle, TM_NLS_Get("x", "Variables for READ FILE.\n"));
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvScheme -> {0} \n"),lvScheme);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvTerm -> {0} \n"),lvTerm);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvPTerm -> {0} \n"),lvPTerm);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvSeqNo -> {0} \n"),lvSeqNo);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvAcat -> {0} \n"),lvAcat);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvDue -> {0} \n"),lvDue);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvWeight -> {0} \n"),lvWeight);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvInclude -> {0} \n"),lvInclude);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvDeliver -> {0} \n"),lvDeliver);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvStart -> {0} \n"),lvStart);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvDue -> {0} \n"),lvDue);
		tmprintf(&tmBundle,  TM_NLS_Get("x","    DEBUG: lvRestrict -> {0} \n"),lvRestrict);
          #endif
          
          mc_Insert_Temp();
          
          /*
          if ( mc_ValidScheme()   &&
		       mc_ValidTerm()     &&
			   mc_ValidPTerm()    &&
			   mc_GetGrade()      &&
			   mc_ValidActivity() &&
			   mc_ValidIndicators() &&
			   mc_ValidDates())
          {
            if ( compare( pReportMode, _TMC("U"), EQS) )
	          mc_InsertActivity();
              add( vRecInserted, vRecInserted, _TMC("1") );
          }
          else
          {
            mc_Line();
            add( vRecIgnored, vRecIgnored, _TMC("1") );
          }
          */
        }
        

      } while ( tmstrcmp( vFileLine, _TMC("") ) );

  }
  return 0;
}

/******************************************************************************/
/*                   Routines to validate data                                */
/******************************************************************************/
static int mc_ValidScheme(void)
{
  TMCHAR   vExist[10] = {0};
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidScheme.\n"));
  #endif

  EXEC SQL EXECUTE
    DECLARE
	  lv_seq INTEGER;
    BEGIN
      :vExist := 'Y';
      SELECT TO_NUMBER(:lvScheme)
	    INTO lv_seq
	   FROM DUAL;
	EXCEPTION
	  WHEN OTHERS THEN
	    :lvMsg := SQLERRM;
	    :vExist := 'N';
	    :lvScheme := 0;

	END;
  END-EXEC;
  POSTORA;
  
  if (compare(vExist, _TMC("N"), EQS))
    return FALSE;

  return TRUE;
}



static int mc_GetSchemeSeq(void)
{
  EXEC SQL BEGIN DECLARE SECTION;
      static BANNUMSTR(vSeq) = {0};
  EXEC SQL END DECLARE SECTION;
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_GetSchemeSeq.\n"));
  #endif

  EXEC SQL 
    DECLARE getSeq_c CURSOR FOR
	/* BA  8.7.0 [UTM:002.1.3] */
    SELECT MAX(SZBSCHM_SEQNO) 
      FROM SZBSCHM
      WHERE SZBSCHM_TERM_CODE = :lvTerm
      AND SZBSCHM_PTRM_CODE = :lvPTerm; 	
	/*
     SELECT SOBSEQN_MAXSEQNO
       FROM SOBSEQN
      WHERE SOBSEQN_FUNCTION = 'UTMSCHEME';
	  
	   EA 8.7.0 [UTM:002.1.3] */
  POSTORA;

  EXEC SQL
    OPEN getSeq_c;
  POSTORA;

  EXEC SQL 
    FETCH getSeq_c INTO :vSeq:vIndArr[0];
  POSTORA;

  if ( NO_ROWS_FOUND ) {
    tmstrcpy(vSeq,_TMC("0"));
    EXEC SQL
	  INSERT INTO SOBSEQN /*BIEN*/
	          (SOBSEQN_FUNCTION,      SOBSEQN_SEQNO_PREFIX, SOBSEQN_MAXSEQNO,
		   SOBSEQN_ACTIVITY_DATE, SOBSEQN_USER_ID)
       VALUES ('UTMSCHEME',           NULL,                 0,
	           SYSDATE,               USER);
  	POSTORA;
  }
  
  EXEC SQL
    CLOSE getSeq_c;
  POSTORA;
  /* 8.7.0 [UTM:002.1.4] */
  if (tmatoi(vSeq) >= tmatoi(lvScheme)) {      
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Scheme sequence invalid"));
    return FALSE;
  }
  return TRUE;
}

static int mc_ValidTerm(void)
{
  TMCHAR   vTerm[3] = {0};
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidTerm.\n"));
  #endif

  EXEC SQL
    SELECT GB_STVTERM.F_EXISTS(:lvTerm)
	  INTO :vTerm:vIndArr[0]
	  FROM DUAL;
  POSTORA;

  if (compare(vTerm, _TMC("N"), EQS)) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Term code invalid"));
    return FALSE;
  }
  return TRUE;
}

static int mc_ValidPTerm(void)
{
  TMCHAR   vExist[10] = {0};
  static TMCHAR lv_exists[2] = {0};
  
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidPTerm.\n"));
  #endif

  EXEC SQL 
    DECLARE exist_c CURSOR FOR
     SELECT Sobptrm_Start_Date, Sobptrm_End_Date
       FROM SOBPTRM
      WHERE SOBPTRM_TERM_CODE = :lvTerm
        AND SOBPTRM_PTRM_CODE = :lvPTerm;
  POSTORA;

  EXEC SQL
    OPEN exist_c;
  POSTORA;

  EXEC SQL 
    FETCH exist_c INTO :vExist:vIndArr[0];
  POSTORA;

  if ( NO_ROWS_FOUND ) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Part of Term invalid"));
    EXEC SQL
      CLOSE exist_c;
    POSTORA;

    return FALSE;
  }
  
  EXEC SQL
    CLOSE exist_c;
  POSTORA;

  
  
  return TRUE;
}

static int mc_ValidGrade(void)
{
  TMCHAR   vExist[10] = {0};
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidGrade.\n"));
  #endif

  EXEC SQL 
    DECLARE existGrade_c CURSOR FOR
     SELECT 'Y'
       FROM SHBGSCH
      WHERE SHBGSCH_NAME = :lvGrade;
  POSTORA;

  EXEC SQL
    OPEN existGrade_c;
  POSTORA;

  EXEC SQL 
    FETCH existGrade_c INTO :vExist:vIndArr[0];
  POSTORA;

  if ( NO_ROWS_FOUND ) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Grade Name invalid"));
    EXEC SQL
      CLOSE existGrade_c;
    POSTORA;

    return FALSE;
  }
  
  EXEC SQL
    CLOSE existGrade_c;
  POSTORA;

  return TRUE;
}

static int mc_ValidNonDeliver(void)
{
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidNonDeliver.\n"));
  #endif

  if ( !*lvNonD ) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Non Delivered invalid"));
    return FALSE;
  }
  
  return TRUE;
}


static int mc_GetGrade(void)
{
  TMCHAR   vExist[10] = {0};
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidGrade.\n"));
  #endif

  EXEC SQL 
    DECLARE getGrade_c CURSOR FOR
     SELECT SZBSCHM_GSCH_NAME, SHBGSCH_PASS_PERCENTAGE
       FROM SZBSCHM, SHBGSCH
      WHERE SZBSCHM_SEQNO = :lvScheme
        AND SZBSCHM_TERM_CODE = :lvTerm
        AND SZBSCHM_PTRM_CODE = :lvPTerm
        AND SHBGSCH_NAME = SZBSCHM_GSCH_NAME;
    POSTORA;

  EXEC SQL
    OPEN getGrade_c;
  POSTORA;

  EXEC SQL 
    FETCH getGrade_c INTO :lvGrade:vIndArr[0], :lvScore:vIndArr[1];
  POSTORA;

  if ( NO_ROWS_FOUND ) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Scheme is not defined"));
    EXEC SQL
      CLOSE getGrade_c;
    POSTORA;

    return FALSE;
  }
  
  EXEC SQL
    CLOSE getGrade_c;
  POSTORA;

  return TRUE;
}

static int mc_ValidActivity(void)
{
  TMCHAR   vExist[10] = {0};
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidActivity.\n"));
  #endif

  EXEC SQL 
    DECLARE existAct_c CURSOR FOR
     SELECT 'Y'
       FROM SZVACAT
      WHERE SZVACAT_NAME = :lvAcat;
  POSTORA;

  EXEC SQL
    OPEN existAct_c;
  POSTORA;

  EXEC SQL 
    FETCH existAct_c INTO :vExist:vIndArr[0];
  POSTORA;

  if ( NO_ROWS_FOUND ) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Activity Name is invalid"));
    EXEC SQL
      CLOSE existAct_c;
    POSTORA;

    return FALSE;
  }
  
  EXEC SQL
    CLOSE existAct_c;
  POSTORA;



  return TRUE;
}

static int mc_ValidIndicators(void)
{
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidIndicators.\n"));
  #endif

  if (!*lvInclude) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Include indicator is missing"));
    return FALSE;
  }
  if (!*lvDeliver) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Deliver indicator is missing"));
    return FALSE;
  }
  if (!*lvRestrict) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Restriction dates indicator is missing"));
    return FALSE;
  }
  if (compare(lvInclude, _TMC("M"), NES) && compare(lvInclude, _TMC("F"), NES)) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Include indicator invalid"));
    return FALSE;
  }
  if (compare(lvDeliver, _TMC("N"), NES) && compare(lvDeliver, _TMC("Y"), NES)) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Deliver indicator invalid"));
    return FALSE;
  }
  if (compare(lvRestrict, _TMC("N"), NES) && compare(lvRestrict, _TMC("Y"), NES)) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Restriction dates indicator invalid"));
    return FALSE;
  }
  return TRUE;
}

static int mc_ValidDates(void)
{
  TMCHAR   vExist[3] = {0};
  static TMCHAR lv_exists[2] = {0};
  
  #ifdef SCT_DEBUG
     tmprintf( &tmBundle, TM_NLS_Get("x", "Executing mc_ValidDates.\n"));
  #endif

  if (!*lvStart) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Start Date is missing"));
	return FALSE;
  }
  if (!*lvDue) {
    tmstrcpy(lvMsg, TM_NLS_Get("x", "Due Date is missing"));
	return FALSE;
  }
  

/*  BA  MKU  Added    27/Apr/2016  */
  EXEC SQL
    EXECUTE

	DECLARE
        cursor finalPE_c is
           SELECT (case when ZV.SZVACAT_FINAL_PROJ = 'Y' then 'Y'
                        when ZV.SZVACAT_FINAL_TEST = 'Y' then 'Y'
                   else
                    'N' end) qresult
            FROM SZVACAT zv
           WHERE SZVACAT_NAME = :lvAcat;


        CURSOR Get_Dates_c Is
            SELECT Sobptrm_Start_Date, Sobptrm_End_Date
              FROM Sobptrm
             WHERE To_Date(:lvStart,'dd/mm/yyyy') between Sobptrm_Start_Date and Sobptrm_End_Date
               AND To_Date(:lvDue,'dd/mm/yyyy') between Sobptrm_Start_Date and Sobptrm_End_Date
               AND Sobptrm_Ptrm_Code = :lvPTerm
               AND Sobptrm_Term_Code = :lvTerm;

	  dStart    Date;
	  dEnd      date;
	  vDummy    varchar2(1);
	BEGIN
	  Dstart := Null;
	  Dend := null;
	  vDummy := null;

	  open finalPE_c;
	  fetch finalPE_c into vDummy;
	  close finalPE_c;
	  
	  if vDummy = 'Y' then
	  
          	:lv_exists := 'Y';
 		
         else

		OPEN Get_Dates_C;
		FETCH Get_Dates_C INTO Dstart, Dend;
		IF Get_Dates_C%NOTFOUND Then
		    :lv_exists := 'N';
		ELSE
		    :lv_exists := 'Y';
		END IF;
		CLOSE Get_Dates_C;
	  end if;

	  IF To_Date(:lvStart,'dd/mm/yyyy') > To_Date(:lvDue,'dd/mm/yyyy') then
	  	:lv_exists := 'G';
	  end if;
	  
	EXCEPTION
 	  WHEN OTHERS THEN
 	    :lv_exists := 'I';
 	    :lvDue := null;
 	    :lvStart := null;
	END;
    END-EXEC;
    POSTORA;

    if (compare(lv_exists, _TMC("I"), EQS)) 
    {
        tmstrcpy(lvMsg, TM_NLS_Get("x", "Invalid date"));
        return FALSE;
    }
    /*  EA  MKU  Added    27/Apr/2016  */


    /*  BA  MKU  Added    27/Apr/2016    8.7.0 [UTM:002.1.2]  */
    if (compare(lv_exists, _TMC("G"), EQS)) 
      {
         tmstrcpy(lvMsg, TM_NLS_Get("x", "Start date is greater than due date"));
         return FALSE;
      }  
  
    if (compare(lv_exists, _TMC("A"), EQS)) 
      {
         tmstrcpy(lvMsg, TM_NLS_Get("x", "Final Exam/Project start or end before of the term dates"));
         return FALSE;
      }  
      

  /*  EA  MKU  Added    27/Apr/2016    8.7.0 [UTM:002.1.2]  */


    if (compare(lv_exists, _TMC("N"), EQS)) 
    {
      tmstrcpy(lvMsg, TM_NLS_Get("x", "Date out of range"));
      return FALSE;
    }

/*
  EXEC SQL EXECUTE
    BEGIN
      :vExist := 'Y';
      SELECT TO_DATE(:lvStart, :vDateFormat)
	    INTO :lvStart
        FROM DUAL;
    EXCEPTION
	   WHEN OTHERS THEN
	        :lvMsg := '(Start Date)' || SQLERRM;
	        :vExist := 'N';
	        :lvStart := null;
    END;
  END-EXEC;
  POSTORA;
  if (compare(vExist, _TMC("N"), EQS))
	return FALSE;

  EXEC SQL EXECUTE
    BEGIN
      :vExist := 'Y';
      SELECT TO_DATE(:lvDue, :vDateFormat)
	    INTO :lvDue
        FROM DUAL;
    EXCEPTION
	   WHEN OTHERS THEN
	        :lvMsg := '(Due Date)' || SQLERRM;
		:vExist := 'N';
		:lvDue := null;
    END;
  END-EXEC;
  POSTORA;
  if (compare(vExist, _TMC("N"), EQS))
	return FALSE;
*/

  return TRUE;
}

