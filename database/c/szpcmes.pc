  static TMCHAR  lv_status[2]	      = {0};	/*  MKU  Added    27/Apr/2016  */
  static TMCHAR  lvType[2]	      = {0};    /*  MKU  Added    27/Apr/2016  */
  
  static TMCHAR vErrorCode[100]    = {0};
  static TMCHAR vErrMsg[51]        = {0};

  /* Shared Indicator Array */
